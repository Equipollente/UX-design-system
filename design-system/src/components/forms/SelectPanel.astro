---
// SelectPanel — le composant complet : une boîte avec son libellé, et le panneau qui s'ouvre dessous
// pour choisir une valeur, ou plusieurs. C'est la page SelectPanel de Primer : le bouton, le panneau,
// sa recherche, son en-tête et son pied ne font qu'un.
//
// Ce n'est pas Select, qui est la liste native du navigateur : un seul choix, aucune recherche. Ici la
// liste est dessinée, parce que le menu du système est hors d'atteinte du CSS et ne sait ni chercher,
// ni épingler, ni créer une option. Ce n'est pas non plus quelques choix affichés d'emblée (c'est
// RadioGroup ou CheckboxGroup).
//
// La boîte est ce fichier ; la liste est la pièce interne `_SelectList`. Les réglages de la liste —
// type, en-tête, pied — passent par ici tels quels.
//
// Nœuds Figma : `FormGroup` 936:9502 (`type=select`) pour la pile, `Select` 954:6709 pour la boîte
// — `state` × `validation` × `size`. La liste est `_SelectList`, le dessin de Judith sur la page
// ↳ Select Panel. Libellé, aide et message sont les pièces de `_Field`.
//
// La boîte est un <button> qui ouvre la liste par `popovertarget` : l'ouverture, la fermeture à Échap
// et au clic à côté sont celles du navigateur, sans script. Les choix sont de vrais radios (un choix)
// ou de vraies cases (plusieurs), qui se soumettent avec le formulaire sous `name` : sans JavaScript,
// la liste s'ouvre et le choix part, mais la boîte ne montre pas ce qu'on vient de choisir. C'est le
// rôle de `<ds-select-panel>` : dire le choix dans la boîte, ouvrir et fermer au bon moment.
//
// `aria-invalid` n'est pas posé : un bouton ne le porte pas en ARIA. C'est le message, avec son
// icône, qui dit l'erreur en toutes lettres, et le trait rouge de la boîte n'en est que
// l'accompagnement (`data-validation`).
//
// La création n'enregistre rien : le champ annonce `select-create` (`detail.value`), et la page
// décide de la garder. `creatable` pose la recherche, où se tape le nom.
//
// Un `<ds-select-panel>` peut apparaître vingt fois dans une page, ou être cloné plus tard : l'élément
// ne cherche que dans ses enfants, et `connectedCallback` s'exécute à chaque instance.

import type { HTMLAttributes } from 'astro/types';
import Field from './_Field.astro';
import SelectList from './_SelectList.astro';
import Icon from '../Icon.astro';
import { resolveField } from '../../lib/field';
import { buildBlocks, chosenValues, type Option, type OptionGroup } from '../../lib/select';

/**
 * Le composant complet : une boîte, et le panneau qui s'ouvre dessous pour choisir une ou plusieurs valeurs.
 * @since 0.3.0
 */
interface Props
  extends Omit<HTMLAttributes<'button'>, 'type' | 'class' | 'disabled' | 'name' | 'value' | 'popovertarget'> {
  /**
   * `id` de la boîte que le libellé nomme, et préfixe des choix. Unique dans la page.
   * @example pays
   */
  id: string;
  /**
   * Le texte du libellé.
   * @example Pays
   * @group Libellé
   */
  label: string;
  /**
   * Retire le libellé de l'écran sans le retirer du document.
   * @group Libellé
   */
  hideLabel?: boolean;
  /**
   * Les choix. Une chaîne vaut pour sa propre valeur. Un groupe — `{ label, options }` — range ses
   * choix sous un nom, comme un <optgroup> : il ne s'imbrique pas.
   * @example [{"value":"france","label":"France"},{"value":"belgique","label":"Belgique"},{"value":"suisse","label":"Suisse"}]
   */
  options: (Option | OptionGroup)[];
  /**
   * Un seul choix, ou plusieurs.
   * @default single
   */
  type?: 'single' | 'multiple';
  /**
   * La taille : la hauteur de la boîte, et le rembourrage de chaque ligne de la liste.
   * @default medium
   */
  size?: 'small' | 'medium' | 'large';
  /**
   * La valeur choisie à l'ouverture, pour un seul choix.
   * @playground off
   */
  value?: string;
  /**
   * Les valeurs choisies à l'ouverture, pour plusieurs.
   * @playground off
   */
  values?: string[];
  /**
   * Ce que dit la boîte quand rien n'est choisi.
   * @default Choisir
   */
  placeholder?: string;
  /**
   * Le titre de l'en-tête de la liste. À défaut, le libellé du champ.
   * @group En-tête
   */
  heading?: string;
  /**
   * Une phrase sous le titre de la liste.
   * @group En-tête
   */
  description?: string;
  /**
   * Le nom lu du bouton qui ferme la liste.
   * @group En-tête
   * @default Fermer
   */
  closeLabel?: string;
  /**
   * Pose un champ de recherche dans l'en-tête de la liste, qui filtre les choix.
   * @group Recherche
   */
  searchable?: boolean;
  /**
   * Le nom lu du champ de recherche. Il n'est pas affiché.
   * @group Recherche
   * @default Filtrer les choix
   */
  searchLabel?: string;
  /**
   * L'invite du champ de recherche.
   * @group Recherche
   * @default Rechercher
   */
  searchPlaceholder?: string;
  /**
   * Ce que dit la liste quand aucun choix ne correspond.
   * @group Recherche
   * @default Aucun résultat
   */
  noResultsLabel?: string;
  /**
   * Le nombre de résultats, lu à voix haute. `{n}` vaut le nombre.
   * @group Recherche
   * @default {n} résultats
   */
  resultsLabel?: string;
  /**
   * Le nombre de résultats quand il n'y en a qu'un.
   * @group Recherche
   * @default {n} résultat
   */
  resultsOneLabel?: string;
  /**
   * Épingle en bas de la liste les choix faits, pour plusieurs choix.
   * @group Pied
   */
  showSelected?: boolean;
  /**
   * Le nombre de choix à ne pas dépasser, pour plusieurs.
   * @group Pied
   */
  max?: number;
  /**
   * Ce que dit la liste quand la limite est atteinte. `{n}` et `{max}` y sont remplacés.
   * @group Pied
   * @default Maximum atteint : {n} sur {max}
   */
  maxLabel?: string;
  /**
   * Pose en bas de la liste la ligne qui crée une option. Elle suppose la recherche.
   * @group Pied
   */
  creatable?: boolean;
  /**
   * La ligne de création au repos.
   * @group Pied
   * @default Créer une option
   */
  createLabel?: string;
  /**
   * La ligne de création quand un texte est tapé dans la recherche. `{q}` vaut ce texte.
   * @group Pied
   * @default Créer « {q} »
   */
  createQueryLabel?: string;
  /** Le nom envoyé par le formulaire. À défaut, l'`id`. */
  name?: string;
  /**
   * L'aide : ce que le champ attend, lue avant que personne ne se trompe.
   * @playground off
   * @group Aide
   */
  hint?: string;
  /**
   * Le message d'erreur. Passe la boîte au rouge.
   * @playground off
   * @group Message
   */
  error?: string;
  /**
   * Le message de succès. Cède à l'erreur.
   * @playground off
   * @group Message
   */
  success?: string;
  /**
   * Un choix est nécessaire. Pose l'astérisque.
   * @group Libellé
   */
  required?: boolean;
  disabled?: boolean;
  class?: string;
}

const {
  id,
  label,
  hideLabel = false,
  options,
  type = 'single',
  size = 'medium',
  value,
  values,
  placeholder = 'Choisir',
  heading,
  description,
  closeLabel = 'Fermer',
  searchable = false,
  searchLabel = 'Filtrer les choix',
  searchPlaceholder = 'Rechercher',
  noResultsLabel = 'Aucun résultat',
  resultsLabel = '{n} résultats',
  resultsOneLabel = '{n} résultat',
  showSelected = false,
  max,
  maxLabel = 'Maximum atteint : {n} sur {max}',
  creatable = false,
  createLabel = 'Créer une option',
  createQueryLabel = 'Créer « {q} »',
  name,
  hint,
  error,
  success,
  required = false,
  disabled = false,
  class: className,
  ...rest
} = Astro.props;

const multiple = type === 'multiple';
const listId = `${id}-list`;
// La boîte dit les libellés des choix faits, séparés par une virgule ; l'invite quand il n'y en a pas.
const { items } = buildBlocks(listId, options);
const chosen = chosenValues(multiple, value, values);
const labels = items.filter((o) => chosen.includes(o.value)).map((o) => o.label);
const summary = labels.length ? labels.join(', ') : placeholder;

const field = resolveField(id, { hint, error, success });
const describedby = [field.describedby, rest['aria-describedby']].filter(Boolean).join(' ') || undefined;

// Le nom d'ancre lie la liste à sa boîte. Il est unique comme l'`id` dont il dérive.
const anchor = `--select-${id}`;
---

<ds-select-panel data-placeholder={placeholder}>
  <Field id={id} label={label} hideLabel={hideLabel} required={required} disabled={disabled} field={field} class={className}>
    <div class="select-control" style={`--select-anchor: ${anchor}`}>
      <button
        {...rest}
        type="button"
        id={id}
        class="ds-field-control trigger"
        data-size={size}
        data-trigger
        data-validation={field.validation === 'none' ? undefined : field.validation}
        aria-describedby={describedby}
        popovertarget={listId}
        disabled={disabled}
      >
        <span class="value" data-value data-empty={labels.length === 0 ? '' : undefined}>
          {summary}
        </span>
        <span class="chevron"><Icon name="chevron-down" /></span>
      </button>
      <SelectList
        id={listId}
        name={name ?? id}
        popover
        options={options}
        type={type}
        size={size}
        value={value}
        values={values}
        heading={heading ?? label}
        description={description}
        closeLabel={closeLabel}
        searchable={searchable}
        searchLabel={searchLabel}
        searchPlaceholder={searchPlaceholder}
        noResultsLabel={noResultsLabel}
        resultsLabel={resultsLabel}
        resultsOneLabel={resultsOneLabel}
        showSelected={showSelected}
        max={max}
        maxLabel={maxLabel}
        creatable={creatable}
        createLabel={createLabel}
        createQueryLabel={createQueryLabel}
        required={required}
        disabled={disabled}
      />
    </div>
  </Field>
</ds-select-panel>

<style>
  /* L'élément personnalisé n'est qu'un point d'accroche pour le script : il ne dessine rien. */
  ds-select-panel {
    display: contents;
  }

  .select-control {
    position: relative;
    anchor-name: var(--select-anchor);
    inline-size: 100%;
  }

  /* La boîte se dessine comme un champ — la classe partagée — mais c'est un bouton : elle range la
     valeur à gauche et le chevron à droite, et le texte ne se centre pas. */
  .trigger {
    --icon-size: var(--icon-small);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--stack-control-small-gap);
    appearance: none;
    text-align: start;
    cursor: pointer;
  }

  .value {
    min-inline-size: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .value[data-empty] {
    color: var(--color-text-base-muted);
  }

  .chevron {
    display: grid;
    flex: none;
    color: var(--color-icon-base-default);
  }

  .trigger:disabled .chevron {
    color: var(--color-icon-base-disabled);
  }
</style>

<script>
  let anchorCount = 0;

  // Un élément par champ : `connectedCallback` s'exécute à chaque instance, que la page en porte
  // une ou vingt, ou qu'une soit clonée plus tard. L'élément ne cherche que dans ses enfants. La liste
  // est un <ds-select-list> qui filtre, épingle et limite ; le SelectPanel ouvre, ferme et dit le choix.
  class DsSelectPanel extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready) return;
      const list = this.querySelector<HTMLElement>('[data-panel]');
      const panel = this.querySelector<HTMLElement & { reset(): void; focusFirst(): void }>('ds-select-list');
      const trigger = this.querySelector<HTMLButtonElement>('[data-trigger]');
      const valueEl = this.querySelector<HTMLElement>('[data-value]');
      if (!list || !panel || !trigger || !valueEl) return;
      this.dataset.ready = '';

      // Une copie du champ — une ligne clonée depuis un <template>, par exemple — porte les mêmes
      // `id` que son modèle. La boîte et sa liste ne se retrouvent donc plus par `popovertarget` ni
      // par le nom d'ancre écrits côté serveur : l'élément les relie par référence, et donne à sa
      // liste une ancre qui n'appartient qu'à lui.
      trigger.popoverTargetElement = list;
      const closeButton = list.querySelector<HTMLButtonElement>('[popovertargetaction="hide"]');
      if (closeButton) closeButton.popoverTargetElement = list;
      this.querySelector<HTMLElement>('.select-control')?.style.setProperty('--select-anchor', `--ds-select-panel-${++anchorCount}`);

      const inputs = [...list.querySelectorAll<HTMLInputElement>('[data-option] input')];
      const close = () => {
        if (list.matches(':popover-open')) list.hidePopover();
        trigger.focus();
      };

      // La boîte dit les choix : les libellés des lignes cochées, ou l'invite.
      const sync = () => {
        const labels = inputs.filter((i) => i.checked).map((i) => i.dataset.label ?? '');
        valueEl.textContent = labels.length ? labels.join(', ') : (this.dataset.placeholder ?? '');
        valueEl.toggleAttribute('data-empty', labels.length === 0);
      };

      // Un formulaire réinitialisé, ou un retour en arrière qui rend les choix, ne disent pas `change` :
      // la boîte relit les lignes une fois que le navigateur a fini.
      this.closest('form')?.addEventListener('reset', () => setTimeout(sync));
      window.addEventListener('pageshow', (event) => {
        if (event.persisted) sync();
      });

      this.addEventListener('select-change', (event) => {
        sync();
        // À un choix, un clic ou Espace choisit et ferme ; les flèches parcourent sans fermer. À
        // plusieurs, la liste reste ouverte : on coche, on décoche, puis on ferme.
        const { pointer } = (event as CustomEvent<{ pointer: boolean }>).detail;
        if (panel.dataset.type !== 'multiple' && pointer) close();
      });

      // Un champ obligatoire sans choix : le navigateur ne peut pas focaliser une case dans une liste
      // fermée. On ouvre la liste à la place, qui est l'endroit où il faut répondre.
      this.addEventListener('select-invalid', (event) => {
        event.preventDefault();
        if (!list.matches(':popover-open')) list.showPopover();
      });

      this.addEventListener('select-create', () => close());

      trigger.addEventListener('keydown', (event) => {
        if ((event.key === 'ArrowDown' || event.key === 'ArrowUp') && !list.matches(':popover-open')) {
          event.preventDefault();
          list.showPopover();
        }
      });

      list.addEventListener('toggle', (event) => {
        if ((event as Event & { newState: string }).newState === 'open') panel.focusFirst();
        else panel.reset();
      });
    }
  }

  if (!customElements.get('ds-select-panel')) customElements.define('ds-select-panel', DsSelectPanel);
</script>
