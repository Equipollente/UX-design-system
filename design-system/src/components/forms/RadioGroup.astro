---
// RadioGroup — une question et ses réponses : un seul choix peut être retenu.
//
// Ce n'est pas un groupe de cases (c'est CheckboxGroup), ni une liste longue (c'est Select).
//
// Nœud Figma : `_RadioGroup.items` 875:53524 — `orientation` et un emplacement pour les radios.
//
// Le groupe prend des **données**, pas des enfants : `options`. Deux radios ne s'excluent que s'ils
// partagent le même `name`, et un composant Astro ne peut pas écrire d'attribut sur ce qu'on glisse
// dans son emplacement : c'est le groupe qui pose le même `name` sur tous. Le `Slot` de Figma reste
// un dessin ; le code en fait une liste (décision du 07/11).
//
// Il se nomme par la <legend> de son <fieldset>. Le clavier est celui du navigateur : Tab entre
// dans le groupe une seule fois, les flèches le parcourent. `required` pose l'attribut sur chaque
// radio — c'est ce que le navigateur attend d'un groupe — et l'astérisque sur la légende.

import FieldGroup from './_FieldGroup.astro';
import { resolveField } from '../../lib/field';
import Radio from './Radio.astro';

interface Option {
  value: string;
  label: string;
  /** L'aide de ce choix, sous son libellé. */
  hint?: string;
  disabled?: boolean;
}

/**
 * Une question et ses réponses : un seul choix peut être retenu.
 * @since 0.3.0
 */
interface Props {
  /**
   * Préfixe des `id` des radios : `${id}-${rang}`. Unique dans la page.
   * @example format
   */
  id: string;
  /**
   * La question posée au groupe.
   * @example Format
   */
  legend: string;
  /** Retire la légende de l'écran sans la retirer du document. */
  hideLegend?: boolean;
  /** Le `name` partagé par tous les radios. À défaut, l'`id`. */
  name?: string;
  /**
   * Les choix.
   * @example [{"value":"a4","label":"A4"},{"value":"a3","label":"A3","hint":"Pour les grandes œuvres"},{"value":"a2","label":"A2","disabled":true}]
   */
  options: Option[];
  /**
   * La valeur choisie à l'ouverture. Une seule.
   * @playground off
   */
  value?: string;
  orientation?: 'vertical' | 'horizontal';
  /**
   * L'aide du groupe : ce qu'il attend, lue avant que personne ne se trompe.
   * @playground off
   */
  hint?: string;
  /**
   * Le message d'erreur du groupe, avec son icône. Il l'emporte sur le succès.
   * @playground off
   */
  error?: string;
  /**
   * Le message de succès du groupe. Cède à l'erreur.
   * @playground off
   */
  success?: string;
  required?: boolean;
  /** Éteint tous les radios. */
  disabled?: boolean;
  class?: string;
}

const {
  id,
  legend,
  hideLegend = false,
  name,
  options,
  value,
  orientation = 'vertical',
  hint,
  error,
  success,
  required = false,
  disabled = false,
  class: className,
  ...rest
} = Astro.props;

const field = resolveField(id, { hint, error, success });
---

<FieldGroup
  legend={legend}
  hideLegend={hideLegend}
  required={required}
  disabled={disabled}
  field={field}
  orientation={orientation}
  class={className}
  {...rest}
>
  {
  options.map((option, index) => (
    <Radio
      id={`${id}-${index}`}
      label={option.label}
      name={name ?? id}
      value={option.value}
      checked={option.value === value}
      hint={option.hint}
      required={required}
      disabled={disabled || option.disabled}
    />
  ))
  }
</FieldGroup>
