---
// Select — une liste déroulante simple : on choisit une valeur parmi des options connues d'avance.
//
// C'est le <select> natif, comme chez Primer : un seul choix, aucune recherche, aucune création, et
// la liste qui s'ouvre est celle du système — clavier, lecteurs d'écran, mobile, tout vient du
// navigateur. Pour un choix avec recherche, plusieurs valeurs, un en-tête ou un pied, c'est
// SelectPanel. Pour quatre choix ou moins, RadioGroup.
//
// Nœuds Figma : `FormGroup` 936:9502 (`type=select`) pour la pile, `Select` 954:6709 pour la boîte
// — `state` × `validation` × `size`. Libellé, aide et message sont les pièces de `_Field`.
//
// Le <select> est natif. Les props prolongent le HTML : tout attribut d'un <select> (name, form,
// autocomplete…) est accepté et posé sur la balise. `class` va sur le conteneur.
//
// La boîte se dessine comme un champ (`styles/field-control.css`), sans l'apparence du système :
// le chevron est une icône posée par-dessus, qui ne reçoit pas le clic. Les états ne sont pas des
// props : `:hover`, `:focus-visible` et `:disabled` sont ceux du navigateur ; seul `disabled` se
// donne. L'erreur pose `aria-invalid`, le succès `data-validation="success"`.
//
// L'invite est une première option vide : éteinte quand le champ est obligatoire, elle ne peut plus
// être rechoisie une fois un choix fait.

import type { HTMLAttributes } from 'astro/types';
import Field from './_Field.astro';
import Icon from '../Icon.astro';
import { resolveField } from '../../lib/field';
import { buildBlocks, chosenValues, type Option, type OptionGroup } from '../../lib/select';

/**
 * Une liste déroulante simple : on choisit une valeur parmi des options connues d'avance.
 * @since 0.3.0
 */
interface Props extends Omit<HTMLAttributes<'select'>, 'size' | 'class' | 'required' | 'disabled' | 'value'> {
  /**
   * Lie le libellé au champ, et sert de `name` si aucun n'est donné.
   * @example pays
   */
  id: string;
  /**
   * Le texte du libellé.
   * @example Pays
   */
  label: string;
  /** Retire le libellé de l'écran sans le retirer du document : le champ garde son nom. */
  hideLabel?: boolean;
  /**
   * Les choix. Une chaîne vaut pour sa propre valeur. Un groupe — `{ label, options }` — range ses
   * choix sous un nom, comme un <optgroup> : il ne s'imbrique pas.
   * @example [{"value":"france","label":"France"},{"value":"belgique","label":"Belgique"},{"value":"suisse","label":"Suisse"}]
   */
  options: (Option | OptionGroup)[];
  /**
   * La valeur choisie à l'ouverture.
   * @playground off
   */
  value?: string;
  /**
   * Ce que dit la boîte quand rien n'est choisi.
   * @default Choisir
   */
  placeholder?: string;
  /**
   * La hauteur de la boîte : le rembourrage vertical.
   * @default medium
   */
  size?: 'small' | 'medium' | 'large';
  /**
   * L'aide : ce que le champ attend, lue avant que personne ne se trompe.
   * @playground off
   */
  hint?: string;
  /**
   * Le message d'erreur. Pose `aria-invalid` et passe la boîte au rouge.
   * @playground off
   */
  error?: string;
  /**
   * Le message de succès. Cède à l'erreur.
   * @playground off
   */
  success?: string;
  required?: boolean;
  disabled?: boolean;
  class?: string;
}

const {
  id,
  label,
  hideLabel = false,
  options,
  value,
  placeholder = 'Choisir',
  size = 'medium',
  hint,
  error,
  success,
  name,
  required = false,
  disabled = false,
  class: className,
  ...rest
} = Astro.props;

const { blocks } = buildBlocks(id, options);
const chosen = chosenValues(false, value, undefined)[0];

const field = resolveField(id, { hint, error, success });
const describedby = [field.describedby, rest['aria-describedby']].filter(Boolean).join(' ') || undefined;
---

<Field id={id} label={label} hideLabel={hideLabel} required={required} disabled={disabled} field={field} class={className}>
  <div class="control">
    <select
      {...rest}
      id={id}
      name={name ?? id}
      required={required}
      disabled={disabled}
      class="ds-field-control"
      data-size={size}
      data-validation={field.validation === 'success' ? 'success' : undefined}
      data-empty={chosen === undefined ? '' : undefined}
      aria-invalid={field.invalid ? 'true' : undefined}
      aria-describedby={describedby}
    >
      <option value="" disabled={required} selected={chosen === undefined} hidden={required}>{placeholder}</option>
      {
        blocks.map((block) =>
          block.label ? (
            <optgroup label={block.label} disabled={block.items.every((i) => i.locked)}>
              {block.items.map((i) => (
                <option value={i.value} selected={i.value === chosen} disabled={i.locked}>{i.label}</option>
              ))}
            </optgroup>
          ) : (
            block.items.map((i) => (
              <option value={i.value} selected={i.value === chosen} disabled={i.locked}>{i.label}</option>
            ))
          ),
        )
      }
    </select>
    <span class="chevron"><Icon name="chevron-down" /></span>
  </div>
</Field>

<style>
  .control {
    position: relative;
    inline-size: 100%;
  }

  /* Le système dessine sa propre flèche : on la retire, et la place du chevron est réservée par le
     rembourrage de la fin. */
  select {
    appearance: none;
    cursor: pointer;
    padding-inline-end: calc(
      var(--stack-control-small-padding-inline-normal) + var(--icon-small) + var(--stack-control-small-gap)
    );
  }

  /* Rien de choisi : la boîte montre l'invite en couleur d'invite, les options gardent la leur. */
  select[data-empty]:invalid,
  select[data-empty]:not(:disabled) {
    color: var(--color-text-base-muted);
  }

  select[data-empty] option {
    color: var(--color-text-base-default);
  }

  .chevron {
    --icon-size: var(--icon-small);
    position: absolute;
    inset-block: 0;
    inset-inline-end: var(--stack-control-small-padding-inline-normal);
    display: grid;
    place-items: center;
    pointer-events: none;
    color: var(--color-icon-base-default);
  }

  .control:has(select:disabled) .chevron {
    color: var(--color-icon-base-disabled);
  }
</style>

<script>
  // Une fois un choix fait, la boîte reprend la couleur d'une valeur. Sans ce script, elle garde
  // celle de l'invite jusqu'au rechargement : le choix reste juste, seule la couleur est en retard.
  document.addEventListener('change', (event) => {
    const select = event.target;
    if (select instanceof HTMLSelectElement && select.classList.contains('ds-field-control')) {
      select.toggleAttribute('data-empty', select.value === '');
    }
  });
</script>
