---
// _SelectPanel — la liste qui s'ouvre sous un Select, et rien d'autre : un titre et sa
// fermeture, la recherche, les choix (un radio par ligne, rangés ou non en groupes), et le pied
// qui crée une option. Pièce interne : on ne la pose pas seule, elle n'a pas de boîte à laquelle
// s'accrocher.
//
// Ce n'est pas un menu : une liste qui s'ouvre sous un champ porte un choix qui se soumet avec le
// formulaire, pas une commande. Ses lignes sont donc de vrais radios, et le clavier — Tab, les
// flèches, Espace, Échap — est celui du navigateur. Le rôle n'est pas le motif `combobox`, qui
// demanderait de réécrire ce clavier (décision du 07/11).
//
// Dessin de Judith, page ↳ Select Panel — `_SelectPanel/Base` 955:17742 (`variant=popover`) pour le
// cadre, `Header` 955:17593 pour le titre et la fermeture, `ActionList.Item/SingleSelect` 955:32289
// pour une ligne, `ActionList.GroupHeading` 957:8982 pour un nom de groupe, `Footer` 955:17640 pour
// le pied, `Message` et `Content` pour les états vide et d'erreur. Ce qui n'est pas repris :
// `ActionList.Item/ActionButton` et `Divider` — aucune vue n'en a besoin — et la variante
// `modal`, « not implemented » dans le dessin.
//
// Le cadre est un `popover` natif : le navigateur le pose dans sa couche réservée, il se ferme
// seul à Échap et au clic à côté. Il s'accroche à la boîte par l'ancrage CSS (`anchor()`,
// `anchor-size()`), en prend la largeur, et passe au-dessus quand la place manque en bas. La
// recherche, l'annonce du nombre de résultats et la création sont le script de `<ds-select>`,
// dans Select.astro : ici, que du balisage et du style.
//
// Une ligne choisie montre une coche devant son libellé ; les autres n'ont rien — comme dans le
// dessin. Le survol teinte le fond, le focus dessine l'anneau de 2 px.
//
// Mesures : rembourrage d'une ligne `stack/control/xsmall/paddingBlock` et `paddingInline/normal`,
// rayon `border/radius/small`, écart `base/8`, cadre à `base/12` de rayon. La ligne mesure donc
// l'interligne du texte et deux fois 6, soit les 37 du dessin.

import Icon from '../Icon.astro';

interface Item {
  value: string;
  label: string;
  inputId: string;
  locked: boolean;
}

interface Block {
  label: string | undefined;
  items: Item[];
}

interface Props {
  /** L'id de la liste : c'est ce que la boîte désigne par `popovertarget`. */
  listId: string;
  /** Le titre du cadre. */
  title: string;
  closeLabel: string;
  blocks: Block[];
  /** La valeur choisie à l'ouverture. */
  chosen: string | undefined;
  /** Le `name` envoyé par le formulaire. */
  fieldName: string;
  required: boolean;
  disabled: boolean;
  searchable: boolean;
  searchLabel: string;
  searchPlaceholder: string;
  noResultsLabel: string;
  creatable: boolean;
  createLabel: string;
}

const {
  listId,
  title,
  closeLabel,
  blocks,
  chosen,
  fieldName,
  required,
  disabled,
  searchable,
  searchLabel,
  searchPlaceholder,
  noResultsLabel,
  creatable,
  createLabel,
} = Astro.props;

const titleId = `${listId}-title`;
---

<div class="panel" id={listId} popover data-list aria-labelledby={titleId}>
  <header class="header">
    <span class="title" id={titleId}>{title}</span>
    <button type="button" class="close" popovertarget={listId} popovertargetaction="hide" aria-label={closeLabel}>
      <Icon name="close" />
    </button>
  </header>

  {
    searchable && (
      <div class="search">
        <input
          type="search"
          class="ds-field-control"
          data-size="small"
          data-search
          autocomplete="off"
          aria-label={searchLabel}
          placeholder={searchPlaceholder}
        />
      </div>
    )
  }

  <!-- Le nombre de résultats : lu à voix haute, jamais affiché. -->
  <p class="status" role="status" data-status></p>

  <fieldset class="options" data-options>
    <legend class="legend">{title}</legend>
    {
      blocks.map((block) =>
        block.label ? (
          <fieldset class="group" data-group>
            <legend class="group-label">{block.label}</legend>
            {block.items.map((item) => (
              <label class="option" data-option data-text={item.label.toLowerCase()}>
                <input
                  type="radio"
                  name={fieldName}
                  id={item.inputId}
                  value={item.value}
                  data-label={item.label}
                  checked={chosen === item.value}
                  required={required}
                  disabled={disabled || item.locked}
                />
                <span class="check"><Icon name="check" /></span>
                <span class="label">{item.label}</span>
              </label>
            ))}
          </fieldset>
        ) : (
          block.items.map((item) => (
            <label class="option" data-option data-text={item.label.toLowerCase()}>
              <input
                type="radio"
                name={fieldName}
                id={item.inputId}
                value={item.value}
                data-label={item.label}
                checked={chosen === item.value}
                required={required}
                disabled={disabled || item.locked}
              />
              <span class="check"><Icon name="check" /></span>
              <span class="label">{item.label}</span>
            </label>
          ))
        ),
      )
    }
    <p class="empty" data-empty hidden>{noResultsLabel}</p>
  </fieldset>

  {
    creatable && (
      <div class="footer">
        <button type="button" class="create" data-create data-label-rest={createLabel} disabled>
          <span class="label" data-create-label>{createLabel}</span>
          <Icon name="plus" />
        </button>
      </div>
    )
  }
</div>

<style>
  /* La liste flottante. Le navigateur la pose dans sa couche réservée ; il ne reste qu'à
     l'accrocher : sous la boîte, à l'écart de 8, de la largeur de la boîte, et au-dessus quand
     la place manque en bas. Les marges et l'encart que le navigateur donne à un popover — centré
     au milieu de l'écran — s'effacent. */
  .panel {
    --select-row: calc(
      var(--text-body-medium-size) * var(--text-body-medium-line-height) + 2 * var(--stack-control-xsmall-padding-block)
    );
    position-anchor: var(--select-anchor);
    inset: auto;
    top: anchor(bottom);
    left: anchor(left);
    width: anchor-size(width);
    margin: var(--base-8) 0 0;
    position-try-fallbacks: flip-block;
    padding: 0;
    overflow: hidden;
    background: var(--color-background-base-default);
    color: var(--color-text-base-default);
    border: var(--border-width-default) solid var(--color-border-base-strong);
    border-radius: var(--base-12);
    box-shadow: var(--shadow-md);
  }

  /* `display` seulement ouverte : posé sans condition, il l'emporterait sur le `display: none`
     que le navigateur donne à un popover fermé. */
  .panel:popover-open {
    display: flex;
    flex-direction: column;
  }

  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--base-8);
    padding: var(--stack-padding-condensed);
    padding-inline-start: calc(var(--stack-padding-condensed) + var(--stack-padding-condensed));
    border-block-end: var(--border-width-default) solid var(--color-border-base-strong);
  }

  .title {
    font-family: var(--font-stack-body);
    font-size: var(--text-body-small-size);
    font-weight: var(--base-text-weight-semibold);
    line-height: var(--text-body-small-line-height);
  }

  .close {
    --icon-size: var(--icon-small);
    display: grid;
    place-items: center;
    padding: 0;
    color: var(--color-icon-base-default);
    background: none;
    border: 0;
    border-radius: var(--border-radius-small);
    cursor: pointer;
  }

  .close:focus-visible {
    outline: var(--border-width-focus) solid var(--color-border-base-focus);
    outline-offset: 0;
  }

  .search {
    padding: var(--stack-padding-condensed);
  }

  /* Le masquage visuel : une technique, pas une mesure de design. */
  .status,
  .legend {
    position: absolute;
    overflow: hidden;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .options,
  .group {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    border: 0;
    min-inline-size: 0;
  }

  /* Sept lignes, puis la liste défile : ce n'est pas le cadre qui défile, ce sont ses choix, et la
     recherche comme le pied restent à leur place. */
  .options {
    max-block-size: calc(7 * var(--select-row) + 2 * var(--stack-padding-condensed));
    overflow-y: auto;
    padding: var(--stack-padding-condensed);
  }

  .group-label {
    padding: var(--stack-control-small-padding-block) var(--stack-control-xsmall-padding-inline-normal);
    color: var(--color-text-base-muted);
    font-family: var(--font-stack-body);
    font-size: var(--text-caption-size);
    font-weight: var(--base-text-weight-semibold);
    line-height: var(--text-caption-line-height);
    letter-spacing: var(--base-text-letter-spacing-wide);
    text-transform: uppercase;
  }

  .option {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--base-8);
    padding: var(--stack-control-xsmall-padding-block) var(--stack-control-xsmall-padding-inline-normal);
    border-radius: var(--border-radius-small);
    font-family: var(--font-stack-body);
    font-size: var(--text-body-medium-size);
    font-weight: var(--text-body-medium-weight);
    line-height: var(--text-body-medium-line-height);
    cursor: pointer;
  }

  .option[hidden],
  .group[hidden],
  .empty[hidden] {
    display: none;
  }

  /* Le radio reste dans le document, focalisable et lu, mais ne se dessine pas : c'est la ligne
     entière qui le montre. */
  .option input {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    margin: 0;
    opacity: 0;
  }

  .check {
    --icon-size: var(--icon-small);
    display: none;
    flex: none;
    color: var(--color-icon-base-default);
  }

  .option:has(input:checked) .check {
    display: grid;
  }

  .option:hover {
    background: var(--color-background-base-input-hover);
  }

  .option:has(input:focus-visible) {
    outline: var(--border-width-focus) solid var(--color-border-base-focus);
    outline-offset: calc(var(--border-width-focus) * -1);
  }

  .option:has(input:disabled) {
    color: var(--color-text-base-disabled);
    cursor: not-allowed;
  }

  .option:has(input:disabled):hover {
    background: none;
  }

  .empty {
    margin: 0;
    padding: var(--stack-control-xsmall-padding-block) var(--stack-control-xsmall-padding-inline-normal);
    color: var(--color-text-base-muted);
    font-family: var(--font-stack-body);
    font-size: var(--text-body-small-size);
    line-height: var(--text-body-small-line-height);
  }

  .footer {
    padding: var(--stack-padding-condensed);
    border-block-start: var(--border-width-default) solid var(--color-border-base-strong);
  }

  .create {
    --icon-size: var(--icon-small);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--base-8);
    inline-size: 100%;
    padding: var(--stack-control-xsmall-padding-block) var(--stack-control-xsmall-padding-inline-normal);
    color: var(--color-text-base-default);
    background: none;
    border: 0;
    border-radius: var(--border-radius-small);
    font: inherit;
    text-align: start;
    cursor: pointer;
  }

  .create:hover:not(:disabled) {
    background: var(--color-background-base-input-hover);
  }

  .create:disabled {
    color: var(--color-text-base-disabled);
    cursor: not-allowed;
  }

  .create:focus-visible {
    outline: var(--border-width-focus) solid var(--color-border-base-focus);
    outline-offset: calc(var(--border-width-focus) * -1);
  }
</style>
