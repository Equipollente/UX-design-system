---
// CardText — contenu textuel réutilisable d'une carte.
// Le composant ne connaît pas le lien de la carte : CardDefault contrôle ce
// comportement autour de son slot. Figma : 451:1012.

import type { HTMLAttributes } from 'astro/types';

type HeadingLevel = 2 | 3 | 4 | 5 | 6;

interface Props extends HTMLAttributes<'div'> {
  title: string;
  subtitle?: string;
  meta?: string;
  headingLevel?: HeadingLevel;
  titleSize?: 'title' | 'heading';
}

const {
  title,
  subtitle,
  meta,
  headingLevel = 3,
  titleSize = 'title',
  class: className,
  ...rest
} = Astro.props;

const Heading = `h${headingLevel}` as 'h2' | 'h3' | 'h4' | 'h5' | 'h6';
const classes = [
  'card-text-content',
  titleSize !== 'title' && 'card-text-heading',
  className,
]
  .filter(Boolean)
  .join(' ');
---

<div data-slot="card-text" class={classes} {...rest}>
  <Heading class="cards-text-title">{title}</Heading>
  {subtitle && <p class="cards-text-subtitle">{subtitle}</p>}
  {meta && <p class="cards-text-meta">{meta}</p>}
</div>

<style>
  .card-text-content {
    display: grid;
    gap: var(--base-4);
    min-width: 0;
  }

  .cards-text-title {
    margin: 0;
    font-family: var(--font-stack-heading);
    font-size: var(--text-title-large-size);
    color: var(--color-text-base-default);
  }

  .cards-text-subtitle,
  .cards-text-meta {
    margin: 0;
  }

  .cards-text-subtitle {
    font-size: var(--text-body-large-size);
    color: var(--color-text-base-default);
  }

  .cards-text-meta {
    font-size: var(--text-body-medium-size);
    color: var(--color-text-base-muted);
  }

  .card-text-content:global(.card-text-heading) {
    --text-title-large-size: var(--text-title-small-size);
  }
</style>
