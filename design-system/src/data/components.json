  "Card": {
    "source": "design-system/src/components/Card.astro",
    "description": "",
    "natifs": {
      "balise": null,
      "ecartes": []
    },
    "props": [
      {
        "nom": "orientation",
        "type": "'vertical' | 'horizontal'",
        "valeurs": [
          "vertical",
          "horizontal"
        ],
        "requis": false,
        "description": "Les deux variantes de Figma. Verticale, l'image est en tête ; horizontale,\nelle occupe la moitié gauche."
      },
      {
        "nom": "title",
        "type": "string",
        "requis": true,
        "description": ""
      },
      {
        "nom": "subtitle",
        "type": "string",
        "requis": false,
        "description": "La ligne sous le titre."
      },
      {
        "nom": "meta",
        "type": "string",
        "requis": false,
        "description": "L'information de second plan, sous le sous-titre — une date, un lieu, un\nauteur. Absente ⇒ la ligne n'est pas rendue."
      },
      {
        "nom": "image",
        "type": "{ src: string; alt: string; width: number; height: number }",
        "requis": false,
        "description": "L'image de tête. `width` et `height` donnent le rapport de l'image, pas la\ntaille de la boîte : c'est la carte qui pose la hauteur, l'image la\nremplit en cover. Absente ⇒ la carte n'en réserve pas la place."
      },
      {
        "nom": "headingLevel",
        "type": "2 | 3 | 4 | 5",
        "requis": false,
        "description": "Le rang du titre : il se range sous ce que la page porte déjà. Le rang ne\nchange pas le dessin — la taille vient du composant, pas de la balise."
      },
      {
        "nom": "titleSize",
        "type": "'title' | 'heading'",
        "valeurs": [
          "title",
          "heading"
        ],
        "requis": false,
        "description": "La taille du titre, prise dans l'échelle : `title` est celle d'un h2 —\n2rem, ce que Figma dessine — et `heading` celle d'un h4, 1.25rem. Elle ne\nrègle que la taille ; la police, la graisse, l'interligne et\nl'interlettrage suivent d'eux-mêmes. Rien à voir avec `headingLevel`, qui\nrègle le rang : les deux restent indépendants, et c'est le contrat."
      },
      {
        "nom": "class",
        "type": "string",
        "requis": false,
        "description": ""
      },
      {
        "nom": "style",
        "type": "string",
        "requis": false,
        "description": "Le point de surcharge : --card-media-height, et rien d'autre. Déclarée\nparce qu'elle fait partie du contrat."
      }
    ],
    "slots": [
      "tags-top",
      "tags",
      "actions"
    ],
    "utilise": []
  },
