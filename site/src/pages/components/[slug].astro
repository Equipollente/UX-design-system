---
// La page d'un composant, dans l'ordre de celles de Primer :
//
//   1. L'en-tête : son nom, une phrase qui le définit, ses liens (Figma, source).
//   2. La présentation : quand l'utiliser, quand ne pas l'utiliser.
//   3. Les exemples : le composant posé de plusieurs façons, avec le code à copier.
//   4. Le playground : le composant, des contrôles pour le régler, le code qui suit.
//   5. Les props : ses réglages, ses slots, les composants qu'il utilise.
//   6. L'accessibilité, puis les composants voisins.
//
// Seul le texte (présentation, exemples, accessibilité) est écrit à la main, dans
// src/content/components/<nom>.md. Le reste est lu dans le code du composant.
//
// Un composant a sa page dès que ses réglages obligatoires portent un `@example` (voir
// _component-pages.ts) : aucun fichier de page à écrire.
import { getEntry, render } from 'astro:content';
import ComponentPageLayout from '../../layouts/ComponentPageLayout.astro';
import ComponentIntroduction from '../../layouts/blocks/ComponentIntroduction.astro';
import ComponentExemples from '../../layouts/blocks/ComponentExemples.astro';
import ComponentPlaygroundAuto from '../../layouts/blocks/ComponentPlaygroundAuto.astro';
import ComponentElements from '../../layouts/blocks/ComponentElements.astro';
import TexteCode from '../../layouts/blocks/TexteCode.astro';
import Tabs from 'ux-design-system/components/tabs/Tabs.astro';
import TabList from 'ux-design-system/components/tabs/TabList.astro';
import TabButton from 'ux-design-system/components/tabs/TabButton.astro';
import TabPanel from 'ux-design-system/components/tabs/TabPanel.astro';
import components from 'ux-design-system/data/components.json';
import { withBase } from 'ux-design-system/lib/url';
import { componentPageGroups, generatedPages } from '../_component-pages';

export function getStaticPaths() {
  return generatedPages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props;

// Les composants du paquet, chargés d'avance : Astro doit connaître chaque fichier à la construction.
const modules = import.meta.glob<{ default: any }>('../../../../design-system/src/components/{,forms/}*.astro', { eager: true });
// Un composant réécrit (forms/) l'emporte sur l'ancien de même nom : le script des props fait de même.
const Composant = Object.entries(modules)
  .filter(([chemin]) => chemin.endsWith(`/${page.nom}.astro`))
  .sort(([a], [b]) => Number(b.includes('/forms/')) - Number(a.includes('/forms/')))[0][1].default;

const fiche = (components as unknown as Record<string, any>)[page.nom];

// Les autres composants que les exemples de la page montrent (`composant:` dans leur texte).
const composantDe = (nom: string) =>
  Object.entries(modules)
    .filter(([chemin]) => chemin.endsWith(`/${nom}.astro`))
    .sort(([a], [b]) => Number(b.includes('/forms/')) - Number(a.includes('/forms/')))[0][1].default;

// Le texte écrit à la main, s'il existe.
const texte = await getEntry('components', page.slug);
const Presentation = texte ? (await render(texte)).Content : null;
const donnees = texte?.data;
// Un exemple nomme son composant, ou chacune de ses instances le sien (`composant: SelectPanel`).
const nomsAutres = (donnees?.exemples ?? []).flatMap((e) => [
  e.composant,
  ...[...e.instances, ...(e.cartes ?? []).flatMap((c) => c.instances)].map((i) => i.composant),
]);
const autres = Object.fromEntries(
  [...new Set(nomsAutres.filter((n): n is string => typeof n === 'string' && n !== page.nom))].map((nom) => [
    nom,
    {
      Composant: composantDe(nom),
      reglages: (components as unknown as Record<string, any>)[nom].props,
      source: (components as unknown as Record<string, any>)[nom].source,
    },
  ]),
);
---

<ComponentPageLayout
  title={donnees?.title ?? page.title}
  description={donnees?.description ?? page.description}
  sidebarId="component-pages-sidebar"
  sidebarTitle="UX design system"
  sidebarGroups={componentPageGroups}
  current={withBase(`/components/${page.slug}`)}
  sidebarLabel="Navigation des composants"
>
  <div slot="header">
    <!-- 1. L'en-tête : le nom et la phrase qui le définit -->
    <ComponentIntroduction title={donnees?.title ?? page.title} description={donnees?.description ?? page.description} />
  </div>

  <div slot="content">
    <!-- 2. Trois onglets : la vue d'ensemble, les conseils d'usage, l'accessibilité -->
    <Tabs>
      <TabList label="Sections de la page">
        <TabButton id="onglet-apercu" controls="panneau-apercu" selected>Overview</TabButton>
        <TabButton id="onglet-usage" controls="panneau-usage">Guidelines</TabButton>
        <TabButton id="onglet-accessibilite" controls="panneau-accessibilite">Accessibility</TabButton>
      </TabList>

      <TabPanel class="panneau" id="panneau-apercu" labelledby="onglet-apercu">
        <div class="apercu">
          <!-- 3. Les statuts : où en est le composant, côté code et côté Figma -->
          <div class="statuts">
            <section class="statut">
              <h2>Astro</h2>
              <p>{fiche.experimental ? 'Expérimental' : 'Prêt'} · <code>{fiche.source}</code> · Page de doc</p>
            </section>
            <section class="statut">
              <h2>Figma</h2>
              <p>{donnees?.figma ? <a href={donnees.figma}>Voir dans Figma</a> : 'Pas de lien'}</p>
            </section>
          </div>

          <!-- 4. Les exemples -->
          {donnees && donnees.exemples.length > 0 && (
            <ComponentExemples nom={page.nom} reglages={fiche.props} Composant={Composant} source={fiche.source} exemples={donnees.exemples} autres={autres} />
          )}

          <!-- 5. Le playground -->
          <ComponentPlaygroundAuto nom={page.nom} reglages={fiche.props} Composant={Composant} source={fiche.source} />

          <!-- 6. Les props -->
          <ComponentElements
            nom={page.nom}
            reglages={fiche.props}
            slots={fiche.slots}
            utilise={fiche.utilise}
            natifs={fiche.natifs}
            source={fiche.source}
          />

          <!-- 7. Les liens connexes -->
          {donnees && donnees.voirAussi.length > 0 && (
            <section class="liens-connexes">
              <h2>Liens connexes</h2>
              <ul>
                {donnees.voirAussi.map((v) => <li><code>{v.nom}</code> : {v.texte}</li>)}
              </ul>
            </section>
          )}
        </div>
      </TabPanel>

      <TabPanel class="panneau" id="panneau-usage" labelledby="onglet-usage" hidden>
        {Presentation ? (
          <section class="presentation">
            <Presentation />
          </section>
        ) : (
          <p>Pas encore de conseils d'usage pour ce composant.</p>
        )}
      </TabPanel>

      <TabPanel class="panneau" id="panneau-accessibilite" labelledby="onglet-accessibilite" hidden>
        {donnees && donnees.accessibilite.length > 0 ? (
          <ul class="accessibilite">
            {donnees.accessibilite.map((ligne) => <li><TexteCode texte={ligne} /></li>)}
          </ul>
        ) : (
          <p>Pas encore de notes d'accessibilité pour ce composant.</p>
        )}
      </TabPanel>
    </Tabs>
  </div>
</ComponentPageLayout>

<style>
  /* Le panneau d'onglet est ici de la page, pas une carte : le fond et le cadre s'effacent. */
  :global(div.tabs-tabpanel.panneau) {
    padding: 0;
    background: none;
    border: 0;
    align-items: stretch;
  }

  /* Le fil de la page : chaque bloc se sépare du suivant de la même mesure. */
  .apercu {
    display: flex;
    flex-direction: column;
    gap: var(--base-32);
    padding-block-start: var(--base-32);
  }

  .statuts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--base-24);
  }

  /* Une carte de statut : un titre vert, une ligne d'état en discret. */
  .statut {
    display: flex;
    flex-direction: column;
    gap: var(--base-12);
    padding: var(--base-24);
    background: var(--color-surface-default);
    border: var(--border-width-default) solid var(--color-border-base-subtle);
    border-radius: var(--border-radius-medium);
  }
  .statut h2 {
    margin: 0;
    color: var(--color-text-success-default);
    font-size: var(--text-body-medium-size);
    font-weight: var(--base-text-weight-bold);
  }
  .statut p {
    margin: 0;
    color: var(--color-text-base-muted);
    font-size: var(--text-body-small-size);
  }

  .liens-connexes h2 {
    margin: 0 0 var(--base-16);
    font-size: var(--text-title-medium-size);
  }
  .liens-connexes ul {
    margin: 0;
  }

  .presentation :global(h2) {
    margin-block: var(--base-24) var(--base-8);
    font-size: var(--text-title-small-size);
  }
  .presentation,
  .accessibilite {
    max-inline-size: 70ch;
    padding-block-start: var(--base-32);
  }
</style>
