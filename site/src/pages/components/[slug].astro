---
// La page d'un composant, dans l'ordre de celles de Primer :
//
//   1. L'en-tête : son nom, une phrase qui le définit, ses liens (Figma, source).
//   2. La présentation : quand l'utiliser, quand ne pas l'utiliser.
//   3. Les exemples : le composant posé de plusieurs façons, avec le code à copier.
//   4. Le playground : le composant, des contrôles pour le régler, le code qui suit.
//   5. Les props : ses réglages, ses slots, les composants qu'il utilise.
//   6. L'accessibilité, puis les composants voisins.
//
// Seul le texte (présentation, exemples, accessibilité) est écrit à la main, dans
// src/content/components/<nom>.md. Le reste est lu dans le code du composant.
//
// Un composant a sa page dès que ses réglages obligatoires portent un `@example` (voir
// _component-pages.ts) : aucun fichier de page à écrire.
import { getEntry, render } from 'astro:content';
import ComponentPageLayout from '../../layouts/ComponentPageLayout.astro';
import ComponentIntroduction from '../../layouts/blocks/ComponentIntroduction.astro';
import ComponentExemples from '../../layouts/blocks/ComponentExemples.astro';
import ComponentPlaygroundAuto from '../../layouts/blocks/ComponentPlaygroundAuto.astro';
import ComponentElements from '../../layouts/blocks/ComponentElements.astro';
import TexteCode from '../../layouts/blocks/TexteCode.astro';
import components from 'ux-design-system/data/components.json';
import { withBase } from 'ux-design-system/lib/url';
import { componentPageGroups, generatedPages } from '../_component-pages';

export function getStaticPaths() {
  return generatedPages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props;

// Les composants du paquet, chargés d'avance : Astro doit connaître chaque fichier à la construction.
const modules = import.meta.glob<{ default: any }>('../../../../design-system/src/components/{,forms/}*.astro', { eager: true });
// Un composant réécrit (forms/) l'emporte sur l'ancien de même nom : le script des props fait de même.
const Composant = Object.entries(modules)
  .filter(([chemin]) => chemin.endsWith(`/${page.nom}.astro`))
  .sort(([a], [b]) => Number(b.includes('/forms/')) - Number(a.includes('/forms/')))[0][1].default;

const fiche = (components as unknown as Record<string, any>)[page.nom];

// Le texte écrit à la main, s'il existe.
const texte = await getEntry('components', page.slug);
const Presentation = texte ? (await render(texte)).Content : null;
const donnees = texte?.data;
---

<ComponentPageLayout
  title={donnees?.title ?? page.title}
  description={donnees?.description ?? page.description}
  sidebarId="component-pages-sidebar"
  sidebarTitle="UX design system"
  sidebarGroups={componentPageGroups}
  current={withBase(`/components/${page.slug}`)}
  sidebarLabel="Navigation des composants"
>
  <div slot="header">
    <!-- 1. L'en-tête -->
    <nav class="fil" aria-label="Fil d'Ariane">
      <a href={withBase('/components')}>Composants</a> <span aria-hidden="true">/</span> <span>{donnees?.title ?? page.title}</span>
    </nav>
    <ComponentIntroduction title={donnees?.title ?? page.title} description={donnees?.description ?? page.description} />
    <ul class="liens">
      {fiche.experimental && <li><span class="badge">Expérimental</span></li>}
      {donnees?.figma && <li><a href={donnees.figma}>Voir dans Figma</a></li>}
      <li>Source : <code>{fiche.source}</code></li>
    </ul>
  </div>

  <div slot="content">
    <!-- 2. La présentation -->
    {Presentation && (
      <section class="presentation">
        <Presentation />
      </section>
    )}

    <!-- 3. Les exemples -->
    {donnees && donnees.exemples.length > 0 && (
      <ComponentExemples nom={page.nom} reglages={fiche.props} Composant={Composant} exemples={donnees.exemples} />
    )}

    <!-- 4. Le playground -->
    <ComponentPlaygroundAuto nom={page.nom} reglages={fiche.props} Composant={Composant} source={fiche.source} />

    <!-- 5. Les props -->
    <ComponentElements
      reglages={fiche.props}
      slots={fiche.slots}
      utilise={fiche.utilise}
      natifs={fiche.natifs}
      source={fiche.source}
    />

    <!-- 6. L'accessibilité, puis les composants voisins -->
    {donnees && donnees.accessibilite.length > 0 && (
      <section class="suite">
        <h2>Accessibilité</h2>
        <ul>
          {donnees.accessibilite.map((ligne) => <li><TexteCode texte={ligne} /></li>)}
        </ul>
      </section>
    )}
    {donnees && donnees.voirAussi.length > 0 && (
      <section class="suite">
        <h2>Voir aussi</h2>
        <ul>
          {donnees.voirAussi.map((v) => <li><code>{v.nom}</code> : {v.texte}</li>)}
        </ul>
      </section>
    )}
  </div>
</ComponentPageLayout>

<style>
  .fil {
    margin-block-end: var(--base-16);
    color: var(--color-text-base-muted);
    font-size: var(--text-body-small-size);
  }
  .liens {
    display: flex;
    flex-wrap: wrap;
    gap: var(--base-8) var(--base-24);
    margin: 0 0 var(--base-32);
    padding: 0;
    list-style: none;
    font-size: var(--text-body-small-size);
  }
  .badge {
    padding: var(--base-4) var(--base-12);
    border-radius: 999px;
    background: var(--color-background-highlight-subtle);
    font-size: var(--text-caption-size);
  }
  .presentation :global(h2) {
    margin-block: var(--base-24) var(--base-8);
    font-size: var(--text-title-small-size);
  }
  .presentation {
    max-inline-size: 70ch;
    margin-block-end: var(--base-32);
  }
  .suite {
    margin-block-start: var(--base-48);
  }
  .suite h2 {
    font-size: var(--text-title-large-size);
  }
</style>
