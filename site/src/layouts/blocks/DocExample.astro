---
// DocExample — un exemple de la doc, dans toujours le même ordre : un titre, une
// ou deux phrases, le composant qui marche, et son code entier, replié.
//
// C'est le format de la doc d'Atlassian pour ses exemples, et il tient à une
// raison : on vient ici pour voir, essayer, copier — pas pour lire. Tout ce qui
// explique pourquoi le composant est fait ainsi ne s'écrit pas ici, mais plus bas
// dans la page, replié lui aussi.
//
// Le code est donné par l'appelant, qui le tire des mêmes props que le composant
// montré : l'exemple et son code ne peuvent donc pas diverger.

interface Props {
  title: string;
  /** Une ou deux phrases. Pas plus. */
  description?: string;
  /** Le code complet, tel qu'on le colle. */
  code: string;
}

const { title, description, code } = Astro.props;
// Ce qui est entre accents graves s'écrit en code : un nom de prop se repère.
const parts = description?.split('`') ?? [];
---

<article class="doc-example">
  <h4 class="doc-example-title">{title}</h4>
  {
    description && (
      <p class="doc-example-description">
        {parts.map((t, i) => (i % 2 ? <code>{t}</code> : t))}
      </p>
    )
  }

  <div class="doc-example-demo">
    <slot />
  </div>

  <details class="doc-example-code">
    <summary>Voir le code</summary>
    <pre><code>{code}</code></pre>
    <button type="button" class="doc-example-copy" data-copy>Copier le code</button>
  </details>
</article>

{/* Un script, pour le seul bouton de copie : sans lui, le code reste lisible et se
    sélectionne à la main. */}
<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    button.addEventListener('click', async () => {
      const code = button.closest('details')?.querySelector('code')?.textContent ?? '';
      try {
        await navigator.clipboard.writeText(code);
        button.textContent = 'Code copié';
      } catch {
        button.textContent = 'Copie impossible — sélectionne le code';
      }
      window.setTimeout(() => (button.textContent = 'Copier le code'), 1800);
    });
  }
</script>

<style>
  .doc-example {
    margin-bottom: var(--base-32);
  }

  .doc-example-title {
    margin: 0 0 var(--base-4);
    font-size: var(--text-title-small-size);
  }

  .doc-example-description {
    max-width: 66ch;
    margin: 0 0 var(--base-16);
    color: var(--color-text-base-muted);
  }

  /* Le composant, seul sur son fond : c'est ce qu'on vient regarder. La hauteur
     minimale laisse sa liste s'ouvrir sans qu'on ait à défiler. */
  .doc-example-demo {
    padding: var(--base-24);
    background: var(--color-surface-raised);
    border: var(--border-width-default) solid var(--color-border-base-subtle);
    border-radius: var(--border-radius-medium);
  }

  .doc-example-demo > :global(*) {
    max-width: 26rem;
  }

  .doc-example-code {
    margin-top: var(--base-12);
  }

  .doc-example-code summary {
    display: inline-block;
    cursor: pointer;
    font-weight: var(--base-text-weight-medium);
    color: var(--color-text-primary-default);
  }

  .doc-example-code summary:focus-visible,
  .doc-example-copy:focus-visible {
    outline: var(--border-width-thick) solid var(--color-border-base-focus);
    outline-offset: var(--border-outline-focus-offset);
  }

  /* Le code est un bloc : un seul fond, pas une bande par ligne comme le fait
     `code` en ligne. */
  .doc-example-code pre {
    margin: var(--base-12) 0 0;
    padding: var(--base-16);
    overflow-x: auto;
    background: var(--color-surface-raised);
    border: var(--border-width-default) solid var(--color-border-base-subtle);
    border-radius: var(--border-radius-medium);
    font-size: var(--text-body-small-size);
  }

  .doc-example-code pre code {
    padding: 0;
    background: none;
  }

  .doc-example-copy {
    margin-top: var(--base-8);
    padding: var(--base-8) var(--base-16);
    border: var(--border-width-default) solid var(--color-border-base-subtle);
    border-radius: var(--border-radius-small);
    background: var(--color-surface-default);
    color: var(--color-text-base-default);
    font: inherit;
    cursor: pointer;
  }
</style>
