---
// L'Overview d'un composant : un bloc par réglage à choix limité (status, size…), qui montre
// le vrai composant une fois par valeur. C'est le « Variant block » de la maquette Figma.
//
// Tout est fabriqué à la construction, aucun JavaScript. Dans un bloc, une seule chose change :
// la valeur du réglage. Tout le reste garde sa valeur de départ.

interface Reglage {
  nom: string;
  type: string;
  valeurs?: string[];
  requis: boolean;
  description: string;
  default?: string;
  exemple?: string;
}

interface Props {
  reglages: Reglage[];
  Composant: any; // un composant Astro : aucun type d'Astro ne le décrit
}

const { reglages, Composant } = Astro.props;

const defautDe = (r: Reglage): string | boolean | number => {
  if (r.valeurs) return r.default ?? r.valeurs[0];
  if (r.type === 'boolean') return r.default === 'true';
  if (r.type === 'number') return Number(r.exemple ?? r.default ?? 0);
  if (r.type === 'string') return r.exemple ?? r.default ?? '';
  return '';
};

// Les réglages de départ, que chaque bloc copie avant d'en changer un seul.
const depart = Object.fromEntries(
  reglages.filter((r) => r.valeurs || ['boolean', 'number', 'string'].includes(r.type)).map((r) => [r.nom, defautDe(r)]),
);

const blocs = reglages
  .filter((r) => r.valeurs || r.type === 'boolean')
  .map((r) => ({
    reglage: r,
    valeurs: (r.valeurs ?? [false, true]) as (string | boolean)[],
  }));
---

<div class="variantes">
  <h2>Overview</h2>

  {blocs.map(({ reglage, valeurs }) => (
    <section class="bloc">
      <h3><code>{reglage.nom}</code></h3>
      <div class="rangee">
        {valeurs.map((valeur) => (
          <figure>
            <div class="exemple">
              <Composant {...depart} {...{ [reglage.nom]: valeur }} id={`${reglage.nom}-${String(valeur)}`} />
            </div>
            <figcaption><code>{String(valeur)}</code></figcaption>
          </figure>
        ))}
      </div>
    </section>
  ))}
</div>

<style>
  h2 {
    font-size: var(--text-title-large-size);
  }
  h3 {
    margin-block: var(--base-24) var(--base-12);
    font-size: var(--text-title-small-size);
  }
  .rangee {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--base-24);
    padding: var(--base-24);
    background: var(--color-surface-raised);
    border: var(--border-width-default) solid var(--color-border-base-subtle);
    border-radius: var(--border-radius-small);
  }
  figure {
    margin: 0;
  }
  figcaption {
    margin-block-start: var(--base-8);
    color: var(--color-text-base-muted);
    font-size: var(--text-caption-size);
  }
</style>
