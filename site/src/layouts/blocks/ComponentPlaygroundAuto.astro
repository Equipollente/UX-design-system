---
// Le composant, avec ses réglages et le code à copier.
//
// Trois choses, de haut en bas :
//   · le composant, tel qu'il se voit ;
//   · un tableau de réglages : on change une ligne, le composant change ;
//   · le code à copier, qui s'écrit tout seul d'après les réglages choisis.
//
// Un composant Astro n'est fabriqué qu'une fois, quand le site est construit : il ne sait pas
// se refabriquer dans le navigateur. Le playground contourne ça de deux façons :
//   1. Il fabrique d'avance chaque combinaison des réglages à choix limité (status × size…),
//      chacune dans un <template> caché. Le navigateur n'en montre qu'une.
//   2. Pour les textes (libellé, aide…), il met un REPÈRE (⟦label⟧) que le navigateur remplace
//      par ce qui est tapé.
// Au-delà de PLAFOND combinaisons, les derniers réglages restent à leur valeur de départ.

// Ce que build-props.mjs a lu dans le code du composant.
interface Reglage {
  nom: string;
  type: string;
  valeurs?: string[];
  requis: boolean;
  description: string;
  default?: string;
  exemple?: string;
  groupe?: string;
  /** `false` : le réglage change la structure du composant, le playground ne l'essaie pas. */
  playground?: boolean;
}

interface Props {
  /** Le nom du composant, tel qu'on l'importe : `InputPG`. */
  nom: string;
  reglages: Reglage[];
  Composant: any; // un composant Astro : aucun type d'Astro ne le décrit
  /** Où vit le fichier, tel que components.json le donne : c'est de là que vient la ligne d'import. */
  source?: string;
}

const { nom, reglages, Composant, source } = Astro.props;
// `design-system/src/components/forms/Input.astro` s'importe `ux-design-system/components/forms/Input.astro`.
const chemin = source ? source.replace('design-system/src/', 'ux-design-system/') : `ux-design-system/components/${nom}.astro`;

const PLAFOND = 300;
const repere = (n: string) => `⟦${n}⟧`;

// ── Quel contrôle pour quel réglage ──────────────────────────────────────────
type Sorte = 'choix' | 'oui-non' | 'nombre' | 'texte';
const sorteDe = (r: Reglage): Sorte | null =>
  r.valeurs ? 'choix' : r.type === 'boolean' ? 'oui-non' : r.type === 'number' ? 'nombre' : r.type === 'string' ? 'texte' : null;

const essayable = (r: Reglage) => sorteDe(r) !== null && r.playground !== false;
const reglables = reglages.filter(essayable);
const nonReglables = reglages.filter((r) => !essayable(r));

const defautDe = (r: Reglage): string | boolean | number => {
  const sorte = sorteDe(r);
  if (sorte === 'choix') return r.default ?? r.valeurs![0];
  if (sorte === 'oui-non') return r.default === 'true';
  if (sorte === 'nombre') return Number(r.exemple ?? r.default ?? 0);
  return r.exemple ?? r.default ?? '';
};

// ── Les combinaisons à fabriquer d'avance ────────────────────────────────────
const valeursDe = (r: Reglage): (string | boolean)[] => r.valeurs ?? [false, true];
let axes = reglables.filter((r) => ['choix', 'oui-non'].includes(sorteDe(r)!));
const figes: string[] = [];
const produit = (liste: Reglage[]) => liste.reduce((n, r) => n * valeursDe(r).length, 1);
while (produit(axes) > PLAFOND) figes.push(axes.pop()!.nom);

type Combinaison = Record<string, string | boolean>;
const combinaisons = axes.reduce<Combinaison[]>(
  (acc, r) => acc.flatMap((c) => valeursDe(r).map((v) => ({ ...c, [r.nom]: v }))),
  [{}],
);
const cleDe = (c: Combinaison) => axes.map((r) => String(c[r.nom])).join('|');

const reglagesDe = (c: Combinaison, avecRepere: boolean) =>
  Object.fromEntries(
    reglables.map((r) => {
      const sorte = sorteDe(r);
      if (c[r.nom] !== undefined) return [r.nom, c[r.nom]];
      if (avecRepere && (sorte === 'texte' || sorte === 'nombre')) return [r.nom, repere(r.nom)];
      return [r.nom, defautDe(r)];
    }),
  );

// Les réglages se rangent par section, comme dans le Storybook de Primer : la section du composant
// d'abord, puis celles de ses pièces (libellé, aide, message), lues dans `@group`.
const parGroupe = new Map<string, Reglage[]>();
for (const r of reglables) parGroupe.set(r.groupe ?? nom, [...(parGroupe.get(r.groupe ?? nom) ?? []), r]);
const groupes = [...parGroupe.entries()].sort(([a], [b]) => (a === nom ? -1 : b === nom ? 1 : 0));

const config = {
  nom,
  chemin,
  axes: axes.map((r) => r.nom),
  reglages: reglables.map((r) => ({ nom: r.nom, sorte: sorteDe(r), defaut: defautDe(r), requis: r.requis })),
};
const configJson = JSON.stringify(config).replace(/</g, '\\u003c');
---

<section class="playground" data-playground>
  <h2>Playground</h2>
  <p class="note">Changer un réglage : le composant et le code se mettent à jour.</p>

  <!-- Le composant. Sans JavaScript, on voit au moins sa version de départ. -->
  <div class="canvas" data-canvas aria-live="polite">
    <Composant {...reglagesDe({}, false)} />
  </div>

  <!-- Les réglages, rangés par section : un nom à gauche, son contrôle à droite. -->
  <div class="reglages">
    <div class="entete-reglages">
      <span>Name</span>
      <span>Control</span>
      <button type="button" data-reinitialiser aria-label="Réinitialiser les réglages" title="Réinitialiser">
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M3 6h7a3 3 0 1 1 0 6H6M3 6l2.5-2.5M3 6l2.5 2.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </button>
    </div>
    {groupes.map(([groupe, liste]) => (
      <details class="groupe" open>
        <summary>{groupe}</summary>
        {liste.map((r) => {
          const sorte = sorteDe(r)!;
          const defaut = defautDe(r);
          return (
            <div class="ligne">
              <div class="nom">
                <code title={r.description}>{r.nom}</code>{r.requis && <span class="requis" title="Obligatoire"> *</span>}
              </div>
              <div class="controle">
                {sorte === 'choix' && (
                  <fieldset class="options">
                    <legend>{r.nom}</legend>
                    {r.valeurs!.map((v) => (
                      <label>
                        <input type="radio" name={`reglage-${r.nom}`} data-reglage={r.nom} value={v} checked={v === defaut} /> {v}
                      </label>
                    ))}
                  </fieldset>
                )}
                {sorte === 'oui-non' && (
                  <fieldset class="options bascule">
                    <legend>{r.nom}</legend>
                    {[
                      ['false', 'False'],
                      ['true', 'True'],
                    ].map(([v, texte]) => (
                      <label>
                        <input type="radio" name={`reglage-${r.nom}`} data-reglage={r.nom} value={v} checked={String(defaut) === v} />
                        <span>{texte}</span>
                      </label>
                    ))}
                  </fieldset>
                )}
                {sorte === 'texte' && <input type="text" data-reglage={r.nom} value={String(defaut)} placeholder="Modifier le texte…" aria-label={r.nom} />}
                {sorte === 'nombre' && <input type="number" data-reglage={r.nom} value={String(defaut)} aria-label={r.nom} />}
              </div>
            </div>
          );
        })}
      </details>
    ))}
  </div>
  {nonReglables.length > 0 && (
    <p class="note">Réglages qu'on ne peut pas essayer ici : {nonReglables.map((r) => <code>{r.nom}</code>)}.</p>
  )}
  {figes.length > 0 && (
    <p class="note">
      Trop de combinaisons : {figes.map((n) => <code>{n}</code>)} reste{figes.length > 1 ? 'nt' : ''} à sa valeur de départ.
    </p>
  )}

  <div class="entete-code">
    <h3>Code</h3>
    <button type="button" data-copier>Copier</button>
  </div>
  <pre><code data-code></code></pre>

  <!-- Les combinaisons, fabriquées d'avance et cachées. Le navigateur en pioche une. -->
  <div hidden>
    {combinaisons.map((c) => (
      <template data-combinaison={cleDe(c)}>
        <Composant {...reglagesDe(c, true)} />
      </template>
    ))}
  </div>

  <script is:inline type="application/json" data-config set:html={configJson} />
</section>

<style>
  h2 {
    font-size: var(--text-title-large-size);
  }
  h3 {
    margin-block: var(--base-24) var(--base-8);
    font-size: var(--text-title-small-size);
  }

  /* Le composant, sur un fond neutre pour le voir tel qu'il est. */
  .canvas {
    padding: var(--base-32);
    background: var(--color-surface-raised);
    border: var(--border-width-default) solid var(--color-border-base-subtle);
    border-radius: var(--border-radius-small);
  }

  /* Le panneau des réglages, comme celui du Storybook de Primer : une ligne d'en-tête, des
     sections repliables, puis un nom à gauche et son contrôle à droite. */
  .reglages {
    margin-block-start: var(--base-16);
    border: var(--border-width-default) solid var(--color-border-base-subtle);
    border-radius: var(--border-radius-small);
    overflow: hidden;
    font-size: var(--text-body-small-size);
  }
  .entete-reglages {
    display: grid;
    grid-template-columns: 40% minmax(0, 1fr) auto;
    align-items: center;
    padding: var(--base-8) var(--base-16);
    color: var(--color-text-base-muted);
    font-weight: var(--base-text-weight-medium);
  }
  .entete-reglages button {
    padding: var(--base-4);
    border: 0;
    border-radius: var(--border-radius-small);
    background: transparent;
    color: inherit;
    line-height: 0;
    cursor: pointer;
  }
  .groupe > summary {
    display: flex;
    align-items: center;
    gap: var(--base-8);
    padding: var(--base-8) var(--base-16);
    background: var(--color-surface-raised);
    border-block: var(--border-width-default) solid var(--color-border-base-subtle);
    color: var(--color-text-base-muted);
    font-size: var(--text-caption-size);
    font-weight: var(--base-text-weight-bold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    list-style: none;
  }
  .groupe > summary::-webkit-details-marker {
    display: none;
  }
  .groupe > summary::before {
    content: '';
    inline-size: 6px;
    block-size: 6px;
    border-inline-end: 1.5px solid currentColor;
    border-block-end: 1.5px solid currentColor;
    transform: rotate(45deg) translate(-2px, -2px);
    transition: transform 0.1s;
  }
  .groupe:not([open]) > summary::before {
    transform: rotate(-45deg);
  }
  .ligne {
    display: grid;
    grid-template-columns: 40% minmax(0, 1fr);
    gap: var(--base-16);
    padding: var(--base-12) var(--base-16);
    border-block-end: var(--border-width-default) solid var(--color-border-base-subtle);
  }
  .nom {
    font-weight: var(--base-text-weight-medium);
  }
  .requis {
    color: var(--color-text-danger-default);
  }

  /* Un choix : les valeurs en colonne, comme chez Primer. */
  .options {
    display: flex;
    flex-direction: column;
    gap: var(--base-8);
    margin: 0;
    padding: 0;
    border: 0;
  }
  .options legend {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .options label {
    display: inline-flex;
    align-items: center;
    gap: var(--base-8);
    cursor: pointer;
  }

  /* Vrai / faux : deux pastilles côte à côte, la choisie est pleine. */
  .bascule {
    flex-direction: row;
    gap: 0;
    inline-size: fit-content;
    border: var(--border-width-default) solid var(--color-border-base-input);
    border-radius: 999px;
    overflow: hidden;
  }
  .bascule input {
    position: absolute;
    opacity: 0;
  }
  .bascule span {
    display: block;
    padding: var(--base-4) var(--base-16);
    color: var(--color-text-base-muted);
  }
  .bascule input:checked + span {
    background: var(--color-background-primary-subtle);
    color: var(--color-text-base-default);
    font-weight: var(--base-text-weight-bold);
  }
  .bascule input:focus-visible + span {
    outline: var(--border-width-thick) solid var(--color-border-base-focus);
    outline-offset: -2px;
  }

  .controle input[type='text'],
  .controle input[type='number'] {
    inline-size: 100%;
    padding: var(--base-8) var(--base-12);
    border: var(--border-width-default) solid var(--color-border-base-input);
    border-radius: var(--border-radius-small);
    font: inherit;
  }

  .note {
    color: var(--color-text-base-muted);
    font-size: var(--text-body-small-size);
  }

  .entete-code {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--base-16);
  }
  button {
    padding: var(--base-4) var(--base-16);
    border: var(--border-width-default) solid var(--color-border-base-input);
    border-radius: 999px;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }
  pre {
    margin: 0;
    padding: var(--base-16);
    overflow-x: auto;
    background: var(--color-surface-raised);
    border-radius: var(--border-radius-small);
  }
</style>

<script>
  // Ce que le navigateur fait : choisir la bonne combinaison, remplacer les repères, écrire
  // le code, et le copier.

  type Valeur = string | boolean | number;
  interface Reglage {
    nom: string;
    sorte: 'choix' | 'oui-non' | 'nombre' | 'texte';
    defaut: Valeur;
    requis: boolean;
  }
  interface Config {
    nom: string;
    chemin: string;
    axes: string[];
    reglages: Reglage[];
  }

  /** Remplace les repères ⟦nom⟧ par ce qui est tapé, dans les textes et dans les attributs. */
  function remplacer(racine: DocumentFragment, etat: Record<string, Valeur>) {
    const sub = (texte: string) => texte.replace(/⟦([^⟧]+)⟧/g, (_, nom) => String(etat[nom] ?? ''));
    const marcheur = document.createTreeWalker(racine, NodeFilter.SHOW_TEXT);
    for (let n = marcheur.nextNode(); n; n = marcheur.nextNode()) n.nodeValue = sub(n.nodeValue ?? '');
    racine.querySelectorAll('*').forEach((el) => {
      for (const attr of Array.from(el.attributes)) if (attr.value.includes('⟦')) el.setAttribute(attr.name, sub(attr.value));
    });
  }

  /** Le code à écrire pour obtenir ce qu'on voit : seulement ce qui s'écarte du départ. */
  function code(config: Config, etat: Record<string, Valeur>) {
    const lignes: string[] = [];
    for (const r of config.reglages) {
      const v = etat[r.nom];
      if (r.sorte === 'texte') {
        if (v !== '') lignes.push(`${r.nom}="${v}"`);
      } else if (r.sorte === 'oui-non') {
        if (v !== r.defaut) lignes.push(v ? r.nom : `${r.nom}={false}`);
      } else if (r.sorte === 'nombre') {
        if (v !== '' && !Number.isNaN(v)) lignes.push(`${r.nom}={${v}}`);
      } else if (v !== r.defaut || r.requis) {
        lignes.push(`${r.nom}="${v}"`);
      }
    }
    const importation = `import ${config.nom} from '${config.chemin}';`;
    return `${importation}\n\n<${config.nom}\n${lignes.map((l) => `  ${l}`).join('\n')}\n/>`;
  }

  document.querySelectorAll<HTMLElement>('[data-playground]').forEach((racine) => {
    const config: Config = JSON.parse(racine.querySelector('[data-config]')!.textContent!);
    const canvas = racine.querySelector<HTMLElement>('[data-canvas]')!;
    const zoneCode = racine.querySelector<HTMLElement>('[data-code]')!;
    const bouton = racine.querySelector<HTMLButtonElement>('[data-copier]')!;
    const etat: Record<string, Valeur> = Object.fromEntries(config.reglages.map((r) => [r.nom, r.defaut]));

    function afficher() {
      const cle = config.axes.map((nom) => String(etat[nom])).join('|');
      const modele = Array.from(racine.querySelectorAll<HTMLTemplateElement>('template[data-combinaison]')).find(
        (t) => t.dataset.combinaison === cle,
      );
      if (modele) {
        const copie = modele.content.cloneNode(true) as DocumentFragment;
        remplacer(copie, etat);
        canvas.replaceChildren(copie);
      }
      zoneCode.textContent = code(config, etat);
    }

    // Un réglage bouge : on note sa valeur, puis on réaffiche.
    racine.addEventListener('input', (event) => {
      const champ = event.target;
      if (!(champ instanceof HTMLInputElement) || !champ.dataset.reglage) return;
      const r = config.reglages.find((x) => x.nom === champ.dataset.reglage);
      if (!r) return;
      if (r.sorte === 'oui-non') etat[r.nom] = champ.value === 'true';
      else if (r.sorte === 'nombre') etat[r.nom] = champ.value === '' ? '' : Number(champ.value);
      else etat[r.nom] = champ.value;
      afficher();
    });

    racine.querySelector<HTMLButtonElement>('[data-reinitialiser]')!.addEventListener('click', () => {
      for (const r of config.reglages) etat[r.nom] = r.defaut;
      racine.querySelectorAll<HTMLInputElement>('input[data-reglage]').forEach((champ) => {
        const defaut = etat[champ.dataset.reglage!];
        if (champ.type === 'radio') champ.checked = String(defaut) === champ.value;
        else champ.value = String(defaut);
      });
      afficher();
    });

    bouton.addEventListener('click', async () => {
      await navigator.clipboard.writeText(zoneCode.textContent ?? '');
      bouton.textContent = 'Copié';
      setTimeout(() => (bouton.textContent = 'Copier'), 1500);
    });

    afficher();
  });
</script>
