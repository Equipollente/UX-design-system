---
import BaseLayout from '../design-system/layouts/BaseLayout.astro';
import Sidebar from '../design-system/components/Sidebar.astro';
import { withBase } from '../design-system/lib/url';

const current = withBase('/components');

const groups = [
  {
    label: 'Foundations',
    items: [
      { label: 'Couleurs', href: withBase('/foundations') },
      { label: 'Typographie', href: withBase('/foundations#typography') },
      { label: 'Espacements', href: withBase('/foundations#spacing') },
    ],
  },
  {
    label: 'Composants',
    items: [
      { label: 'Boutons', href: withBase('/components#button') },
      { label: 'Cards', href: current },
      { label: 'Forms', href: withBase('/formulaire') },
    ],
  },
];
---

<BaseLayout title="Sidebar - demonstration">
  <div class="sidebar-demo">
    <Sidebar
      title="UX design system"
      groups={groups}
      id="sidebar-demo"
      current={current}
      label="Navigation de demonstration"
    />

    <main>
      <h1>Sidebar</h1>
      <p>Page temporaire pour verifier la structure HTML et l'item courant.</p>
    </main>
  </div>
</BaseLayout>

<style>
  .sidebar-demo {
    display: block;
    padding: var(--base-32);
    padding-inline-start: calc(var(--section-space-xlarge) + var(--section-space-xlarge));
  }

  main {
    padding: var(--base-32);
  }

  @media (max-width: 767px) {
    .sidebar-demo {
      display: block;
      padding-inline-start: 0;
      padding-block-start: var(--section-space-large);
    }

    main {
      padding: var(--base-32) var(--base-24);
    }
  }
</style>
