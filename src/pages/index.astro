---
// Sommaire du design system : le vocabulaire, les icônes, les objets qui en sont
// faits, et le gabarit qui les monte ensemble.
import { withBase } from '../design-system/lib/url';
import DocsLayout from '../design-system/layouts/DocsLayout.astro';
import tokens from '../design-system/data/tokens.json';

const total = tokens.length;
const composants = tokens.filter((t) => t.group === 'button').length;
const vocabulaire = total - composants;

const entrees = [
  {
    href: withBase('/foundations'),
    titre: 'Fondations',
    resume: `Le vocabulaire : ${vocabulaire} tokens de couleur, typographie, espacement, rayon, mouvement et layout. Chaque valeur affichée est lue dans sa variable CSS.`,
  },
  {
    href: withBase('/icons'),
    titre: 'Icônes',
    resume:
      "Les 11 icônes, exportées de Figma et inlinées en SVG. Une icône est un nom, pas un chemin : il se vérifie à la compilation.",
  },
  {
    href: withBase('/components'),
    titre: 'Composants',
    resume: `Les neuf objets construits avec. Doctrine d'usage, états, props, et les ${composants} tokens propres au bouton.`,
  },
  {
    href: withBase('/templates/home'),
    titre: 'Gabarit — page d’accueil',
    resume:
      "Nav, Intro et la pile d’études de cas montés en vraie grandeur. La page à copier pour monter une page d’accueil, et la seule qui montre la pile telle qu’elle se comporte.",
  },
];
---

<DocsLayout
  title="UX design system — Judith Heckmann"
  description="Le design system de Judith Heckmann : 116 tokens exportés de Figma, et les composants qui en sont faits."
>
  <header class="page-head">
    <h6>Design system</h6>
    <h1>Le système</h1>
    <p class="lead">
      {total} tokens, 11 icônes et neuf composants. La source de vérité est Figma : les variables sont exportées
      dans <code>tokens/*.tokens.json</code>, et <code>npm run tokens</code> en fait le
      <code>tokens.css</code> que consomme tout le reste. Rien n'est écrit en dur dans les composants —
      si une valeur paraît fausse, la correction va dans Figma, puis dans l'export.
    </p>
  </header>

  <main>
    <section>
      <ul class="entrees">
        {
          entrees.map(({ href, titre, resume }) => (
            <li>
              <h2><a href={href}>{titre}</a></h2>
              <p class="desc">{resume}</p>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</DocsLayout>

<style>
  .entrees {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: var(--space-xl);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .entrees li {
    padding: var(--space-xl);
    background: var(--color-bg-surface);
    border-radius: var(--radius-md);
  }

  .entrees h2 {
    margin-bottom: var(--space-sm);
    font-size: var(--font-size-subtitle);
  }

  .entrees a {
    text-decoration: none;
  }

  .entrees a:hover {
    text-decoration: underline;
  }

  .entrees .desc {
    max-width: none;
  }
</style>
