// ── Les exemples du Select ─────────────────────────────────────────────────
// Chaque exemple est un jeu de props. Le champ montré et le code affiché en
// sortent tous les deux : ils ne peuvent pas diverger.
type Exemple = { cle: string; titre: string; description: string; props: any };

const litteral = (v: any, pad = '', ligne = false): string => {
  if (typeof v === 'string') return `'${v.replace(/'/g, "\\'")}'`;
  if (Array.isArray(v)) {
    const items = v.map((x) => litteral(x, pad + '  ', true));
    const plat = `[${items.join(', ')}]`;
    return ligne || plat.length <= 120 ? plat : `[\n${items.map((i) => `${pad}  ${i},`).join('\n')}\n${pad}]`;
  }
  if (v && typeof v === 'object') {
    return `{ ${Object.entries(v).map(([k, x]) => `${k}: ${litteral(x, pad, true)}`).join(', ')} }`;
  }
  return String(v);
};

const codeSelect = (props: Record<string, any>, composant = 'Select') => {
  const attrs = Object.entries(props).map(([k, v]) =>
    v === true ? `  ${k}` : typeof v === 'string' ? `  ${k}="${v}"` : `  ${k}={${litteral(v, '  ')}}`,
  );
  return `---\nimport ${composant} from 'ux-design-system/components/${composant}.astro';\n---\n\n<${composant}\n${attrs.join('\n')}\n/>`;
};

