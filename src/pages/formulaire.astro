<script>
  // Fait vivre le cycle d'AddImage (add → in-progress → fail/success) pour de
  // vrai sur cette page — jamais dans le composant, qui reste un pur rendu
  // conditionnel piloté par ses props (voir son pavé de tête). Sans ce
  // script, `depot-cycle-add` reste un AddImage state="add" ordinaire.
  document.querySelectorAll<HTMLElement>('[data-add-image-cycle]').forEach((cycle) => {
    const ajout = cycle.querySelector<HTMLElement>('[data-cycle-add]');
    const champ = ajout?.querySelector<HTMLInputElement>('.add-image-input');
    const progression = cycle.querySelector<HTMLElement>('[data-cycle-progress]');
    const piste = progression?.querySelector<HTMLElement>('.add-image-progress-track');
    const valeur = progression?.querySelector<HTMLElement>('.add-image-progress-value');
    const echec = cycle.querySelector<HTMLElement>('[data-cycle-fail]');
    const reessayer = echec?.querySelector<HTMLButtonElement>('.btn');
    const succes = cycle.querySelector<HTMLElement>('[data-cycle-success]');
    const image = succes?.querySelector<HTMLImageElement>('.add-image-success-image');
    if (!ajout || !champ || !progression || !piste || !valeur || !echec || !reessayer || !succes || !image) {
      return;
    }

    const montrer = (cible: HTMLElement) => {
      [ajout, progression, echec, succes].forEach((el) => (el.hidden = el !== cible));
    };

    // Règle de démo assumée : les tentatives alternent plutôt que de dépendre
    // d'une vraie réponse serveur, qu'il n'y a pas ici.
    let tentative = 0;
    let objectUrl: string | undefined;

    const revokeObjectUrl = () => {
      if (!objectUrl) return;
      URL.revokeObjectURL(objectUrl);
      objectUrl = undefined;
    };
    champ.addEventListener('change', () => {
      const fichier = champ.files?.[0];
      if (!fichier) return;
      montrer(progression);
      let pourcent = 0;
      const minuteur = window.setInterval(() => {
        pourcent = Math.min(100, pourcent + 10);
        piste.style.setProperty('--add-image-progress', `${pourcent}%`);
        piste.setAttribute('aria-valuenow', String(pourcent));
        valeur.textContent = `${pourcent}%`;
        if (pourcent === 100) {
          window.clearInterval(minuteur);
          tentative += 1;
          if (tentative % 2 === 0) {
            montrer(echec);
          } else {
            revokeObjectUrl();
            objectUrl = URL.createObjectURL(fichier);
            image.src = objectUrl;
            image.alt = fichier.name;
            montrer(succes);
          }
        }
      }, 150);
    });

    reessayer.addEventListener('click', (evenement) => {
      evenement.preventDefault();
      champ.value = '';
      montrer(ajout);
    });
  });
</script>
