          <div class="morceau">
            <p class="etiquette">
              <span><span class="rang">2</span> Là où tu veux la carte</span>
              <button class="copier" type="button" data-copier="balise">Copier</button>
            </p>
            <pre><code data-code="balise">{defautCarte}</code></pre>
            <p class="aide" data-defauts></p>
          </div>
        </div>
      </div>

      <!-- La banque : les composants dont on clone les exemplaires posés dans les
           emplacements. Ils sont rendus par Astro au build comme tous les autres —
           c'est ce qui fait que ce qu'on voit dans la carte est vraiment un Tag et
           vraiment un Button, pas un dessin qui leur ressemble. -->
      <div class="banque" data-banque aria-hidden="true">
        {
          tagVariants.map((v) => (
            <span data-tag={v}>
              <Tag variant={v}>
