                )),
              )
            }
          </div>
          <p class="lecture" data-lecture></p>

          <div class="morceau">
            <p class="etiquette">
              <span><span class="rang">1</span> Tout en haut du fichier</span>
              <button class="copier" type="button" data-copier="entete">Copier</button>
            </p>
            <pre><code data-code="entete">{entete('Icon')}</code></pre>
