    <!-- ── Quand ça ne marche pas ───────────────────────────────────────── -->
    <section id="pannes">
      <h2>Quand ça ne marche pas</h2>
      <p class="section-note">
        Cinq pannes, dans l'ordre où on les rencontre. Chacune a un signe et un geste.
      </p>

      <div class="panne">
        <h3>La page est blanche, ou le composant s'affiche en toutes lettres</h3>
        <p>
          <strong>Le signe.</strong> Tu vois <code>&lt;Button&gt;</code> écrit tel quel dans la page, ou
          une erreur qui dit qu'il n'est pas défini.
        </p>
        <p>
          <strong>Le geste.</strong> La ligne d'<code>import</code> manque. Elle va tout en haut du fichier,
          <strong>entre les deux lignes de trois tirets</strong> — ce bloc s'appelle le frontmatter, et
          c'est le seul endroit où un import a le droit d'être.
        </p>
      </div>

      <div class="panne">
        <h3>Tout est là mais rien n'est stylé</h3>
        <p>
          <strong>Le signe.</strong> Les textes s'empilent en Times New Roman, le bouton n'est qu'un rectangle
          gris.
        </p>
        <p>
          <strong>Le geste.</strong> Les feuilles du système ne sont pas chargées. Si ta page passe par
          {' '}<code>BaseLayout</code>, elles arrivent toutes seules. Sinon, une fois pour tout le site :
        </p>
        <pre><code>{importStyles}</code></pre>
        <p class="aide">Dans cet ordre : le second se sert des variables du premier.</p>
      </div>

      <div class="panne">
        <h3>« Icon : “xxx” n'existe pas »</h3>
        <p>
          <strong>Le signe.</strong> Le build s'arrête, et l'erreur liste toutes les icônes disponibles.
        </p>
        <p>
          <strong>Le geste.</strong> Le nom n'est pas dans le registre — souvent une faute de frappe ou
          un tiret oublié. Recopie-le depuis <a href={withBase('/icons')}>Icônes</a>, ou depuis le menu
          déroulant de l'atelier ci-dessus. Pour en ajouter une, c'est un export Figma déposé dans
          {' '}<code>icons/</code> puis <code>npm run icons</code>.
        </p>
      </div>

      <div class="panne">
        <h3>Une prop que tu écris ne fait rien</h3>
        <p>
          <strong>Le signe.</strong> Aucune erreur, aucun effet. C'est la panne la plus coûteuse, parce
          qu'elle est muette.
        </p>
        <p>
          <strong>Le geste.</strong> <code>npm run build</code> ne vérifie pas les noms de props. C'est
          {' '}<code>npm run check</code> qui le fait, et qui te dira laquelle n'existe pas :
        </p>
        <pre><code>npm run check</code></pre>
        <p class="aide">À lancer avant de pousser, systématiquement.</p>
      </div>

      <div class="panne">
        <h3>Ce que tu mets dans une carte n'apparaît pas</h3>
        <p>
          <strong>Le signe.</strong> Aucune erreur, et les tags — ou les boutons — ont simplement
          disparu. La carte s'affiche, elle est juste vide à cet endroit.
        </p>
        <p>
          <strong>Le geste.</strong> Vérifie que le contenu est bien enveloppé dans son
          {' '}<code>Fragment</code>. La carte a deux emplacements <em>nommés</em> : ce qui n'annonce pas
          son nom n'atterrit nulle part, et Astro le laisse tomber sans rien dire.
        </p>
        <pre><code>{`<!-- ne s’affiche pas : le Tag ne dit pas où il va -->
<Card title="…">
  <Tag>Recherche utilisateur</Tag>
</Card>

<!-- s’affiche -->
<Card title="…">
  <Fragment slot="tags">
    <Tag>Recherche utilisateur</Tag>
  </Fragment>
</Card>`}</code></pre>
        <p class="aide">
          Le code de l'atelier Card l'écrit toujours correctement : en cas de doute, recopie-le
          plutôt que de l'écrire de mémoire.
        </p>
      </div>

      <div class="panne">
        <h3>Une image marche en local et donne un 404 en ligne</h3>
        <p>
          <strong>Le signe.</strong> Rien à voir en développement, et l'image manque une fois le site publié.
        </p>
        <p>
          <strong>Le geste.</strong> Le site est publié sous un préfixe. Tout chemin absolu — image, lien
          vers une page — passe par <code>withBase()</code> :
        </p>
        <pre><code>{importBase}</code></pre>
        <p class="aide">Les icônes échappent à cette règle : inlinées, elles n'ont pas d'URL.</p>
      </div>
    </section>
  </main>
</DocsLayout>

<script>
  // Toutes les combinaisons sont dans la page ; on n'en montre qu'une. Le code
  // affiché est reconstruit entièrement à chaque changement — jamais rapiécé par
  // morceaux, pour qu'il ne puisse pas mentir sur ce qui est à l'écran.

  const LARGEUR_MAX = 62;

  // Le code s'écrit comme on l'écrirait à la main : tout sur une ligne tant que
  // ça tient, et une prop par ligne au-delà. Une balise sans contenu se ferme
  // sur elle-même — c'est ce qu'attend un bouton qui n'a qu'une icône.
  function baliser(nom: string, attrs: string[], contenu: string | null) {
    const tete = `<${nom}${attrs.length ? ' ' + attrs.join(' ') : ''}`;
    const empilee = `<${nom}\n  ${attrs.join('\n  ')}\n`;

    if (contenu === null) {
      return tete.length + 3 > LARGEUR_MAX && attrs.length > 1 ? `${empilee}/>` : `${tete} />`;
    }

    const uneLigne = `${tete}>${contenu}</${nom}>`;
    if (uneLigne.length <= LARGEUR_MAX) return uneLigne;

    const ouvrante = tete.length > LARGEUR_MAX && attrs.length > 1 ? `${empilee}>` : `${tete}>`;
    return `${ouvrante}\n  ${contenu}\n</${nom}>`;
  }

  function montrer(apercu: Element, cle: string) {
    for (const el of apercu.querySelectorAll<HTMLElement>('.pv')) {
      el.classList.toggle('is-on', el.dataset.cle === cle);
    }
    return apercu.querySelector('.pv.is-on');
  }

  // Les champs qui ne concernent qu'un état : ils disparaissent quand il n'y est pas.
  function conditionner(form: HTMLFormElement) {
    for (const el of form.querySelectorAll<HTMLElement>('[data-si]')) {
      const nom = el.dataset.si as string;
      const radio = form.querySelector<HTMLInputElement>(`[name="${nom}"][type="radio"]`);
      const actif = el.dataset.sauf
        ? form.querySelector<HTMLInputElement>(`[name="${nom}"]:checked`)?.value !== el.dataset.sauf
        : radio
          ? Boolean(radio.checked)
          : Boolean(form.querySelector<HTMLInputElement>(`[name="${nom}"]`)?.checked);
      el.hidden = !actif;
    }
  }

  // Un atelier réécrit toujours le second morceau. Les trois ateliers de
  // composants s'arrêtent là — leur import ne dépend d'aucun réglage. Celui du
  // texte réécrit aussi le premier, qui est sa règle CSS.
  type Rendu = (d: FormData, apercu: Element) => string | { entete: string; balise: string };

  function brancher(atelier: Element, rendre: Rendu) {
    const form = atelier.querySelector<HTMLFormElement>('[data-form]');
    const apercu = atelier.querySelector('[data-apercu]');
    const balise = atelier.querySelector('[data-code="balise"]');
    const entete = atelier.querySelector('[data-code="entete"]');
    if (!form || !apercu || !balise) return;

    const tour = () => {
      conditionner(form);
      const r = rendre(new FormData(form), apercu);
      if (typeof r === 'string') {
        balise.textContent = r;
      } else {
        balise.textContent = r.balise;
        if (entete) entete.textContent = r.entete;
      }
    };

    form.addEventListener('input', tour);
    form.addEventListener('change', tour);
    form.addEventListener('submit', (e) => e.preventDefault());

    // Un bouton par morceau : chacun copie le bloc qu'il annonce.
    for (const copier of atelier.querySelectorAll<HTMLButtonElement>('[data-copier]')) {
      copier.addEventListener('click', async () => {
        const cible = atelier.querySelector(`[data-code="${copier.dataset.copier}"]`);
        try {
          await navigator.clipboard.writeText(cible?.textContent ?? '');
          copier.textContent = 'Copié';
        } catch {
          copier.textContent = 'Sélectionne-le et copie';
        }
        setTimeout(() => (copier.textContent = 'Copier'), 2000);
      });
    }

    tour();
  }

  // ── Un style de texte ──────────────────────────────────────────────────
  // Les sept recettes que global.css pose sur les balises. Elles ne sont pas
  // recopiées pour faire joli : c'est en s'y comparant que l'atelier peut dire
  // « tu n'as rien à écrire, c'est un h2 ». Si global.css change, ceci change.
  const BALISES = [
    { tag: 'h1', role: 'le titre de la page', famille: 'heading', graisse: 'bold', taille: 'display', interligne: 'snug', lettrage: 'normal', capitales: false },
    { tag: 'h2', role: 'un titre de section', famille: 'heading', graisse: 'bold', taille: 'title', interligne: 'tight', lettrage: 'tight', capitales: false },
    { tag: 'h3', role: 'un sous-titre', famille: 'heading', graisse: 'bold', taille: 'subtitle', interligne: 'tight', lettrage: 'tight', capitales: false },
    { tag: 'h4', role: 'un titre de bloc, ou de fenêtre', famille: 'heading', graisse: 'bold', taille: 'heading', interligne: 'tight', lettrage: 'tight', capitales: false },
    { tag: 'h5', role: 'un titre de rang mineur', famille: 'heading', graisse: 'bold', taille: 'subheading', interligne: 'tight', lettrage: 'tight', capitales: false },
    { tag: 'h6', role: "l'eyebrow, la ligne en capitales posée au-dessus d'un titre", famille: 'heading', graisse: 'bold', taille: 'body-sm', interligne: 'snug', lettrage: 'wider', capitales: true },
    { tag: 'p', role: 'un paragraphe', famille: 'body', graisse: 'regular', taille: 'body', interligne: 'body', lettrage: 'normal', capitales: false },
  ];

  const atelierTexte = document.querySelector('[data-atelier="texte"]');
  if (atelierTexte) {
    const vueTexte = atelierTexte.querySelector<HTMLElement>('[data-texte]');
    const trouvaille = atelierTexte.querySelector<HTMLElement>('[data-trouvaille]');
    const morceauCss = atelierTexte.querySelector<HTMLElement>('[data-morceau="css"]');
    const rang = atelierTexte.querySelector<HTMLElement>('[data-rang]');
    const fondNote = atelierTexte.querySelector<HTMLElement>('[data-fond-note]');
    const defauts = atelierTexte.querySelector<HTMLElement>('[data-defauts]');

    // La description du token choisi, affichée sous le réglage qui l'a choisi.
    const decrireChoix = (form: HTMLFormElement, nom: string) => {
      const cible = atelierTexte.querySelector<HTMLElement>(`[data-desc="${nom}"]`);
      if (!cible) return;
      const champ = form.elements.namedItem(nom);
      const source =
        champ instanceof HTMLSelectElement
          ? champ.selectedOptions[0]
          : form.querySelector<HTMLInputElement>(`[name="${nom}"]:checked`);
      cible.textContent = source instanceof HTMLElement ? (source.dataset.desc ?? '') : '';
    };

    // Un nom de classe se colle dans une feuille de style : il ne peut ni être
    // vide, ni contenir d'espace, ni commencer par un point.
    const nettoyerClasse = (brut: string) => {
      const propre = brut
        .trim()
        .replace(/^\.+/, '')
        .replace(/\s+/g, '-')
        .replace(/[^A-Za-z0-9_-]/g, '')
        .replace(/^-+|-+$/g, '');
      return propre === '' || /^[0-9-]/.test(propre) ? 'mon-style' : propre;
    };

    brancher(atelierTexte, (d, apercu) => {
      const form = atelierTexte.querySelector('[data-form]') as HTMLFormElement;
      const texte = String(d.get('texte') ?? '').trim() || 'Ton texte';
      const famille = String(d.get('famille'));
      const graisse = String(d.get('graisse'));
      const taille = String(d.get('taille'));
      const interligne = String(d.get('interligne'));
      const lettrage = String(d.get('lettrage'));
      const capitales = d.get('capitales') === 'on';
      const encre = String(d.get('encre'));
      const classe = nettoyerClasse(String(d.get('classe') ?? ''));

      decrireChoix(form, 'taille');
      decrireChoix(form, 'encre');

      // L'aperçu prend les mêmes var() que le code : il ne peut pas diverger.
      if (vueTexte) {
        vueTexte.textContent = texte;
        vueTexte.style.fontFamily = `var(--font-family-${famille})`;
        vueTexte.style.fontWeight = `var(--font-weight-${graisse})`;
        vueTexte.style.fontSize = `var(--font-size-${taille})`;
        vueTexte.style.lineHeight = `var(--font-line-height-${interligne})`;
        vueTexte.style.letterSpacing = `var(--font-letter-spacing-${lettrage})`;
        vueTexte.style.color = `var(--color-text-${encre})`;
        vueTexte.style.textTransform = capitales ? 'uppercase' : '';
      }

      // Trois encres réclament un panneau plein : l'aperçu le pose, et le dit,
      // parce que ce fond n'appartient pas au style de texte mais au bloc qui
      // le contient.
      const choixEncre = form.querySelector<HTMLInputElement>('[name="encre"]:checked');
      const fond = choixEncre?.dataset.fond ?? 'default';
      if (apercu instanceof HTMLElement) apercu.style.background = `var(--color-bg-${fond})`;
      if (fondNote) {
        fondNote.hidden = fond === 'default';
        fondNote.textContent =
          fond === 'default'
            ? ''
            : `Cette encre est faite pour un panneau plein : le fond ci-dessus est var(--color-bg-${fond}). Sur le blanc de la page, elle serait illisible — le fond est l'affaire du bloc qui contient le texte, pas du style de texte.`;
      }

      // La comparaison qui évite de réécrire ce que le système donne déjà.
      const jumelle = BALISES.find(
        (b) =>
          b.famille === famille &&
          b.graisse === graisse &&
          b.taille === taille &&
          b.interligne === interligne &&
          b.lettrage === lettrage &&
          b.capitales === capitales &&
          encre === 'default',
      );

      if (trouvaille) {
        trouvaille.hidden = !jumelle;
        trouvaille.textContent = jumelle
          ? `C'est exactement un <${jumelle.tag}> — ${jumelle.role}. Tu n'as aucun CSS à écrire : la balise porte déjà ce style.`
          : '';
      }
      if (morceauCss) morceauCss.hidden = Boolean(jumelle);
      if (rang) rang.textContent = jumelle ? '1' : '2';

      if (defauts) {
        defauts.textContent = jumelle
          ? "Si ce texte n'est pas vraiment ce rang dans le plan de la page, choisis la balise qui dit son rang et écris le CSS pour l'apparence : le rang sert à la navigation au clavier et aux lecteurs d'écran, pas au dessin."
          : "Si ce texte est un titre, pose la classe sur la balise de titre qui convient plutôt que sur un <p> — le rang compte, même quand l'apparence n'en dépend pas.";
      }

      const regle = [
        `.${classe} {`,
        `  font-family: var(--font-family-${famille});`,
        `  font-weight: var(--font-weight-${graisse});`,
        `  font-size: var(--font-size-${taille});`,
        `  line-height: var(--font-line-height-${interligne});`,
        `  letter-spacing: var(--font-letter-spacing-${lettrage});`,
        capitales ? '  text-transform: uppercase;' : '',
        `  color: var(--color-text-${encre});`,
        '}',
      ]
        .filter((l) => l !== '')
        .join('\n');

      return {
        entete: regle,
        balise: jumelle
          ? `<${jumelle.tag}>${texte}</${jumelle.tag}>`
          : `<p class="${classe}">${texte}</p>`,
      };
    });
  }

  // ── Button ─────────────────────────────────────────────────────────────
  const atelierBouton = document.querySelector('[data-atelier="button"]');
  if (atelierBouton) {
    const banque = atelierBouton.querySelector('[data-banque]');
    const alerte = atelierBouton.querySelector<HTMLElement>('[data-alerte]');
    const defauts = atelierBouton.querySelector<HTMLElement>('[data-defauts]');

    const icone = (nom: string) => {
      const svg = banque?.querySelector(`[data-icone="${nom}"] svg`);
      return svg ? [svg.cloneNode(true)] : [];
    };

    brancher(atelierBouton, (d, apercu) => {
      const variant = String(d.get('variant'));
      const size = String(d.get('size'));
      const place = String(d.get('place'));
      const nomIcone = String(d.get('icon'));
      const label = String(d.get('label') ?? '').trim();
      const lien = d.get('lien') === 'on';

      const vue = montrer(apercu, `${variant}|${size}|${lien ? 'a' : 'b'}`);
      const btn = vue?.querySelector<HTMLElement>('.btn');
      const debut = vue?.querySelector('.fente-debut');
      const fin = vue?.querySelector('.fente-fin');
      const texte = vue?.querySelector('.fente-label');

      debut?.replaceChildren(...(place === 'start' || place === 'both' ? icone(nomIcone) : []));
      fin?.replaceChildren(...(place === 'end' || place === 'both' ? icone(nomIcone) : []));
      if (texte) texte.textContent = label;

      // Sans libellé, la largeur minimale de la taille ferait flotter l'icône
      // au milieu d'un vide : le bouton la perd, comme le fera le code copié.
      const iconeSeule = label === '' && place !== 'none';
      btn?.style.setProperty('--btn-min-w', iconeSeule ? '0' : '');

      if (alerte) {
        alerte.hidden = !(label === '' && place === 'none');
        alerte.textContent = "Sans libellé ni icône, le bouton n'affiche rien.";
      }

      const attrs: string[] = [];
      const omis: string[] = [];
      if (variant !== 'primary') attrs.push(`variant="${variant}"`);
      else omis.push('variant="primary"');
      if (size !== 'md') attrs.push(`size="${size}"`);
      else omis.push('size="md"');
      if (place === 'start' || place === 'both') attrs.push(`icon="${nomIcone}"`);
      if (place === 'end' || place === 'both') attrs.push(`iconEnd="${nomIcone}"`);
      if (lien) attrs.push('href="/projets"');
      if (iconeSeule) {
        attrs.push('aria-label="Dis ici ce que fait le bouton"');
        attrs.push('style="--btn-min-w: 0"');
      }

      if (defauts) {
        defauts.textContent = iconeSeule
          ? "Sans libellé, deux choses s'ajoutent toutes seules : aria-label, sans quoi un lecteur d'écran ne dit que « bouton » — et --btn-min-w: 0, sans quoi la largeur minimale de la taille ferait flotter l'icône dans le vide."
          : omis.length
            ? `Ce qui est déjà le défaut ne s'écrit pas : ${omis.join(' et ')}.`
            : '';
      }

      return baliser('Button', attrs, label === '' ? null : label);
    });
  }

  // ── Tag ────────────────────────────────────────────────────────────────
  const atelierTag = document.querySelector('[data-atelier="tag"]');
  if (atelierTag) {
    const defauts = atelierTag.querySelector<HTMLElement>('[data-defauts]');

    brancher(atelierTag, (d, apercu) => {
      const variant = String(d.get('variant'));
      const label = String(d.get('label') ?? '').trim();

      const vue = montrer(apercu, variant);
      const texte = vue?.querySelector('.fente-label');
      if (texte) texte.textContent = label;

      if (defauts) {
        defauts.textContent =
          variant === 'outline'
            ? 'Ce qui est déjà le défaut ne s’écrit pas : variant="outline".'
            : '';
      }

      return baliser('Tag', variant === 'outline' ? [] : [`variant="${variant}"`], label);
    });
  }

  // ── Icon ───────────────────────────────────────────────────────────────
  const atelierIcone = document.querySelector('[data-atelier="icon"]');
  if (atelierIcone) {
    const lecture = atelierIcone.querySelector<HTMLElement>('[data-lecture]');

    brancher(atelierIcone, (d, apercu) => {
      const nom = String(d.get('icon'));
      const size = String(d.get('size'));
      const seule = d.get('seule') === 'on';
      const label = String(d.get('label') ?? '').trim();

      montrer(apercu, `${nom}|${size}`);

      const attrs = [`name="${nom}"`, `size="${size}"`];
      if (seule && label) attrs.push(`label="${label}"`);

      if (lecture) {
        lecture.textContent =
          seule && label
            ? `Un lecteur d'écran annoncera : « ${label} ».`
            : "Un lecteur d'écran passera dessus sans rien dire — c'est ce qu'on veut quand un mot est déjà écrit à côté.";
      }

      return baliser('Icon', attrs, null);
    });
  }

  // ── Card ───────────────────────────────────────────────────────────────
  // Le premier atelier où l'on compose. Deux populations d'éléments s'y
  // croisent, et elles n'ont pas les mêmes règles :
  //
  // Ce qui est DANS la carte est cloné de la banque — donc un vrai Tag, un vrai
  // Button, rendus par Astro au build. C'est la règle de la page, et elle vaut
  // ici plus qu'ailleurs : une carte qui montrerait des pilules dessinées en CSS
  // mentirait sur le composant qu'on est en train d'apprendre à remplir.
  //
  // Les RANGÉES DE RÉGLAGE, elles, sont fabriquées par le script. Ce ne sont pas
  // des composants du système mais des champs de formulaire : rien n'oblige à
  // les rendre à l'avance, et leur nombre n'est pas connu au build. Leur modèle
  // est quand même un <template> rendu par Astro, pour que la liste des
  // variantes et celle des icônes viennent du système et non d'une copie.
  const atelierCarte = document.querySelector('[data-atelier="card"]');
  if (atelierCarte) {
    const banque = atelierCarte.querySelector('[data-banque]');
    const form = atelierCarte.querySelector<HTMLFormElement>('[data-form]');
    const defauts = atelierCarte.querySelector<HTMLElement>('[data-defauts]');
    const alerte = atelierCarte.querySelector<HTMLElement>('[data-alerte]');

    // Trois emplacements, et le script ne les nomme qu'ici : tout le reste se
    // déduit de la clé — `data-liste`, `data-modele`, `data-ajouter`,
    // `data-vide`, `.fente-*` et le nom du slot dans le code produit. Ajouter un
    // emplacement, c'est ajouter une ligne à MOTS et son fieldset au-dessus.
    const MOTS = {
      'tags-top': { de: 'du tag du haut', le: 'le tag du haut' },
      tags: { de: 'du tag', le: 'le tag' },
      actions: { de: "de l'action", le: "l'action" },
    } as const;
    type Quoi = keyof typeof MOTS;
    const QUOI: Quoi[] = ['tags-top', 'tags', 'actions'];

    // Les trois zones de chaque aperçu, relevées une fois avant que le script ne
    // les vide. On remonte depuis le repère posé dans le slot plutôt que de
    // viser le nom de classe interne de la carte : ce nom appartient au
    // composant, il peut changer sans que cette page le sache.
    const zones = new Map<Element, Partial<Record<Quoi, HTMLElement>>>();
    for (const pv of atelierCarte.querySelectorAll('.pv')) {
      const z: Partial<Record<Quoi, HTMLElement>> = {};
      for (const quoi of QUOI) {
        const repere = pv.querySelector(`.fente-${quoi}`);
        const zone = repere?.parentElement;
        if (zone) {
          zone.replaceChildren();
          z[quoi] = zone;
        }
      }
      zones.set(pv, z);
    }

    // ── Les rangées : ajouter, éditer, supprimer ──
    const liste = (quoi: Quoi) => atelierCarte.querySelector(`[data-liste="${quoi}"]`);
    const rangs = (quoi: Quoi) =>
      [...atelierCarte.querySelectorAll<HTMLElement>(`[data-liste="${quoi}"] .rang-slot`)];

    // Chaque rangée porte son rang dans son nom accessible. Sans ça, une liste
    // de trois croix s'annonce trois fois « Supprimer » et rien ne les
    // distingue au clavier (WCAG 2.4.6). Le rang se refait à chaque ajout et à
    // chaque retrait, sinon il ment dès la deuxième suppression.
    const numeroter = () => {
      for (const quoi of QUOI) {
        rangs(quoi).forEach((r, i) => {
          const n = i + 1;
          const nommer = (sel: string, texte: string) =>
            r.querySelector(sel)?.setAttribute('aria-label', texte);
          nommer('.rang-texte', `Texte ${MOTS[quoi].de} ${n}`);
          nommer('.rang-variant', `Variante ${MOTS[quoi].de} ${n}`);
          nommer('.rang-icone', `Icône ${MOTS[quoi].de} ${n}`);
          nommer('.retirer', `Supprimer ${MOTS[quoi].le} ${n}`);
        });
      }
    };

    // Le formulaire se réécoute lui-même : ajouter ou retirer une rangée n'est
    // pas une saisie, donc rien ne se déclencherait sans ça.
    const rafraichir = () => form?.dispatchEvent(new Event('input', { bubbles: true }));

    const ajouter = (quoi: Quoi) => {
      const modele = atelierCarte.querySelector<HTMLTemplateElement>(`[data-modele="${quoi}"]`);
      const ou = liste(quoi);
      if (!modele || !ou) return;
      ou.append(modele.content.cloneNode(true));
    };

    for (const bouton of atelierCarte.querySelectorAll<HTMLButtonElement>('[data-ajouter]')) {
      bouton.addEventListener('click', () => {
        const quoi = bouton.dataset.ajouter as Quoi;
        ajouter(quoi);
        numeroter();
        rafraichir();
        // Le focus va sur le champ qu'on vient de créer : c'est ce qu'on veut
        // écrire tout de suite, et au clavier il serait autrement à retrouver.
        rangs(quoi).at(-1)?.querySelector<HTMLInputElement>('.rang-texte')?.focus();
      });
    }

    atelierCarte.addEventListener('click', (e) => {
      const croix = (e.target as HTMLElement).closest('.retirer');
      if (!croix) return;
      const rangee = croix.closest('.rang-slot');
      const dans = rangee?.parentElement as HTMLElement | null;
      const quoi = dans?.dataset.liste as Quoi | undefined;
      rangee?.remove();
      numeroter();
      rafraichir();
      // Le focus disparaîtrait avec le bouton qui le portait, et repartirait en
      // haut du document. Il se pose sur la rangée suivante, ou à défaut sur
      // « Ajouter » (WCAG 2.4.3).
      if (!quoi) return;
      const suite = rangs(quoi)[0];
      const cible =
        suite?.querySelector<HTMLElement>('.retirer') ??
        atelierCarte.querySelector<HTMLElement>(`[data-ajouter="${quoi}"]`);
      cible?.focus();
    });

    const lire = (quoi: Quoi) =>
      rangs(quoi).map((r) => ({
        texte: (r.querySelector('.rang-texte') as HTMLInputElement | null)?.value.trim() ?? '',
        variant: (r.querySelector('.rang-variant') as HTMLSelectElement | null)?.value ?? '',
        icone: (r.querySelector('.rang-icone') as HTMLSelectElement | null)?.value ?? '',
      }));

    // ── Les exemplaires clonés de la banque ──
    const exemplaire = (selecteur: string) => {
      const src = banque?.querySelector(selecteur)?.firstElementChild;
      return src ? (src.cloneNode(true) as HTMLElement) : null;
    };

    const poserTag = (t: { texte: string; variant: string }) => {
      const el = exemplaire(`[data-tag="${t.variant}"]`);
      const fente = el?.querySelector('.fente-label');
      if (fente) fente.textContent = t.texte;
      return el;
    };

    const poserAction = (a: { texte: string; variant: string; icone: string }) => {
      const el = exemplaire(`[data-action="${a.variant}"]`);
      const label = el?.querySelector('.fente-label');
      const fin = el?.querySelector('.fente-fin');
      if (label) label.textContent = a.texte;
      const svg = a.icone ? banque?.querySelector(`[data-icone="${a.icone}"] svg`) : null;
      fin?.replaceChildren(...(svg ? [svg.cloneNode(true)] : []));
      // Même règle que dans l'atelier Button : sans libellé, la largeur minimale
      // ferait flotter l'icône au milieu d'un vide.
      if (a.texte === '' && a.icone) el?.style.setProperty('--btn-min-w', '0');
      return el;
    };

    // Une valeur libre part dans un attribut : un guillemet droit tapé dans le
    // titre fermerait l'attribut et casserait le code copié.
    const attr = (v: string) => v.replace(/"/g, '&quot;');

    const IMAGE =
      "image={{ src: withBase('/images/projet.jpg'), alt: 'Décris ce qu’on voit', width: 822, height: 382 }}";

    ajouter('tags-top');
    ajouter('tags');
    ajouter('actions');
    numeroter();

    brancher(atelierCarte, (d, apercu) => {
      const orientation = String(d.get('orientation'));
      const titleSize = String(d.get('titleSize'));
      const title = String(d.get('title') ?? '').trim();
      const subtitle = String(d.get('subtitle') ?? '').trim();
      const meta = String(d.get('meta') ?? '').trim();
      const avecImage = d.get('image') === 'on';

      const montre = {
        'tags-top': d.get('tags-top') === 'on',
        tags: d.get('tags') === 'on',
        actions: d.get('actions') === 'on',
      } as Record<Quoi, boolean>;
      const tagsTop = montre['tags-top'] ? lire('tags-top') : [];
      const tags = montre.tags ? lire('tags') : [];
      const actions = montre.actions ? lire('actions') : [];

      // Deux réglages décident maintenant de l'exemplaire montré, donc la clé en
      // porte deux. Les quatre cartes sont rendues par Astro au build comme
      // avant : ce qu'on voit reste le composant, pas une classe posée après
      // coup sur un exemplaire unique.
      const vue = montrer(apercu, `${orientation}|${titleSize}`);

      // Les trois lignes de texte et l'image : vides ou décochées, elles sortent
      // de la mise en page au lieu d'y laisser une place. C'est ce que fait
      // vraiment le composant — il ne rend pas la balise du tout — et c'est
      // pour ça que ce n'est pas une simple mise en transparent.
      const ligne = (sel: string, texte: string) => {
        const el = vue?.querySelector<HTMLElement>(sel);
        if (!el) return;
        el.textContent = texte;
        el.style.display = texte ? '' : 'none';
      };
      ligne('.title', title);
      ligne('.subtitle', subtitle);
      ligne('.meta', meta);

      const img = vue?.querySelector<HTMLElement>('img');
      if (img) img.style.display = avecImage ? '' : 'none';

      // Une zone se cache en `display: none` et non en `hidden` : la carte pose
      // `display: flex` sur ses rangées, ce qui l'emporterait sur l'attribut.
      const z = vue ? zones.get(vue) : undefined;
      const remplir = (quoi: Quoi, enfants: (HTMLElement | null)[]) => {
        const zone = z?.[quoi];
        if (!zone) return;
        zone.replaceChildren(...enfants.filter((e): e is HTMLElement => Boolean(e)));
        zone.style.display = enfants.length ? '' : 'none';
      };
      remplir('tags-top', tagsTop.map(poserTag));
      remplir('tags', tags.map(poserTag));
      remplir('actions', actions.map(poserAction));

      // Un emplacement affiché mais vide n'est pas une rangée vide : Astro ne le
      // rend pas du tout. Le dire ici évite de chercher pourquoi « rien ne se
      // passe » quand on coche sans rien ajouter.
      const combien = {
        'tags-top': tagsTop.length,
        tags: tags.length,
        actions: actions.length,
      } as Record<Quoi, number>;

      for (const quoi of QUOI) {
        const note = atelierCarte.querySelector<HTMLElement>(`[data-vide="${quoi}"]`);
        const n = combien[quoi];
        if (note) {
          note.textContent =
            montre[quoi] && n === 0
              ? "Affiché mais vide : la rangée ne sera pas rendue du tout — c'est la même chose que de le décocher."
              : '';
        }
      }

      if (alerte) {
        alerte.hidden = title !== '';
        alerte.textContent = "Sans titre, la carte n'annonce plus rien : c'est la seule prop qu'elle exige.";
      }

      // ── Le code ──
      const attrs: string[] = [];
      const omis: string[] = [];
      if (orientation !== 'vertical') attrs.push(`orientation="${orientation}"`);
      else omis.push('orientation="vertical"');
      if (titleSize !== 'title') attrs.push(`titleSize="${titleSize}"`);
      else omis.push('titleSize="title"');
      attrs.push(`title="${attr(title)}"`);
      if (subtitle) attrs.push(`subtitle="${attr(subtitle)}"`);
      if (meta) attrs.push(`meta="${attr(meta)}"`);
      if (avecImage) attrs.push(IMAGE);

      const enfants: string[] = [];

      // Les deux rangées de tags produisent le même bloc à un nom près : c'est la
      // meilleure preuve qu'elles sont un seul emplacement dédoublé, et pas deux
      // objets. La ligne vide ne se pose qu'entre deux blocs — un Fragment en
      // tête de carte ne s'annonce pas par un blanc.
      const blocTags = (nom: string, liste: ReturnType<typeof lire>) => {
        if (!liste.length) return;
        if (enfants.length) enfants.push('');
        enfants.push(`<Fragment slot="${nom}">`);
        for (const t of liste) {
          const a = t.variant === 'outline' ? [] : [`variant="${t.variant}"`];
          enfants.push('  ' + baliser('Tag', a, attr(t.texte)));
        }
        enfants.push('</Fragment>');
      };

      blocTags('tags-top', tagsTop);
      blocTags('tags', tags);

      if (actions.length) {
        if (enfants.length) enfants.push('');
        enfants.push('<Fragment slot="actions">');
        for (const a of actions) {
          const at: string[] = [];
          if (a.variant !== 'primary') at.push(`variant="${a.variant}"`);
          at.push('size="sm"');
          if (a.icone) at.push(`iconEnd="${a.icone}"`);
          if (a.texte === '' && a.icone) {
            at.push('aria-label="Dis ici ce que fait le bouton"');
            at.push('style="--btn-min-w: 0"');
          }
          const balise = baliser('Button', at, a.texte === '' ? null : attr(a.texte));
          enfants.push('  ' + balise.split('\n').join('\n  '));
        }
        enfants.push('</Fragment>');
      }

      // L'en-tête de la carte est le seul de la page à bouger : il importe ce
      // qu'on a mis dans les emplacements, et withBase seulement s'il y a une
      // image à préfixer.
      const imports = ['Card'];
      if (tagsTop.length || tags.length) imports.push('Tag');
      if (actions.length) imports.push('Button');
      const lignes = imports.map((n) => `import ${n} from 'ux-design-system/components/${n}.astro';`);
      if (avecImage) lignes.push(`import { withBase } from 'ux-design-system/lib/url';`);

      if (defauts) {
        defauts.textContent = omis.length
          ? `Ce qui est déjà le défaut ne s'écrit pas : ${omis.join(' et ')}.`
          : '';
      }

      // Un enfant peut tenir sur plusieurs lignes — un bouton à trois props se
      // range en colonne. Il faut donc décaler chacune de ses lignes, et pas
      // seulement la première : sinon les props du bouton se retrouvent au même
      // cran que sa balise, et le code copié est juste mais illisible.
      const decaler = (bloc: string) =>
        bloc
          .split('\n')
          .map((l) => (l ? '  ' + l : ''))
          .join('\n');

      return {
        entete: `---\n${lignes.join('\n')}\n---`,
        balise: enfants.length
          ? `<Card\n  ${attrs.join('\n  ')}\n>\n${enfants.map(decaler).join('\n')}\n</Card>`
          : baliser('Card', attrs, null),
      };
    });
  }

  // ── Modal ──────────────────────────────────────────────────────────────
  // La variante change la couleur du bouton principal (primary ou alert) ET
  // le nombre de boutons (succes n'en a qu'un, structurellement — pas de
  // second <button> du tout dans son DOM). Une classe scopée d'Astro ne se
  // rejoue pas après coup, donc les trois Modal sont entièrement pré-rendues,
  // une par variante, comme les dix-huit Button plus haut. Le script ne fait
  // que choisir laquelle montrer, puis y récrit l'icône et les mots.
  const atelierModal = document.querySelector('[data-atelier="modal"]');
  if (atelierModal) {
    const banque = atelierModal.querySelector('[data-banque]');
    const defauts = atelierModal.querySelector<HTMLElement>('[data-defauts]');

    const icone = (nom: string) => {
      const svg = banque?.querySelector(`[data-icone="${nom}"] svg`);
      return svg ? [svg.cloneNode(true)] : [];
    };

    // Même règle que dans l'atelier Card : une valeur libre part dans un
    // attribut, et un guillemet droit tapé dans le titre le fermerait.
    const attr = (v: string) => v.replace(/"/g, '&quot;');

    brancher(atelierModal, (d, apercu) => {
      const variant = String(d.get('variant'));
      const nomIcone = String(d.get('icon'));
      const heading = String(d.get('heading') ?? '').trim();
      const body = String(d.get('body') ?? '').trim();
      const primaire = String(d.get('primary') ?? '').trim();
      // succes n'a pas ce bouton, quoi que le champ contienne — le champ se
      // masque déjà pour cette variante, mais sa valeur reste dans le
      // formulaire tant qu'on ne l'a pas vidé à la main.
      const secondaire = variant === 'succes' ? '' : String(d.get('secondary') ?? '').trim();

      const vue = montrer(apercu, variant);

      vue?.querySelector('.icon-frame')?.replaceChildren(...icone(nomIcone));

      const titre = vue?.querySelector<HTMLElement>('.heading');
      if (titre) titre.textContent = heading;
      const texte = vue?.querySelector<HTMLElement>('.body');
      if (texte) texte.textContent = body;

      // Les deux boutons sont dans l'ordre du markup — le principal d'abord,
      // le secondaire ensuite — et rien ne les distingue autrement dans le
      // DOM rendu : ni l'un ni l'autre n'a de classe qui dise son rôle. Sur
      // l'exemplaire succes, il n'y a tout simplement pas de second bouton :
      // btnSecondaire vaut undefined, et la ligne suivante ne fait rien.
      const [btnPrimaire, btnSecondaire] = [
        ...(vue?.querySelectorAll<HTMLElement>('.actions .btn') ?? []),
      ];
      if (btnPrimaire) btnPrimaire.textContent = primaire;
      if (btnSecondaire) {
        btnSecondaire.textContent = secondaire;
        // Vide, le bouton disparaît — comme le fera vraiment le composant :
        // sans secondary, Modal ne le rend pas du tout.
        btnSecondaire.style.display = secondaire ? '' : 'none';
      }

      const attrs = [
        'id="ma-modale"',
        `icon="${nomIcone}"`,
        variant !== 'validation' ? `variant="${variant}"` : '',
        `heading="${attr(heading)}"`,
        `body="${attr(body)}"`,
        `primary={{ label: "${attr(primaire)}" }}`,
        secondaire ? `secondary={{ label: "${attr(secondaire)}" }}` : '',
      ].filter(Boolean);

      if (defauts) {
        defauts.textContent =
          variant === 'validation'
            ? 'Ce qui est déjà le défaut ne s’écrit pas : variant="validation".'
            : '';
      }

      return baliser('Modal', attrs, null);
    });
  }
</script>

