---
// Doc des composants du système. Chaque section montre le composant en vrai —
// jamais une copie de son markup : si le composant change, la page change.
import { withBase } from '../design-system/lib/url';
import DocsLayout from '../design-system/layouts/DocsLayout.astro';
import Button from '../design-system/components/Button.astro';
import Tag from '../design-system/components/Tag.astro';
import Nav from '../design-system/components/Nav.astro';
import Carousel from '../design-system/components/Carousel.astro';
import CaseStudyHeader from '../design-system/components/CaseStudyHeader.astro';
import CaseStudyCard from '../design-system/components/CaseStudyCard.astro';
import Intro from '../design-system/components/Intro.astro';
import CaseStudyList from '../design-system/components/CaseStudyList.astro';
import tokens from '../design-system/data/tokens.json';
// Les données de démonstration vivent à part : /templates/home montre les mêmes.
import {
  demoLinks,
  demoAction,
  caseStudyImages,
  caseStudyDemo,
  caseStudies,
  introDemo,
} from './_demo';

const buttonTokens = tokens.filter((t) => t.group === 'button');
const buttonSizes = ['sm', 'md', 'lg'] as const;

// Les props sont recopiées des interface Props des composants. Une seule
// définition existe dans le projet : celle du composant.
const buttonProps = [
  ['variant', `'primary' | 'secondary'`, 'primary', 'Primary porte l’action principale ; une seule par vue.'],
  ['size', `'sm' | 'md' | 'lg'`, 'md', 'Les trois hauteurs des tokens button.height.*.'],
  ['href', 'string', '—', 'Avec href, rend un <a> ; sans, un <button>.'],
  ['icon', 'IconName', '—', 'Nom d’une icône du système. Posée avant le label.'],
  ['type', `'button' | 'submit'`, 'button', 'Ignoré quand href est fourni.'],
  ['class', 'string', '—', 'Classe supplémentaire pour la mise en page de l’appelant.'],
];

const navProps = [
  ['links', '{ href, label, icon? }[]', '—', 'Les items. Le composant ne les connaît pas d’avance.'],
  ['current', 'string', '—', 'Chemin courant. Aucun item actif s’il ne correspond à aucun href.'],
  ['home', '{ href, src, alt }', '—', 'Le bouton avatar. Absent ⇒ non rendu : c’est l’état d’accueil.'],
  ['action', '{ label, icon?, href? }', '—', 'Le sixième bouton. Sans href ⇒ <button> inerte.'],
  ['label', 'string', 'Navigation principale', 'aria-label du <nav>.'],
];

const tagProps = [
  ['class', 'string', '—', 'Classe supplémentaire pour la mise en page de l’appelant.'],
];

const caseStudyCardProps = [
  ['eyebrow', 'string', '—', 'L’année et le client. Mis en capitales par le CSS.'],
  ['title', 'string', '—', 'Le titre de l’étude de cas.'],
  ['impact', 'string', '—', 'La phrase d’impact, sous le titre.'],
  ['tags', 'string[]', '[]', 'Les méthodes. Vide ⇒ la rangée n’est pas rendue.'],
  ['action', '{ label, href? }', '—', 'Le lien vers l’étude. Sans href ⇒ <button> inerte.'],
  ['images', '{ src, alt, width, height }[]', '[]', 'Les vignettes. Vide ⇒ pas de carrousel.'],
  ['imagesLabel', 'string', 'Images — {title}', 'Nom accessible de la piste.'],
  [
    'headingLevel',
    '2 | 3 | 4 | 5',
    '2',
    'Le rang du titre, sous ce que la page porte déjà. Il ne change pas le dessin : la taille vient du composant.',
  ],
  ['class', 'string', '—', 'Classe supplémentaire pour la mise en page de l’appelant.'],
];

const carouselProps = [
  [
    'items',
    '{ src, alt, width, height }[]',
    '—',
    'width et height donnent le rapport de la boîte, pas la taille du fichier : c’est le cadrage voulu, l’image le remplit en cover.',
  ],
  ['label', 'string', 'Images du projet', 'Nom accessible de la piste.'],
  ['class', 'string', '—', 'Classe supplémentaire pour la mise en page de l’appelant.'],
];

const introProps = [
  ['avatar', '{ src, alt }', '—', 'Le visage. src passe par le withBase() du site : c’est son asset.'],
  ['greeting', 'string', '—', 'La salutation, au-dessus du titre.'],
  ['headline', 'string', '—', 'La phrase qui dit ce qu’on fait.'],
  ['description', 'string', '—', 'La phrase sous le titre. Absente ⇒ non rendue.'],
  ['action', '{ label, href? }', '—', 'La suite. Sans href ⇒ <button> inerte.'],
  [
    'headingLevel',
    '1 | 2',
    '1',
    'Le rang du titre. 1 sur une page qui n’a pas d’autre titre. Il ne change pas le dessin : la taille vient du composant.',
  ],
  ['class', 'string', '—', 'Classe supplémentaire pour la mise en page de l’appelant.'],
];

const caseStudyListProps = [
  [
    'items',
    '{ eyebrow, title, impact?, tags?, action?, images?, imagesLabel? }[]',
    '—',
    'Les études de cas. Ajouter une carte, c’est ajouter un objet.',
  ],
  ['id', 'string', '—', 'La cible d’ancre : c’est par elle qu’arrivent « Projets » et le bouton de l’intro.'],
  ['label', 'string', 'Études de cas', 'Nom accessible de la section.'],
  [
    'covers',
    'string',
    '—',
    'L’id du bloc que la première carte recouvre — le premier écran de la page. Il devient inert quand elle est en place.',
  ],
  [
    'headingLevel',
    '2 | 3 | 4 | 5',
    '2',
    'Le rang des titres de carte, sous ce que la page porte déjà. Il ne change pas le dessin.',
  ],
  ['class', 'string', '—', 'Classe supplémentaire pour la mise en page de l’appelant.'],
];

// Les deux variables CSS que la pile lit sans les déclarer : c'est par elles que
// la page règle sa géométrie, et c'est tout ce qu'elle a à savoir.
const caseStudyListVars = [
  [
    '--fold-peek',
    '50px',
    'Le liseré de carte qui dépasse sous le bas de l’écran, et le chevauchement entre deux cartes — c’est le même nombre. À déclarer une fois sur la page.',
  ],
  [
    '--layer-height',
    '100svh',
    'La hauteur d’une couche. Ne se change que pour montrer la pile en réduction, comme ci-dessus.',
  ],
];

---

<DocsLayout
  title="Composants — UX design system"
  description="Les composants du système : Button, Tag, Nav, la carte d'étude de cas et leur pile, avec leur doctrine, leurs états et leurs props."
>
  <header class="page-head">
    <h6>Design system</h6>
    <h1>Composants</h1>
    <p class="lead">
      Deux primitives — Button et Tag — et les objets qui les composent : le Nav, la carte d'étude
      de cas avec son en-tête et son carrousel, l'intro d'une page d'accueil, et la pile qui empile
      les études de cas. Tous construits uniquement à partir des tokens. Ce qui est montré ici est
      rendu par les composants eux-mêmes — pas par une copie de leur markup. La doctrine d'usage
      vient des descriptions Figma : c'est elle qui porte les interdits.
    </p>
  </header>

  <main>
    <!-- ── Button ───────────────────────────────────────────────────────── -->
    <section>
      <h2>Button</h2>

      <p class="section-note">
        <strong>Ce qu'il est.</strong> La chose sur laquelle on clique. Dans une maquette, un vrai contrôle
        ; dans un document ou sur une slide, la représentation d'une action.
        <br />
        <strong>Ce qu'il n'est pas.</strong> Ni une étiquette — une pilule qui ne fait rien est un
        <em>Tag</em> — ni un objet qu'on répète : deux boutons primaires dans une vue, et aucun des deux
        n'est principal. Pour naviguer à l'intérieur du Nav, c'est un lien qu'il faut, pas un bouton.
        <br />
        <span class="source">Description du composant Figma <code>21:47</code>.</span>
      </p>

      <div class="demo">
        <div class="btn-row">
          {
            buttonSizes.map((size) => (
              <Button size={size} icon="mail-edit">
                Bouton {size}
              </Button>
            ))
          }
        </div>

        <div class="btn-row last">
          {buttonSizes.map((size) => <Button variant="secondary" size={size}>Secondaire {size}</Button>)}
        </div>
      </div>

      <p class="section-note">
        L'écart entre deux boutons est <code>--button-target-spacing</code> (WCAG 2.5.8). Tabulez pour
        voir l'anneau de focus, et survolez pour voir le fond changer en
        <code>--motion-duration-quick</code>.
      </p>

      <h3>Props</h3>
      <div class="table-scroll">
        <table>
          <thead>
            <tr><th>Prop</th><th>Type</th><th>Défaut</th><th>Rôle</th></tr>
          </thead>
          <tbody>
            {
              buttonProps.map(([nom, type, defaut, role]) => (
                <tr>
                  <td><code>{nom}</code></td>
                  <td><code>{type}</code></td>
                  <td>{defaut}</td>
                  <td>{role}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="section-note">
        Chaque taille pose ses variables locales (<code>--btn-h</code>, <code>--btn-px</code>,
        <code>--btn-gap</code>, <code>--btn-icon</code>, <code>--btn-min-w</code>) et chaque variante
        ses trois fonds (<code>--btn-bg</code>, <code>--btn-bg-hover</code>,
        <code>--btn-bg-active</code>) : un appelant peut en surcharger un ponctuellement via
        <code>style</code> plutôt que d'inventer une taille ou une variante de plus. C'est ce que fait
        le Nav pour son bouton d'action, que Figma compose en hauteur lg avec le padding horizontal md
        — et le Carousel pour ses flèches, que Figma pose sur <code>color.bg.default</code> et non sur
        la surface lavande du secondaire.
      </p>

      <p class="section-note">
        <strong>L'icône prend la couleur du bouton</strong>, parce qu'elle est inlinée et ne connaît que
        <code>currentColor</code>. <code>icon</code> et <code>iconEnd</code> attendent un nom du registre,
        pas un chemin : la même flèche sert au primaire et au secondaire. Le jeu complet est sur
        <a href={withBase('/icons')}>Icônes</a>.
      </p>

      <p class="flag">
        <strong>Écart à arbitrer côté Figma.</strong> Les trois familles <code>height</code>,
        <code>padding-y</code> et <code>icon-size</code> sont sur-déterminées et ne s'accordent pas : en
        taille md, <code>16 + 24 + 16 = 56 px</code> alors que <code>--button-height-md</code> vaut 48.
        Seule la taille sm est cohérente. Ici la hauteur prime — c'est la dimension que les descriptions
        rattachent à WCAG 2.5.5 — et le padding vertical n'est pas appliqué.
      </p>

      <p class="flag">
        <strong>Ce que Figma déclare et que le code n'a pas.</strong> Le composant Figma porte quatre
        variantes (<code>Primary</code>, <code>Secondary</code>, <code>Ghost</code>, <code>CTA</code>) et
        quatre états (<code>Default</code>, <code>Hover</code>, <code>Pressed</code>,
        <code>Disabled</code>). Le code implémente deux variantes et les quatre états : ni
        <code>Ghost</code> ni <code>CTA</code>. À intégrer le jour où une vue en a besoin — pas avant.
        L'état désactivé, lui, est arrivé avec les flèches du carrousel : Figma ne change ni le fond ni
        la bordure, il baisse l'opacité de tout le bouton à 45 % (<code>21:11</code>,
        <code>21:26</code>). Le contraste passe alors sous le seuil — WCAG 1.4.3 exempte les contrôles
        inactifs.
      </p>

      <h3>Tokens</h3>
      <p class="section-note">
        Les {buttonTokens.length} tokens <code>button.*</code> : hauteur, padding, gap, taille d'icône,
        largeur minimale, rayon, anneau de focus. Ils décrivent cet objet et pas le système — c'est pour
        ça qu'ils sont ici plutôt que dans <a href={withBase('/foundations')}>Fondations</a>.
      </p>
      <ul class="plain token-list">
        {
          buttonTokens.map((t) => (
            <li>
              <code class="name">
                {t.name} — {t.resolved}
                {t.alias && <em class="alias"> ← {t.alias}</em>}
              </code>
              {t.description && <p class="desc">{t.description}</p>}
            </li>
          ))
        }
      </ul>
    </section>

    <!-- ── Tag ──────────────────────────────────────────────────────────── -->
    <section>
      <h2>Tag</h2>

      <p class="section-note">
        <strong>Ce qu'il est.</strong> Une étiquette courte qui classe la chose posée à côté d'elle :
        une méthode sur une carte d'étude de cas, une catégorie dans un document.
        <br />
        <strong>Ce qu'il n'est pas.</strong> Ni un bouton — il n'a aucun état interactif, et une pilule
        sur laquelle on clique est un <em>Button</em> — ni une phrase, ni le seul porteur d'un sens :
        c'est le texte qui doit dire ce qu'il veut dire, pas la couleur.
        <br />
        <span class="source">Description du composant Figma <code>19:12</code>.</span>
      </p>

      <div class="demo">
        <div class="tag-row">
          <Tag>Hypothesis Testing</Tag>
          <Tag>Co-design Facilitation</Tag>
          <Tag>Journey Prototyping</Tag>
        </div>
      </div>

      <h3>Props</h3>
      <p class="section-note">Le texte passe par le slot par défaut.</p>
      <div class="table-scroll">
        <table>
          <thead>
            <tr><th>Prop</th><th>Type</th><th>Défaut</th><th>Rôle</th></tr>
          </thead>
          <tbody>
            {
              tagProps.map(([nom, type, defaut, role]) => (
                <tr>
                  <td><code>{nom}</code></td>
                  <td><code>{type}</code></td>
                  <td>{defaut}</td>
                  <td>{role}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="flag">
        <strong>Ce que Figma déclare et que le code n'a pas.</strong> Le composant Figma porte aussi des
        variantes remplies, qui suivent toutes la même règle : fond au cran 100 d'une rampe, encre au
        cran 800 de la même rampe — chaque paire dépasse 8:1. Le code n'implémente que l'outline, la
        seule qu'une vue utilise aujourd'hui. Même politique que <code>Ghost</code> et <code>CTA</code>
        sur Button.
      </p>
    </section>

    <!-- ── Nav ──────────────────────────────────────────────────────────── -->
    <section>
      <h2>Nav</h2>

      <p class="section-note">
        <strong>Ce qu'il est.</strong> La barre en haut d'une page : six boutons — l'avatar de retour à
        l'accueil, les quatre items, et l'action.
        <br />
        <strong>Ce qu'il n'est pas.</strong> Ni un en-tête de section à l'intérieur d'une page — ça,
        c'est un titre — ni un menu : au-delà de cinq liens environ, une navigation devient autre chose
        et demande un autre dessin.
        <br />
        <strong>Pas de filet sous la barre :</strong> ce système sépare ses sections par du blanc.
      </p>

      <p class="flag">
        <strong>Écart à arbitrer côté Figma.</strong> La description du composant (<code>24:5</code>)
        décrit encore l'ancienne barre — « a wordmark on the left » — et affirme que le survol et la page
        courante partagent la même couleur (<code>color.text.accent</code>). Ni l'un ni l'autre n'est
        vrai du composant actuel : il porte un avatar, et l'état courant est une pastille
        <code>color.bg.default</code>. Le texte ci-dessus ne reprend donc que ce qui vaut encore. La
        description est à réécrire dans Figma.
      </p>

      <h3>Ses deux comportements</h3>
      <p class="section-note">
        Ils ne sont pas une variante à déclarer : ils tombent des props. Sans <code>home</code>, pas
        d'avatar ; si <code>current</code> ne correspond à aucun lien, aucun item n'est actif.
      </p>

      <div class="family">
        <h4>Sur l'accueil <span class="ref">Figma 60:992</span></h4>
        <div class="demo demo-nav">
          <Nav links={demoLinks} action={demoAction} label="Démonstration — état d'accueil" />
        </div>
        <p class="desc">
          Pas d'avatar : on n'offre pas un retour vers la page où l'on est. Aucun item courant : l'accueil
          n'est pas un des quatre.
        </p>
      </div>

      <div class="family">
        <h4>Sur les autres pages <span class="ref">Figma 166:475</span></h4>
        <div class="demo demo-nav">
          <Nav
            links={demoLinks}
            current="#projets"
            home={{ href: '#accueil', src: withBase('/images/avatar-judith.png'), alt: 'Accueil' }}
            action={demoAction}
            label="Démonstration — état page courante"
          />
        </div>
        <p class="desc">
          L'avatar ramène à l'accueil, l'item de la page porte la pastille. Survolez un autre onglet :
          elle s'y rend en <code>--motion-duration-default</code>, puis revient.
        </p>
      </div>

      <h3>Props</h3>
      <div class="table-scroll">
        <table>
          <thead>
            <tr><th>Prop</th><th>Type</th><th>Défaut</th><th>Rôle</th></tr>
          </thead>
          <tbody>
            {
              navProps.map(([nom, type, defaut, role]) => (
                <tr>
                  <td><code>{nom}</code></td>
                  <td><code>{type}</code></td>
                  <td>{defaut}</td>
                  <td>{role}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h3>Ce que la maquette ne dit pas</h3>
      <ul class="plain token-list">
        <li>
          <p class="desc">
            <strong>La pastille est du JavaScript.</strong> Le script mesure l'onglet visé et écrit sa
            géométrie en variables CSS ; le mouvement, lui, reste au CSS. Elle suit le survol
            <em>et</em> le focus clavier.
          </p>
        </li>
        <li>
          <p class="desc">
            <strong>Elle a un repli.</strong> Sans JavaScript, l'onglet courant garde son fond blanc et
            le survol son aplat lavande — le comportement d'avant la pastille. C'est le script qui pose
            <code>data-slider-ready</code> et neutralise ces deux aplats.
          </p>
        </li>
        <li>
          <p class="desc">
            <strong>Sous 768px</strong>, les icônes et le bouton d'action s'effacent, l'avatar reste — il
            est le chemin de retour — et la pilule défile si les onglets ne tiennent plus.
          </p>
        </li>
        <li>
          <p class="desc">
            <strong>Sous <code>prefers-reduced-motion</code></strong>, la pastille se repositionne d'un
            coup : ce sont les durées des tokens qui tombent à zéro, le composant n'a rien à savoir de la
            préférence.
          </p>
        </li>
      </ul>
    </section>

    <!-- ── Case Study Card ──────────────────────────────────────────────── -->
    <section>
      <h2>Case Study Card</h2>

      <p class="section-note">
        <strong>Ce qu'elle est.</strong> Une étude de cas présentée en pleine largeur : l'année et le
        client, le titre, la phrase d'impact, les méthodes, le lien vers l'étude — puis les images du
        projet, qui défilent.
        <br />
        <strong>Ce qu'elle n'est pas.</strong> Ni une vignette dans une grille — les coins bas carrés
        et l'ombre projetée vers le haut disent une feuille qui monte depuis le bas de la page, pas une
        boîte posée au milieu — ni une galerie : le carrousel montre le travail, il ne le remplace pas.
        La carte ne connaît ni les études de cas ni leurs URLs ; tout tombe des props.
        <br />
        <span class="source">Figma <code>88:131</code>, en situation <code>176:1248</code>.</span>
      </p>

      <div class="demo demo-card">
        <CaseStudyCard
          eyebrow={caseStudyDemo.eyebrow}
          title={caseStudyDemo.title}
          impact={caseStudyDemo.impact}
          tags={caseStudyDemo.tags}
          action={caseStudyDemo.action}
          images={caseStudyImages}
          headingLevel={3}
        />
      </div>

      <p class="section-note">
        La carte prend la largeur de son conteneur : c'est la page qui décide si elle est pleine
        largeur, la carte ne le sait pas. Ici elle est bornée par le cadre de démonstration.
      </p>

      <h3>Props</h3>
      <div class="table-scroll">
        <table>
          <thead>
            <tr><th>Prop</th><th>Type</th><th>Défaut</th><th>Rôle</th></tr>
          </thead>
          <tbody>
            {
              caseStudyCardProps.map(([nom, type, defaut, role]) => (
                <tr>
                  <td><code>{nom}</code></td>
                  <td><code>{type}</code></td>
                  <td>{defaut}</td>
                  <td>{role}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h3>Ses deux moitiés, utilisables seules</h3>

      <div class="family">
        <h4>L'en-tête <span class="ref">Figma 88:74</span></h4>
        <div class="demo demo-header">
          <CaseStudyHeader
            eyebrow={caseStudyDemo.eyebrow}
            title={caseStudyDemo.title}
            impact={caseStudyDemo.impact}
            tags={caseStudyDemo.tags}
            action={caseStudyDemo.action}
            headingLevel={5}
          />
        </div>
        <p class="desc">
          Le titre et le bouton partagent une ligne et s'alignent sur leur bas. Rétrécissez la fenêtre :
          sous 320px de titre, le bouton passe dessous plutôt que d'écraser le titre. Ses props sont
          celles de la carte, moins <code>images</code> et <code>imagesLabel</code> — la carte ne fait
          que les lui passer.
        </p>
      </div>

      <div class="family">
        <h4>Le carrousel <span class="ref">Figma 88:85</span></h4>
        <div class="demo demo-carousel">
          <Carousel items={caseStudyImages} label="Démonstration — images du projet" />
        </div>
        <p class="desc">
          Les flèches avancent d'une vignette et se désactivent en bout de piste. La piste défile aussi
          au doigt, au trackpad et au clavier — tabulez jusqu'à elle, puis flèches gauche et droite.
        </p>
      </div>

      <h3>Props du carrousel</h3>
      <div class="table-scroll">
        <table>
          <thead>
            <tr><th>Prop</th><th>Type</th><th>Défaut</th><th>Rôle</th></tr>
          </thead>
          <tbody>
            {
              carouselProps.map(([nom, type, defaut, role]) => (
                <tr>
                  <td><code>{nom}</code></td>
                  <td><code>{type}</code></td>
                  <td>{defaut}</td>
                  <td>{role}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h3>Ce que la maquette ne dit pas</h3>
      <ul class="plain token-list">
        <li>
          <p class="desc">
            <strong>Les flèches sont une commodité.</strong> Elles sont masquées dans le HTML et c'est
            le script qui les révèle — puis les masque à nouveau si tout tient dans la largeur. Sans
            JavaScript la piste défile déjà, et sa barre de défilement reste visible : c'est alors la
            seule chose qui dit que ça défile.
          </p>
        </li>
        <li>
          <p class="desc">
            <strong>Le focus ne se perd pas.</strong> Quand une flèche se désactive sous le focus, le
            script le déplace sur l'autre plutôt que de le laisser retomber sur le
            <code>&lt;body&gt;</code>.
          </p>
        </li>
        <li>
          <p class="desc">
            <strong>C'est le seul composant qui lit <code>prefers-reduced-motion</code>.</strong> Le
            <code>behavior: 'smooth'</code> du défilement n'est pas une durée : <code>tokens.css</code>
            ne peut pas le remettre à zéro comme il le fait des <code>motion.duration.*</code>. Le
            script bascule donc lui-même sur <code>'auto'</code>.
          </p>
        </li>
        <li>
          <p class="desc">
            <strong>Sous 768px</strong>, les marges de 48px tomberaient à la moitié d'un écran de 390 :
            elles passent à <code>--space-xl</code>, le titre à <code>--font-size-subtitle</code> et les
            vignettes à 240px de haut. Figma ne dessine pas cette carte en mobile — c'est une décision
            du code.
          </p>
        </li>
      </ul>

      <p class="flag">
        <strong>La carte accepte qu'on lui impose sa hauteur.</strong> Par défaut elle fait la taille
        de son contenu — 779 px à 1280 px de large. <code>--card-height</code>, posée depuis
        l'extérieur, la borne : c'est ainsi que <em>Case Study List</em> lui fait remplir un écran
        entier, donc en recouvrir vraiment une autre. Une hauteur et non un plancher, sans quoi la
        carte grandirait au-delà de l'écran dès que son contenu dépasse, et son bas resterait hors
        d'atteinte une fois la carte collée en haut. Bornée, elle demande au carrousel de se
        resserrer — c'est lui qui cède, jamais l'en-tête.
      </p>

      <p class="flag">
        <strong>Aucun token ne porte les ombres.</strong> Figma déclare deux styles d'effet,
        <code>shadow/lg</code> sur les vignettes et <code>shadow/lg-invert</code> sur la carte, que la
        collection <em>Design tokens</em> n'expose pas en variables. Les deux valeurs vivent donc en dur
        dans les composants, hissées en <code>--card-shadow</code> et
        <code>--carousel-item-shadow</code> — comme <code>--nav-home-size</code> dans le Nav. Le jour où
        Figma les porte en variables, elles rejoignent <code>tokens/</code> et les composants n'ont
        qu'une ligne à changer.
      </p>

      <p class="flag">
        <strong>Les deux ombres de la carte divergent.</strong> Le composant <code>88:131</code> déclare
        <code>0 -30px 30px -14px</code> ; l'instance d'exemple <code>176:1248</code> déclare
        <code>0 -22px 48px -12px</code>. Le code suit le composant — c'est lui la spécification, l'autre
        est une surcharge locale. À réaligner côté Figma.
      </p>

      <p class="flag">
        <strong>L'eyebrow contredit le système.</strong> Figma le dessine en Inter semibold ;
        <code>global.css</code> réserve cette forme — 13px, capitales, interlettrage large — au
        <code>h6</code>, en Poppins bold. Le code suit Figma et ne rend donc pas un <code>h6</code> :
        ce n'est de toute façon pas un titre mais une ligne de contexte au-dessus du titre. À trancher
        côté Figma : ou l'eyebrow rentre dans le rang, ou le système reconnaît deux eyebrows.
      </p>

      <p class="flag">
        <strong>Deux écarts d'espacement.</strong> Figma pose <code>33px</code> entre les vignettes et
        <code>10px</code> entre les tags. Aucun token ne porte ces deux valeurs : la première devient
        <code>--space-2xl</code> (32), la seconde <code>--space-md</code> (12) — on n'a jamais intérêt à
        resserrer l'écart entre deux cibles voisines (WCAG 2.5.8).
      </p>

      <p class="flag">
        <strong>Le Slot Figma accepte tout, le carrousel n'accepte que des images.</strong> La piste
        prend un tableau <code>items</code> plutôt qu'un slot : la hauteur, le rayon et l'ombre des
        vignettes sont l'affaire du carrousel, et les styles scopés d'Astro n'atteignent pas un contenu
        slotté. Même coupure que le Nav, qui prend un tableau <code>links</code>. Le jour où une
        vignette n'est plus une image, c'est le composant qu'il faut rouvrir.
      </p>

      <p class="flag">
        <strong>La hauteur des vignettes cède avant la carte.</strong> Figma la fige à
        <code>382px</code> et le carrousel la garde — mais seulement tant qu'il y a la place. Dans une
        carte dont la hauteur est imposée, comme dans <em>Case Study List</em> où une carte fait
        exactement un écran, le carrousel est la seule chose qui puisse céder : l'en-tête est protégé
        par la taille minimale automatique des boîtes flexibles, et le carrousel lève cette protection
        sur lui-même. Il rétrécit, il ne grandit jamais — avec <code>flex-grow</code>, un écran haut
        laisserait un vide entre les vignettes et les flèches, alors que le surplus doit retomber en
        bas de la carte. Montré seul, le carrousel garde ses 382px en toute circonstance.
      </p>

      <p class="flag">
        <strong>Trois coquilles dans le texte de la maquette.</strong> L'exemple Figma écrit
        « deployements », « langages » et « Raoadmap ». La démo ci-dessus les corrige ; Figma reste à
        corriger.
      </p>
    </section>
    <!-- ── Intro ────────────────────────────────────────────────────────── -->
    <section>
      <h2>Intro</h2>

      <p class="section-note">
        <strong>Ce qu'il est.</strong> L'ouverture d'une page d'accueil : un visage, une salutation, la
        phrase qui dit ce qu'on fait, et le bouton qui mène à la suite. Un seul par page — c'est lui qui
        porte le <code>h1</code>.
        <br />
        <strong>Ce qu'il n'est pas.</strong> Ni un en-tête de section — ça, c'est
        <em>CaseStudyHeader</em>, qui ouvre une carte et non une page — ni un porteur de contenu : le
        visage, les textes et la destination du bouton tombent tous des props, parce qu'ils
        appartiennent au site et pas au système.
        <br />
        <span class="source">Nœud Figma <code>209:2348</code>, « Section.Intro ».</span>
      </p>

      <div class="demo demo-intro">
        <Intro
          avatar={introDemo.avatar}
          greeting={introDemo.greeting}
          headline={introDemo.headline}
          description={introDemo.description}
          action={introDemo.action}
          headingLevel={2}
        />
      </div>

      <h3>Props</h3>
      <div class="table-scroll">
        <table>
          <thead>
            <tr><th>Prop</th><th>Type</th><th>Défaut</th><th>Rôle</th></tr>
          </thead>
          <tbody>
            {
              introProps.map(([nom, type, defaut, role]) => (
                <tr>
                  <td><code>{nom}</code></td>
                  <td><code>{type}</code></td>
                  <td>{defaut}</td>
                  <td>{role}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="flag">
        <strong>L'écart sous le bloc de texte se laisse resserrer.</strong> Figma pose
        <code>space.layout.64</code> entre le bloc et le bouton, et c'est ce que l'intro garde partout
        — mais la valeur est <em>lue</em> dans <code>--intro-gap</code>, jamais déclarée sur
        <code>.intro</code>, pour qu'une valeur posée sur un ancêtre passe au travers. C'est le seul
        endroit de l'intro où il y a de l'air à reprendre, et une page qui cale son premier écran sur
        la hauteur de la fenêtre en a besoin : sous 650 px, le gabarit le ramène à
        <code>space.xl</code> pour que l'intro tienne dans ce qu'on lui laisse. Déclarer la variable
        sur <code>.intro</code> battrait l'héritage et le point de surcharge ne servirait à rien.
      </p>

      <p class="flag">
        <strong>Les tailles sont liées, les couleurs ne le sont pas.</strong> Les trois calques
        portent maintenant un style de texte — <code>body/hero</code>, <code>heading/display</code>,
        <code>body/lead</code> — et deux des trois tailles tombent d'une variable. Les
        <em>couleurs</em>, elles, restent tapées à la main : noir pur, <code>#2f2d2e</code> et
        <code>#666</code>. Les deux premières valent par chance <code>color.text.default</code> ; la
        troisième, non — le gris du système est <code>#6a676d</code>. Le code prend le token, donc la
        description ne s'affiche pas dans le gris de la maquette. À lier côté Figma, c'est le dernier
        morceau.
      </p>

      <p class="flag">
        <strong>Le style <code>heading/display</code> se contredit.</strong> Sa description annonce
        « line-height.tight + letter-spacing.tight » ; ses valeurs disent <code>1.23</code> et
        <code>0</code>. C'est la note qui a tort, pas le style : <code>heading/title</code>, lui, est
        bien serré. Le code suit les valeurs — <code>global.css</code> desserre le <code>h1</code>, et
        le composant ne surcharge plus rien. Deux choses restent à faire côté Figma : réécrire la
        description, et décider si <code>1.23</code> mérite un cran dans l'échelle. Faute de quoi le
        code prend <code>line-height.snug</code> (1.2), soit 1,3px de moins par ligne.
      </p>

      <p class="flag">
        <strong>Le titre en mobile tient, mais pas jusqu'au plancher déclaré.</strong> La variante
        mobile de <code>142:1354</code> garde <code>42px</code> dans un cadre de 390px, et le code la
        suit : « collaborative », le mot le plus long, mesure 289px et passe jusqu'à 337px de large.
        En dessous il sort de l'écran, alors que le fichier déclare toujours son plancher à 320px
        (<code>layout/mobile</code>). Le composant pose donc un filet sous 360px — la largeur du plus
        étroit des téléphones courants. Ce n'est pas le point de rupture du système (767px) : il ne
        change pas de mise en page, il empêche un mot de déborder. À trancher côté Figma : ou la
        variante mobile descend jusqu'à 320, ou le plancher remonte.
      </p>

      <p class="flag">
        <strong>La mesure du bloc n'a pas de token.</strong> Figma la donne en dur —
        <code>929px</code>, minimum <code>280px</code>. Le composant la pose en variable locale
        <code>--intro-measure</code>, comme la carte d'étude de cas pose <code>--header-title-min</code>.
        Le jour où le système nomme ses mesures de texte, ces deux-là rentrent dans le rang.
      </p>
    </section>

    <!-- ── Case Study List ──────────────────────────────────────────────── -->
    <section>
      <h2>Case Study List</h2>

      <p class="section-note">
        <strong>Ce qu'il est.</strong> Les études de cas empilées, une par écran. Chaque carte est une
        couche collée en haut : elle monte par-dessus ce qui la précède, la suivante arrive et la
        recouvre, et le geste inverse défait exactement la même chose. Tout le mouvement est celui du
        défilement natif — aucun script ne déplace quoi que ce soit.
        <br />
        <strong>Ce qu'il n'est pas.</strong> Ni une grille de vignettes — la carte prend la largeur
        entière et n'a pas de format court — ni un porteur de contenu : les études, leurs URLs et leurs
        images tombent des props. Et ce n'est pas une animation : rien n'a de durée ici, le mouvement
        est celui du doigt.
        <br />
        <span class="source">
          Page Figma <code>222:1168</code>, composant <code>222:814</code>, états empilés
          <code>222:912</code> et <code>222:1043</code>.
        </span>
      </p>

      <div class="demo demo-list">
        <p class="fold-stand-in">Le premier écran de la page — nav et intro</p>
        <CaseStudyList
          items={caseStudies.slice(0, 2).map((c) => ({ ...c, images: [] }))}
          label="Démonstration — études de cas"
          headingLevel={3}
        />
      </div>

      <p class="demo-note">
        La pile est ici en réduction, dans une boîte qui défile, et les cartes sont montrées sans leur
        carrousel : c'est ce qu'il faut pour tenir dans une page de doc. En vraie grandeur, une couche
        fait la hauteur de l'écran — <a href={withBase('/templates/home')}>voir le gabarit</a>.
      </p>

      <h3>Props</h3>
      <div class="table-scroll">
        <table>
          <thead>
            <tr><th>Prop</th><th>Type</th><th>Défaut</th><th>Rôle</th></tr>
          </thead>
          <tbody>
            {
              caseStudyListProps.map(([nom, type, defaut, role]) => (
                <tr>
                  <td><code>{nom}</code></td>
                  <td><code>{type}</code></td>
                  <td>{defaut}</td>
                  <td>{role}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h3>Ce que la page doit porter</h3>
      <p>
        Le premier écran — la nav et l'intro — est la <strong>couche du dessous</strong> de la pile :
        il tient sa place, et les cartes lui passent dessus. C'est à la page de le poser, parce que la
        liste ne peut pas mesurer ce qui est au-dessus d'elle, et que le mesurer en JavaScript ferait
        sauter la carte au chargement. Trois règles suffisent :
      </p>
      <pre><code>{`.home       { --fold-peek: 50px; }
.home-deck  { }   /* le premier écran + la pile, et rien d'autre */
.home-first { position: sticky; top: 0;
              height: calc(100svh - var(--fold-peek)); }
.nav-slot   { position: sticky; top: 0; }

@media (max-width: 767px) {
  .home-first { display: contents; }
}`}</code></pre>
      <p>
        Une <em>hauteur</em>, et non un plancher : c'est elle qui garantit le liseré de 50 px à toute
        hauteur d'écran. Avec <code>min-height</code>, un contenu un peu grand pousse le bloc et mange
        le liseré. Reste à donner à la liste l'id de ce bloc, par <code>covers</code>, pour qu'elle le
        rende inerte une fois recouvert.
      </p>
      <p>
        <code>.home-deck</code> n'a aucun style et n'est pas décoratif : c'est lui qui <strong>borne
        le collage</strong>. Un élément positionné se peint devant un élément qui ne l'est pas, quel
        que soit l'ordre du DOM — sans ce bloc, le premier écran resterait collé jusqu'au bas de la
        page et se peindrait par-dessus tout ce qui suit la pile. Il faut donc dire où son collage
        cesse, et c'est là où la pile s'arrête.
      </p>
      <p>
        En mobile, <code>display: contents</code> efface ce bloc de la mise en page sans toucher au
        DOM : la nav et l'intro deviennent enfants de <code>.home-deck</code>. L'intro reprend alors
        sa place dans le flux et défile, tandis que la nav — qui se colle désormais elle-même — tient
        le haut de l'écran sur toute la hauteur de la pile. Dans le bloc, elle se serait décollée à
        la fin de l'intro.
      </p>
      <p>
        Le reste tombe tout seul. Le bouton de l'intro et l'onglet du Nav pointent
        <code>#projets</code>, la liste porte cette ancre, et le navigateur amène son haut à
        <code>100svh − 50px</code> — c'est-à-dire exactement la position « première carte collée en
        haut ». Le clic et le défilement décrivent le même état sans partager une ligne de code.
      </p>

      <div class="table-scroll">
        <table>
          <thead>
            <tr><th>Variable</th><th>Défaut</th><th>Rôle</th></tr>
          </thead>
          <tbody>
            {
              caseStudyListVars.map(([nom, defaut, role]) => (
                <tr>
                  <td><code>{nom}</code></td>
                  <td><code>{defaut}</code></td>
                  <td>{role}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h3>Ce que la maquette ne dit pas</h3>

      <p class="flag">
        <strong>Le 50px de Figma n'est pas le liseré.</strong> C'est l'écart entre l'intro et la liste
        au repos (<code>209:2383</code>, <code>itemSpacing: 50</code>) et le chevauchement entre cartes
        une fois empilées (<code>222:912</code>, <code>itemSpacing: −50</code>). Le liseré, lui, tombe
        tout seul dans la maquette et n'y est pas constant : <code>166px</code> au repos
        (834 − 101 − 517 − 50), <code>70px</code> une fois la première carte montée. Le code fait le
        choix inverse — un liseré <em>garanti</em> de 50px dans tous les états — parce que c'est
        l'intention. Les deux lectures se rejoignent à une condition, qui est devenue la clé du
        calcul : une carte au repos occupe la hauteur de l'écran.
      </p>

      <p class="flag">
        <strong>Trois mesures de la maquette ne suivent pas.</strong> Le bloc nav + intro est dessiné à
        668px là où un liseré de 50 en demande 784 sur un écran de 834 — les 116px d'écart sont l'air
        qui manque autour de l'intro. Et les deux cartes sont dessinées à 814 et 776px là où le
        comportement en demande 834. À reprendre côté Figma : c'est le fichier qui doit rattraper le
        code, pas l'inverse.
      </p>

      <p class="flag">
        <strong>Le mouvement n'est écrit nulle part.</strong> Aucune réaction de prototypage n'est
        posée sur la page HP — les trois frames sont des captures d'états, et <code>222:1042</code>
        mime le recouvrement en <em>réordonnant</em> les cartes dans son auto-layout. C'est un
        artifice de maquette : en défilement réel rien ne se réordonne, une couche en recouvre
        simplement une autre. Le comportement ne vient donc pas du fichier mais de la consigne, et
        c'est ici qu'il est écrit.
      </p>

      <p class="flag">
        <strong>Le liseré n'a pas de token.</strong> <code>space.layout.48</code> vaut 48 : ces 2px
        d'écart déplaceraient le liseré à chaque cran, puisqu'il entre dans le calcul de position. La
        valeur reste donc en dur, dans <code>--fold-peek</code>, comme <code>--card-shadow</code> et
        <code>--intro-measure</code> avant elle. Le jour où Figma nomme ce 50, il rentre dans le rang.
      </p>

      <p class="flag">
        <strong>La vignette du carrousel n'est plus figée à 382 px.</strong> Une couche fait
        exactement un écran, et la carte est bornée à cette hauteur : bornée, elle ne peut plus
        déborder, et c'est son carrousel qui se resserre pour tenir. La vignette garde donc les
        <code>382px</code> de Figma dès que la fenêtre fait 834 px de haut — le format de la maquette
        — et rétrécit en dessous : <code>363</code> à 760, <code>303</code> à 700, <code>243</code> à
        640, soit à trois pixels près la valeur que le code utilise déjà en mobile. L'image maigrit,
        elle n'est jamais rognée, et rien ne sort de l'écran à aucune hauteur. C'est un écart avec
        Figma, qui fige cette hauteur : à trancher côté fichier.
      </p>

      <p class="flag">
        <strong>Le seul script pose <code>inert</code>, et rien d'autre.</strong> Une carte recouverte
        garde sa place dans l'écran : elle reste donc atteignable au clavier, et le focus se poserait
        sur un bouton invisible — l'échec WCAG 2.4.11, <em>Focus Not Obscured</em>. Le cas a été
        mesuré, pas supposé : sans le script, le bouton « Read the story » de la première carte prend
        le focus alors que la deuxième le couvre entièrement. Le script constate ce que le CSS a déjà
        fait et le dit au clavier et aux lecteurs d'écran ; il ne déplace rien et ne dessine rien.
        Sans lui, la pile marche entièrement et n'est que moins sûre au clavier — le même contrat que
        les flèches du <em>Carousel</em>.
      </p>

      <p class="flag">
        <strong>L'écart de 50 px sous l'intro est absorbé par le centrage.</strong> Figma le pose en
        <code>itemSpacing</code> sur <code>209:2383</code>, mais Figma ne dessine aucun mou : son
        premier écran fait exactement la taille de son contenu. Dès qu'on cale ce bloc sur la hauteur
        de la fenêtre, il y a du mou, et le répartir autour de l'intro vaut mieux que de tout laisser
        tomber sous elle. Sur une fenêtre basse — moins de 650 px — c'est l'inverse : l'intro se
        resserre, son grand écart interne retombe à <code>space.xl</code>. Le liseré, lui, ne cède
        jamais.
      </p>

      <p class="flag">
        <strong>La dernière carte a besoin de ce qui la suit.</strong> Le collage s'arrête au bas de la
        liste : sans rien après elle, la dernière couche traverse l'écran sans jamais s'y arrêter. Sur
        une page d'accueil, la section suivante fait cette butée — le composant n'invente pas un vide
        pour la remplacer.
      </p>

      <p class="flag">
        <strong>Le premier écran est une couche, pas un décor.</strong> La nav et l'intro restent en
        place, et la première carte vient <em>par-dessus</em> elles — c'est la maquette
        <code>222:907</code>, où la nav n'est nulle part en haut de l'écran. Elles gardent donc leur
        place dans la page tout en étant invisibles, ce qui les laisserait atteignables au clavier :
        d'où <code>covers</code>, et le <code>inert</code> que le script leur pose au bon moment.
        Sans cette prop, la pile fonctionne mais le bouton de l'intro reste dans l'ordre de
        tabulation derrière une carte opaque.
        <br />
        <strong>En mobile, la nav ne se laisse pas recouvrir.</strong> L'intro défile avec la page,
        la nav tient le haut de l'écran — mais les cartes lui passent <em>dessous</em>, pas dessus.
        C'est l'écart assumé avec le desktop : les couches y sont <code>position: static</code>, donc
        hors de tout positionnement, et un élément positionné se peint devant un élément qui ne l'est
        pas. Sur un téléphone, un en-tête recouvert ne serait plus atteignable qu'en remontant toute
        la page, et c'est le format où l'on en a le plus besoin.
        <br />
        C'est aussi la seule chose que la géométrie seule ne saurait pas trancher — elle dit qui est
        arrivé en haut, jamais qui est peint devant. D'où le garde-fou du script : il ne pose
        <code>inert</code> que si les cartes se collent réellement.
      </p>

      <p class="flag">
        <strong>Le mobile n'est pas dessiné.</strong> Sous 768px, la pile redevient une liste : les
        cartes se suivent sous l'intro, sans rien qui bouge. Une carte haute comme un écran de
        téléphone y serait illisible, et le recouvrement n'a pas de sens sur un format où l'on fait
        déjà défiler d'un pouce. C'est une décision du code, comme celles déjà prises dans
        <em>CaseStudyCard</em> et <em>Carousel</em>.
        <br />
        <strong>Aucun seuil de hauteur, en revanche.</strong> La pile tient à toute hauteur de
        fenêtre, parce que la carte s'y ajuste au lieu de déborder — voir juste en dessous.
      </p>
    </section>
  </main>
</DocsLayout>

<style>
  /* Le cadre neutre dans lequel un composant se montre : il donne au composant
     la largeur qu'il aurait dans une page, sans laisser croire qu'il fait
     partie de la doc. */
  .demo {
    padding: var(--space-xl);
    background: var(--color-bg-default);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-lg);
  }

  /* Le Nav se centre et déborde en largeur sur petit écran : il défile dans son
     cadre plutôt que d'élargir la page. */
  .demo-nav {
    padding: var(--space-md) 0;
    overflow-x: auto;
  }

  /* La carte porte ses propres marges et vient buter en bas de son cadre : ses
     coins bas sont carrés parce qu'elle monte depuis le bord. Reste un peu d'air
     en haut, sans quoi son ombre — projetée vers le haut — ne se verrait pas. */
  .demo-card {
    padding: var(--space-2xl) 0 0;
    /* Le cadre perd ses coins bas arrondis pour épouser ceux de la carte, qui
       sont carrés. Pas d'overflow: hidden ici — il rognerait l'ombre. */
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
  }

  /* L'en-tête et le carrousel portent eux aussi leurs marges latérales. */
  .demo-header,
  .demo-carousel {
    padding: var(--space-xl) 0;
  }

  /* La carte et le carrousel s'attendent à la surface lavande ; le carrousel
