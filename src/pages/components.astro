// Doc des composants du système. Chaque section montre le composant en vrai —
// jamais une copie de son markup : si le composant change, la page change.
import { withBase } from '../design-system/lib/url';
import DocsLayout from '../design-system/layouts/DocsLayout.astro';
import Button from '../design-system/components/Button.astro';
import Tag from '../design-system/components/Tag.astro';
import Nav from '../design-system/components/Nav.astro';
import Carousel from '../design-system/components/Carousel.astro';
import Card from '../design-system/components/Card.astro';
import CaseStudyHeader from '../design-system/components/CaseStudyHeader.astro';
import CaseStudyCard from '../design-system/components/CaseStudyCard.astro';
import Intro from '../design-system/components/Intro.astro';
import CaseStudyList from '../design-system/components/CaseStudyList.astro';
import tokens from '../design-system/data/tokens.json';
// Les données de démonstration vivent à part : /templates/home montre les mêmes.
import {
  demoLinks,
  demoAction,
  caseStudyImages,
  caseStudyDemo,
  caseStudies,
  introDemo,
  cardDemo,
} from './_demo';

const buttonTokens = tokens.filter((t) => t.group === 'button');
const cardTokens = tokens.filter((t) => t.group === 'card');
const buttonSizes = ['sm', 'md', 'lg'] as const;

// Les props sont recopiées des interface Props des composants. Une seule
// définition existe dans le projet : celle du composant.
const buttonProps = [
  ['variant', `'primary' | 'secondary'`, 'primary', 'Primary porte l’action principale ; une seule par vue.'],
  ['size', `'sm' | 'md' | 'lg'`, 'md', 'Les trois hauteurs des tokens button.height.*.'],
  ['href', 'string', '—', 'Avec href, rend un <a> ; sans, un <button>.'],
  ['icon', 'IconName', '—', 'Nom d’une icône du système. Posée avant le label.'],
  ['iconEnd', 'IconName', '—', 'Idem, mais posée après le label. Cumulable avec icon.'],
  [
    'aria-label',
    'string',
    '—',
    'Le nom du bouton quand aucun libellé ne le porte. Obligatoire dès que l’icône est seule.',
  ],
  ['type', `'button' | 'submit'`, 'button', 'Ignoré quand href est fourni.'],
  ['class', 'string', '—', 'Classe supplémentaire pour la mise en page de l’appelant.'],
];

const navProps = [
  ['links', '{ href, label, icon? }[]', '—', 'Les items. Le composant ne les connaît pas d’avance.'],
  ['current', 'string', '—', 'Chemin courant. Aucun item actif s’il ne correspond à aucun href.'],
  ['home', '{ href, src, alt }', '—', 'Le bouton avatar. Absent ⇒ non rendu : c’est l’état d’accueil.'],
  ['action', '{ label, icon?, href? }', '—', 'Le sixième bouton. Sans href ⇒ <button> inerte.'],
  ['label', 'string', 'Navigation principale', 'aria-label du <nav>.'],
  [
    'sticky',
    'boolean',
    'false',
    'La barre tient le haut de l’écran et s’efface quand on descend. Absente, elle reste posée à plat — l’état montré ici.',
  ],
];

// Ce qu'une page a à savoir de la barre collée. Les trois sont lues sans être
// déclarées sur l'élément, comme --btn-px : la valeur de repli est celle du
// composant, et un contexte peut la reprendre.
const navVars = [
  [
    '--nav-height',
    '88px — 72px sous 768',
    'Le token nav.height, en deux modes. À lire, jamais à écrire : c’est lui qui cale le premier écran d’une page sous la barre.',
  ],
  [
    '--nav-hide-after',
    '100px',
    'Le seuil sous lequel la barre ne s’efface jamais, quel que soit le sens du défilement.',
  ],
  [
    '--nav-hide-grain',
    '6px',
    'En deçà, un mouvement n’est pas un geste : c’est ce qui empêche le trackpad et l’inertie iOS de faire clignoter la barre.',
  ],
  [
    '--nav-shift',
    '0',
    'Le déplacement de la barre. Écrit par l’état, pas à la main — on ne le pose que pour figer la barre à des fins de capture.',
  ],
];

const tagProps = [
  [
    'variant',
    `'accent' | 'lime' | 'neutral' | 'outline'`,
    'outline',
    'Les quatre variantes de Figma. Les trois premières sont remplies.',
  ],
  ['class', 'string', '—', 'Classe supplémentaire pour la mise en page de l’appelant.'],
  ['style', 'string', '—', 'Le point de surcharge : --tag-color sur l’outline, et rien d’autre.'],
];

const cardProps = [
  [
    'orientation',
    `'vertical' | 'horizontal'`,
    'vertical',
    'Les deux variantes de Figma. Verticale, l’image est en tête ; horizontale, elle occupe la moitié gauche.',
  ],
  ['title', 'string', '—', 'Le titre. La seule prop obligatoire.'],
  [
    'titleSize',
    `'title' | 'heading'`,
    'title',
    'La taille du titre : title est celle d’un h2 — ce que Figma dessine — heading celle d’un h4. Sans rapport avec headingLevel, qui règle le rang.',
  ],
  ['subtitle', 'string', '—', 'La ligne sous le titre.'],
  [
    'meta',
    'string',
    '—',
    'L’information de second plan, sous le sous-titre — une date, un lieu, un auteur. Absente ⇒ la ligne n’est pas rendue.',
  ],
  [
    'image',
    '{ src, alt, width, height }',
    '—',
    'L’image de tête. width et height donnent le rapport de l’image, pas la taille de la boîte. Absente ⇒ la carte n’en réserve pas la place.',
  ],
  [
    'headingLevel',
    '2 | 3 | 4 | 5',
    '2',
    'Le rang du titre, sous ce que la page porte déjà. Il ne change pas le dessin.',
  ],
  ['class', 'string', '—', 'Classe supplémentaire pour la mise en page de l’appelant.'],
  ['style', 'string', '—', 'Le point de surcharge : --card-media-height, et rien d’autre.'],
];

// Les deux emplacements. Ce ne sont pas des props : ce sont les slots nommés de
// Figma, recopiés tels quels.
const cardSlots = [
  [
    'tags-top',
    'La rangée de tags au-dessus du titre, avant tout le texte.',
  ],
  [
    'tags',
    'La seconde rangée, sous les informations secondaires. Figma n’accepte que des Tag dans les deux — le code ne peut pas l’imposer, la doctrine le dit.',
  ],
  [
    'actions',
    'Ce qui mène quelque part : un Button, ou plusieurs. Ils se calent à droite de la carte.',
  ],
];

const caseStudyCardProps = [
  ['eyebrow', 'string', '—', 'L’année et le client. Mis en capitales par le CSS.'],
  ['title', 'string', '—', 'Le titre de l’étude de cas.'],
  ['impact', 'string', '—', 'La phrase d’impact, sous le titre.'],
  ['tags', 'string[]', '[]', 'Les méthodes. Vide ⇒ la rangée n’est pas rendue.'],
  ['action', '{ label, href? }', '—', 'Le lien vers l’étude. Sans href ⇒ <button> inerte.'],
  ['images', '{ src, alt, width, height }[]', '[]', 'Les vignettes. Vide ⇒ pas de carrousel.'],
  ['imagesLabel', 'string', 'Images — {title}', 'Nom accessible de la piste.'],
  [
    'headingLevel',
    '2 | 3 | 4 | 5',
    '2',
    'Le rang du titre, sous ce que la page porte déjà. Il ne change pas le dessin : la taille vient du composant.',
  ],
  ['class', 'string', '—', 'Classe supplémentaire pour la mise en page de l’appelant.'],
];

const carouselProps = [
  [
    'items',
    '{ src, alt, width, height }[]',
    '—',
    'width et height donnent le rapport de la boîte, pas la taille du fichier : c’est le cadrage voulu, l’image le remplit en cover.',
  ],
  ['label', 'string', 'Images du projet', 'Nom accessible de la piste.'],
  ['class', 'string', '—', 'Classe supplémentaire pour la mise en page de l’appelant.'],
];

const introProps = [
  ['avatar', '{ src, alt }', '—', 'Le visage. src passe par le withBase() du site : c’est son asset.'],
  ['greeting', 'string', '—', 'La salutation, au-dessus du titre.'],
  ['headline', 'string', '—', 'La phrase qui dit ce qu’on fait.'],
  ['description', 'string', '—', 'La phrase sous le titre. Absente ⇒ non rendue.'],
  ['action', '{ label, href? }', '—', 'La suite. Sans href ⇒ <button> inerte.'],
  [
    'headingLevel',
    '1 | 2',
    '1',
    'Le rang du titre. 1 sur une page qui n’a pas d’autre titre. Il ne change pas le dessin : la taille vient du composant.',
  ],
  ['class', 'string', '—', 'Classe supplémentaire pour la mise en page de l’appelant.'],
];

const caseStudyListProps = [
  [
    'items',
    '{ eyebrow, title, impact?, tags?, action?, images?, imagesLabel? }[]',
    '—',
    'Les études de cas. Ajouter une carte, c’est ajouter un objet.',
  ],
  ['id', 'string', '—', 'La cible d’ancre : c’est par elle qu’arrivent « Projets » et le bouton de l’intro.'],
  ['label', 'string', 'Études de cas', 'Nom accessible de la section.'],
  [
    'covers',
    'string',
    '—',
    'L’id du bloc que la première carte recouvre — le premier écran de la page. Il devient inert quand elle est en place.',
  ],
  [
    'headingLevel',
    '2 | 3 | 4 | 5',
    '2',
    'Le rang des titres de carte, sous ce que la page porte déjà. Il ne change pas le dessin.',
  ],
  ['class', 'string', '—', 'Classe supplémentaire pour la mise en page de l’appelant.'],
];

// Les deux variables CSS que la pile lit sans les déclarer : c'est par elles que
// la page règle sa géométrie, et c'est tout ce qu'elle a à savoir.
const caseStudyListVars = [
  [
    '--fold-peek',
    '90px',
    'Le liseré de carte qui dépasse sous le bas de l’écran, et le chevauchement entre deux cartes — c’est le même nombre. À déclarer une fois sur la page.',
  ],
  [
    '--layer-height',
    '100svh',
    'La hauteur d’une couche. Ne se change que pour montrer la pile en réduction, comme ci-dessus.',
  ],
];

---

<DocsLayout
  title="Composants — UX design system"
  description="Les composants du système : Button, Tag, Nav, la fiche, la carte d'étude de cas et leur pile, avec leur doctrine, leurs états et leurs props."
>
  <header class="page-head">
    <h6>Design system</h6>
    <h1>Composants</h1>
    <p class="lead">
      Deux primitives — Button et Tag — et les objets qui les composent : le Nav, la fiche, la carte
      d'étude de cas avec son en-tête et son carrousel, l'intro d'une page d'accueil, et la pile qui
      empile les études de cas. Tous construits uniquement à partir des tokens. Ce qui est montré ici est
      rendu par les composants eux-mêmes — pas par une copie de leur markup. La doctrine d'usage
      vient des descriptions Figma : c'est elle qui porte les interdits.
    </p>
  </header>

  <main>
    <!-- ── Button ───────────────────────────────────────────────────────── -->
    <section>
      <h2>Button</h2>

      <p class="section-note">
        <strong>Ce qu'il est.</strong> La chose sur laquelle on clique. Dans une maquette, un vrai contrôle
        ; dans un document ou sur une slide, la représentation d'une action.
        <br />
        <strong>Ce qu'il n'est pas.</strong> Ni une étiquette — une pilule qui ne fait rien est un
        {' '}<em>Tag</em> — ni un objet qu'on répète : deux boutons primaires dans une vue, et aucun des deux
        n'est principal. Pour naviguer à l'intérieur du Nav, c'est un lien qu'il faut, pas un bouton.
        <br />
        <span class="source">Description du composant Figma <code>21:47</code>.</span>
      </p>

      <div class="demo">
        <div class="btn-row">
          {
            buttonSizes.map((size) => (
              <Button size={size} icon="mail-edit">
                Bouton {size}
              </Button>
            ))
          }
        </div>

        <div class="btn-row last">
          {buttonSizes.map((size) => <Button variant="secondary" size={size}>Secondaire {size}</Button>)}
        </div>
      </div>

      <p class="section-note">
        L'écart entre deux boutons est <code>--button-target-spacing</code> (WCAG 2.5.8). Tabulez pour
        voir l'anneau de focus, et survolez pour voir le fond changer en
        {' '}<code>--motion-duration-quick</code>.
      </p>

      <h3>Props</h3>
      <div class="table-scroll">
        <table>
          <thead>
            <tr><th>Prop</th><th>Type</th><th>Défaut</th><th>Rôle</th></tr>
          </thead>
          <tbody>
            {
              buttonProps.map(([nom, type, defaut, role]) => (
                <tr>
                  <td><code>{nom}</code></td>
                  <td><code>{type}</code></td>
                  <td>{defaut}</td>
                  <td>{role}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="section-note">
        Chaque taille pose ses variables locales (<code>--btn-h</code>, <code>--btn-px</code>,
        {' '}<code>--btn-gap</code>, <code>--btn-icon</code>, <code>--btn-min-w</code>) et chaque variante
        ses trois fonds (<code>--btn-bg</code>, <code>--btn-bg-hover</code>,
        {' '}<code>--btn-bg-active</code>) : un appelant peut en surcharger un ponctuellement via
        {' '}<code>style</code> plutôt que d'inventer une taille ou une variante de plus. C'est ce que fait
        le Nav pour son bouton d'action, que Figma compose en hauteur lg avec le padding horizontal md
        — et le Carousel pour ses flèches, que Figma pose sur <code>color.bg.default</code> et non sur
        la surface lavande du secondaire.
      </p>

      <p class="section-note">
        <strong>L'icône prend la couleur du bouton</strong>, parce qu'elle est inlinée et ne connaît que
        {' '}<code>currentColor</code>. <code>icon</code> et <code>iconEnd</code> attendent un nom du registre,
        pas un chemin : la même flèche sert au primaire et au secondaire. Le jeu complet est sur
        {' '}<a href={withBase('/icons')}>Icônes</a>.
      </p>

      <h3>Où se pose l'icône</h3>
      <p class="section-note">
        Quatre compositions, quelle que soit la taille et quelle que soit la variante. C'est la place de
        l'icône qui les distingue, et elle se choisit par le nom de la prop — il n'y a pas de valeur
        {' '}<code>left</code> ou <code>right</code> à passer.
      </p>
      <pre><code>{`<Button>Texte seul</Button>
<Button icon="mail-edit">Icône à gauche</Button>
<Button iconEnd="arrow-narrow-right">Icône à droite</Button>
<Button icon="trash" aria-label="Supprimer" style="--btn-min-w: 0" />`}</code></pre>
      <p class="section-note">
        Les deux se cumulent : <code>icon</code> et <code>iconEnd</code> ensemble encadrent le libellé.
        Le quatrième cas est le seul qui demande deux précautions. <strong>Sans libellé, plus rien ne
        donne sa largeur au bouton</strong> : la largeur minimale de la taille — 96 px en md — ferait
        flotter l'icône au milieu d'un vide, d'où le <code>--btn-min-w: 0</code>. Et <strong
        >une icône ne s'annonce pas</strong> : <code>aria-label</code> devient le seul nom du
        bouton, faute de quoi un lecteur d'écran dit « bouton » et rien de plus.
      </p>

      <p class="flag">
        <strong>Ce que le composant devrait porter lui-même.</strong> Ces deux précautions se répètent à
        chaque bouton à icône seule — le Carousel et la page <a href={withBase('/icons')}>Icônes</a>
        {' '}les réécrivent chacun de leur côté. Une prop qu'on doit connaître pour l'écrire est une qu'on
        n'écrira pas : c'est au bouton de retirer sa largeur minimale quand il n'a pas de libellé, pas à
        l'appelant de le savoir.
      </p>

      <p class="flag">
        <strong>Écart à arbitrer côté Figma.</strong> Les trois familles <code>height</code>,
        {' '}<code>padding-y</code> et <code>icon-size</code> sont sur-déterminées et ne s'accordent pas : en
        taille md, <code>16 + 24 + 16 = 56 px</code> alors que <code>--button-height-md</code> vaut 48.
        Seule la taille sm est cohérente. Ici la hauteur prime — c'est la dimension que les descriptions
        rattachent à WCAG 2.5.5 — et le padding vertical n'est pas appliqué.
      </p>

      <p class="flag">
        <strong>Ce que Figma déclare et que le code n'a pas.</strong> Le composant Figma porte quatre
        variantes (<code>Primary</code>, <code>Secondary</code>, <code>Ghost</code>, <code>CTA</code>) et
        quatre états (<code>Default</code>, <code>Hover</code>, <code>Pressed</code>,
        {' '}<code>Disabled</code>). Le code implémente deux variantes et les quatre états : ni
        {' '}<code>Ghost</code> ni <code>CTA</code>. À intégrer le jour où une vue en a besoin — pas avant.
        L'état désactivé, lui, est arrivé avec les flèches du carrousel : Figma ne change ni le fond ni
        la bordure, il baisse l'opacité de tout le bouton à 45 % (<code>21:11</code>,
        {' '}<code>21:26</code>). Le contraste passe alors sous le seuil — WCAG 1.4.3 exempte les contrôles
        inactifs.
      </p>

      <h3>Tokens</h3>
      <p class="section-note">
        Les {buttonTokens.length} tokens <code>button.*</code> : hauteur, padding, gap, taille d'icône,
        largeur minimale, rayon, anneau de focus. Ils décrivent cet objet et pas le système — c'est pour
        ça qu'ils sont ici plutôt que dans <a href={withBase('/foundations')}>Fondations</a>.
      </p>
      <ul class="plain token-list">
        {
          buttonTokens.map((t) => (
            <li>
              <code class="name">
                {t.name} — {t.resolved}
                {t.alias && <em class="alias"> ← {t.alias}</em>}
              </code>
              {t.description && <p class="desc">{t.description}</p>}
            </li>
          ))
        }
      </ul>
    </section>

    <!-- ── Tag ──────────────────────────────────────────────────────────── -->
    <section>
      <h2>Tag</h2>

      <p class="section-note">
        <strong>Ce qu'il est.</strong> Une étiquette courte qui classe la chose posée à côté d'elle :
        un statut dans une ligne de tableau, un mot-clé sur une slide, une catégorie dans un document
        — ici, les méthodes d'une étude de cas.
        <br />
        <strong>Ce qu'il n'est pas.</strong> Ni un bouton — il n'a aucun état interactif, et une pilule
        sur laquelle on clique est un <em>Button</em> — ni une phrase, ni le seul porteur d'un sens :
        c'est le texte qui doit dire ce qu'il veut dire, pas la couleur.
        <br />
        <span class="source">Description du composant Figma <code>19:12</code>.</span>
      </p>

      <div class="demo">
        <div class="tag-row">
          <Tag variant="accent">Accent</Tag>
          <Tag variant="lime">Lime</Tag>
          <Tag variant="neutral">Neutral</Tag>
          <Tag variant="outline">Outline</Tag>
        </div>
      </div>

      <h3>Les quatre variantes</h3>
      <p class="section-note">
        <strong>Les trois remplies tiennent par une seule règle :</strong> fond au cran 100 d'une
        rampe, encre au cran 800 de la même rampe. La paire ne se dissocie pas — c'est elle qui porte
        le contraste, et chacune dépasse 8:1. La quatrième n'a pas de fond : liseré
        {' '}<code>color.accent.500</code>, encre <code>color.text.accent</code>. C'est tout le jeu : il n'y
        a pas de cinquième couleur à composer, et un tag n'a jamais deux couleurs à la fois.
      </p>
      <p class="section-note">
        <strong>Le défaut est <code>outline</code></strong>, là où Figma ouvre le jeu sur
        {' '}<code>Accent</code>. C'est la variante que portent 42 des 49 tags du fichier, et la seule
        qu'une vue d'ici utilise — la carte d'étude de cas, plus bas. Prendre le défaut de Figma
        l'aurait repeinte sans le dire.
      </p>
      <p class="section-note">
        <strong>Le liseré est un <code>outline</code> rentré d'un pixel, pas un <code>border</code>.</strong>
        {' '}Dans Figma le contour est tracé en dedans et la pilule mesure 33 px de haut ; un
        {' '}<code>border</code> s'ajoute au padding et l'aurait portée à 35. L'outline ne compte pas dans
        la boîte — les quatre variantes ont donc exactement la même hauteur, et une rangée qui les
        mélange ne bouge pas.
      </p>

      <h3>Props</h3>
      <p class="section-note">Le texte passe par le slot par défaut.</p>
      <div class="table-scroll">
        <table>
          <thead>
            <tr><th>Prop</th><th>Type</th><th>Défaut</th><th>Rôle</th></tr>
          </thead>
          <tbody>
            {
              tagProps.map(([nom, type, defaut, role]) => (
                <tr>
                  <td><code>{nom}</code></td>
                  <td><code>{type}</code></td>
                  <td>{defaut}</td>
                  <td>{role}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h3>Reprendre la couleur de l'outline</h3>
      <p class="section-note">
        <strong>Un seul levier, et il ne vaut que pour l'<code>outline</code>.</strong>
        {' '}<code>--tag-color</code> reprend d'un coup le liseré et l'encre — jamais l'un sans l'autre.
        Elle se pose en <code>style</code> sur un tag, ou sur un ancêtre pour toute une rangée, et le
        repli reste <code>color.accent.500</code>. Le dessin, la graisse, le rayon et l'espacement ne
        se reprennent pas : un tag qui change de dessin n'est plus un tag.
        <br />
        <strong>Sur une variante remplie, elle ne fait rien</strong> — elle n'y toucherait que
        l'encre, donc déferait la paire 100/800 et le contraste qui la justifie. Une couleur qui n'est
        pas au catalogue se demande à Figma ; elle ne se pose pas ici.
      </p>
      <p class="section-note">
        <strong>La valeur attendue est le cran 800 d'une rampe</strong>, celui que Figma donne déjà à
        l'encre des variantes remplies. C'est le seul cran qui tienne 4,5:1 sur les trois fonds du
        système : au pire, sur <code>color.bg.section</code>, accent 800 mesure 11,2:1, neutral 800
        9:1 et highlight 800 6,7:1 (WCAG 1.4.3) — le liseré suivant la même couleur, 1.4.11 passe par
        surcroît. Les crans plus clairs ne tiennent pas : highlight 700 tombe à 4,2:1 sur cette même
        surface, et <code>color.feedback.danger</code> à 3,3:1.
      </p>

      <p class="flag">
        <strong>Écart à arbitrer côté Figma.</strong> La deuxième variante s'appelle <code>Lime</code>
        {' '}dans le fichier, mais la rampe qu'elle consomme s'appelle <code>highlight</code> —
        {' '}<code>highlight.100</code> et <code>highlight.800</code>. Le code a gardé le nom de la
        variante pour que la prop se recoupe avec Figma, et se retrouve donc à écrire
        {' '}<code>lime</code> pour lire <code>highlight</code>. Un nom de couleur pour une variante, un
        nom de rôle pour la rampe : c'est la variante qu'il faut renommer.
      </p>
    </section>

    <!-- ── Nav ──────────────────────────────────────────────────────────── -->
    <section>
      <h2>Nav</h2>

      <p class="section-note">
        <strong>Ce qu'il est.</strong> La barre en haut d'une page : six boutons — l'avatar de retour à
        l'accueil, les quatre items, et l'action.
        <br />
        <strong>Ce qu'il n'est pas.</strong> Ni un en-tête de section à l'intérieur d'une page — ça,
        c'est un titre — ni un menu : au-delà de cinq liens environ, une navigation devient autre chose
        et demande un autre dessin.
        <br />
        <strong>Pas de filet sous la barre :</strong> ce système sépare ses sections par du blanc.
      </p>

      <p class="flag">
        <strong>Écart à arbitrer côté Figma.</strong> La description du composant (<code>24:5</code>)
        décrit encore l'ancienne barre — « a wordmark on the left » — et affirme que le survol et la page
        courante partagent la même couleur (<code>color.text.accent</code>). Ni l'un ni l'autre n'est
        vrai du composant actuel : il porte un avatar, et l'état courant est une pastille
        {' '}<code>color.bg.default</code>. Le texte ci-dessus ne reprend donc que ce qui vaut encore. La
        description est à réécrire dans Figma.
      </p>

      <p class="flag">
        <strong>Le masquage n'est dessiné nulle part.</strong> La page HP porte trois états de
        défilement (<code>45:388</code> au repos, <code>222:907</code> et <code>222:1042</code> les
        cartes montées), et aucun ne montre la barre effacée. Aucune réaction de prototypage n'y est
        posée non plus. Il manque un quatrième état — barre effacée, première carte par-dessus l'intro
        — sans quoi ce code est la seule spécification du mouvement.
      </p>

      <p class="flag">
        <strong>La barre n'a pas de fond, et une carte a le même que sa pilule.</strong> Rien n'est
        dessiné sous la barre : ce qui flotte au-dessus du contenu, ce sont trois objets déjà opaques —
        l'avatar, la pilule et le bouton. Mais la carte d'étude de cas est en
        {' '}<code>color.bg.surface</code>, <em>exactement</em> le lavande de la pilule : quand une carte
        passe sous la barre révélée, la pilule perd son contour et il ne reste que la pastille blanche
        de l'onglet courant. Et la carte pose son eyebrow — l'année et le client — à 64px de son haut,
        sous une barre qui en fait 88 : il passe entièrement derrière elle. Mesuré, pas supposé. À
        trancher côté Figma : soit le composant reçoit un fond, soit on acte que la barre flotte et
        que ces deux états sont voulus.
      </p>

      <h3>Ses deux comportements</h3>
      <p class="section-note">
        Ils ne sont pas une variante à déclarer : ils tombent des props. Sans <code>home</code>, pas
        d'avatar ; si <code>current</code> ne correspond à aucun lien, aucun item n'est actif.
      </p>

      <div class="family">
        <h4>Sur l'accueil <span class="ref">Figma 60:992</span></h4>
        <div class="demo demo-nav">
          <Nav links={demoLinks} action={demoAction} label="Démonstration — état d'accueil" />
        </div>
        <p class="desc">
          Pas d'avatar : on n'offre pas un retour vers la page où l'on est. Aucun item courant : l'accueil
          n'est pas un des quatre.
        </p>
      </div>

      <div class="family">
        <h4>Sur les autres pages <span class="ref">Figma 166:475</span></h4>
        <div class="demo demo-nav">
          <Nav
            links={demoLinks}
            current="#projets"
            home={{ href: '#accueil', src: withBase('/images/avatar-judith.png'), alt: 'Accueil' }}
            action={demoAction}
            label="Démonstration — état page courante"
          />
        </div>
        <p class="desc">
          L'avatar ramène à l'accueil, l'item de la page porte la pastille. Survolez un autre onglet :
          elle s'y rend en <code>--motion-duration-default</code>, puis revient.
        </p>
      </div>

      <h3>Props</h3>
      <div class="table-scroll">
        <table>
          <thead>
            <tr><th>Prop</th><th>Type</th><th>Défaut</th><th>Rôle</th></tr>
          </thead>
          <tbody>
            {
              navProps.map(([nom, type, defaut, role]) => (
                <tr>
                  <td><code>{nom}</code></td>
                  <td><code>{type}</code></td>
                  <td>{defaut}</td>
                  <td>{role}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h3>Collée, elle s'efface</h3>
      <p class="section-note">
        Avec <code>sticky</code>, la barre tient le haut de l'écran, glisse vers le haut quand on
        descend et revient quand on remonte. Le comportement est le même à toutes les largeurs : il ne
        dépend d'aucun point de rupture.
      </p>
      <p class="demo-note">
        Il n'y a pas de démonstration ici, et ce n'est pas un oubli : une barre qui se juge sur le
        défilement d'une page entière ne se montre pas dans une section de doc, et elle lit
        {' '}<code>scrollY</code> — dans une boîte qui défile, elle ne bougerait pas. Elle est en situation
        sur le <a href={withBase('/templates/home')}>gabarit</a>.
      </p>

      <h3>Ce que la page doit porter</h3>
      <p>
        La barre doit être <strong>hors</strong> du bloc qu'elle surplombe, et il faut les deux raisons
        pour comprendre pourquoi. Un élément collé est un contexte d'empilement : rien de ce qu'il
        contient ne peut se peindre devant ce qui le recouvre, donc une barre restée dedans serait
        condamnée à passer sous les cartes, quel que soit son <code>z-index</code>. Et
        {' '}<code>Case Study List</code> rend ce bloc inerte quand il est recouvert, ce qui sortirait ses
        onglets du clavier au moment même où elle est la seule chose encore visible.
      </p>
      <pre><code>{`<Nav sticky … />        <!-- hors de .home-first, pas dedans -->

.home       { --fold-peek: 90px; }
.home-first { position: sticky;
              top: var(--nav-height);
              height: calc(100svh - var(--fold-peek) - var(--nav-height)); }`}</code></pre>
      <p>
        <code>top: var(--nav-height)</code> et non <code>0</code> : sinon l'intro glisserait derrière
        une barre qui n'a pas de fond pendant les cent premiers pixels, avant que le masquage ne
        s'enclenche. La barre reste dans le flux — un élément collé garde sa place — donc le premier
        écran fait toujours <code>100svh</code> moins le liseré en tout, et celui-ci ne bouge pas d'un
        pixel.
      </p>
      <p>
        <strong>La page ne déclare pas <code>--nav-height</code>, elle la lit.</strong> C'est un
        token comme un autre — <code>nav.height</code>, 88 dans les modes Desktop et Tablet, 72 dans
        Mobile — donc une décision de dessin qui se prend dans Figma et se ré-exporte, pas un calcul
        posé dans une page. Une page cale son premier écran sous la barre sans rien savoir de ce qui
        la compose. La hauteur se lit et ne se mesure pas : la
        mesurer en JavaScript ferait sauter la carte au chargement, pour la raison déjà écrite sur la
        pile. Les ancres, elles, peuvent l'être : le composant pose lui-même
        {' '}<code>scroll-padding-top</code> sur la page, parce que ce décalage n'a de conséquence qu'au
        moment où l'on suit un lien, et que rien ne bouge au chargement.
      </p>

      <div class="table-scroll">
        <table>
          <thead>
            <tr><th>Variable</th><th>Défaut</th><th>Rôle</th></tr>
          </thead>
          <tbody>
            {
              navVars.map(([nom, defaut, role]) => (
                <tr>
                  <td><code>{nom}</code></td>
                  <td><code>{defaut}</code></td>
                  <td>{role}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h3>Ce que la maquette ne dit pas</h3>
      <ul class="plain token-list">
        <li>
          <p class="desc">
            <strong>Le sens du défilement est du JavaScript, le mouvement non.</strong> Le script
            compare deux positions de <code>scrollY</code> d'une image à l'autre, jamais un geste. Un
            {' '}<code>wheel</code> dirait la main ; il ne dirait rien d'un saut — touche Origine, clic sur
            une ancre, <code>scrollTo</code> — qui ramène la page en haut sans que personne n'ait
            touché la molette. Deux positions comparées disent les deux : remonter, c'est remonter,
            quelle qu'en soit la cause. C'est aussi ce qui rend le tactile et la souris identiques sans
            écrire un seul cas particulier.
          </p>
        </li>
        <li>
          <p class="desc">
            <strong>La barre masquée reste atteignable au clavier, et le focus l'épingle.</strong> Elle
            n'est jamais rendue <code>inert</code> : inerte, elle ne pourrait plus recevoir le focus,
            donc plus jamais se révéler en le recevant, et le seul repère de navigation de la page
            disparaîtrait des lecteurs d'écran sur un critère de position de défilement. Épinglée plutôt
            que simplement révélée, parce qu'une barre seulement révélée se remasquerait au défilement
            suivant, l'anneau de focus avec elle — c'est ce que WCAG 2.4.11 interdit. La pile résout le
            même problème par l'autre bout : là on retire ce qui est couvert, ici on découvre ce qu'on
            atteint.
          </p>
        </li>
        <li>
          <p class="desc">
            <strong>Elle écrit le seul <code>z-index</code> du système.</strong> Partout ailleurs les
            couches se peignent dans l'ordre du DOM, et c'est ce qu'on veut : la carte écrite après
            recouvre celle d'avant. La barre est le cas contraire — écrite avant tout le reste, elle
            doit se peindre après, sans quoi la révéler derrière une carte opaque ne révélerait rien.
            {' '}<code>1</code>, et non <code>10</code> : le plus petit nombre qui suffit, et qui ne laisse
            pas croire que le système a une échelle d'élévation. Il n'en a pas.
          </p>
        </li>
        <li>
          <p class="desc">
            <strong>Le seuil et le grain ne sont pas des valeurs de dessin.</strong> Le seuil de 100px
            vient de la consigne ; le grain de 6px est une tolérance d'appareil, de la même famille que
            les 2px que la pile accorde à l'arrondi sous-pixel. Aucun token ne les porte, et c'est
            volontaire : Figma ne dessine pas l'inertie d'un trackpad.
          </p>
        </li>
        <li>
          <p class="desc">
            <strong>Elle a un repli.</strong> Sans JavaScript, <code>sticky</code> donne une barre qui
            colle et ne s'efface jamais. On perd le mouvement, pas la navigation.
          </p>
        </li>
        <li>
          <p class="desc">
            <strong>La pastille est du JavaScript.</strong> Le script mesure l'onglet visé et écrit sa
            géométrie en variables CSS ; le mouvement, lui, reste au CSS. Elle suit le survol
            {' '}<em>et</em> le focus clavier.
          </p>
        </li>
        <li>
          <p class="desc">
            <strong>Elle a un repli.</strong> Sans JavaScript, l'onglet courant garde son fond blanc et
            le survol son aplat lavande — le comportement d'avant la pastille. C'est le script qui pose
            {' '}<code>data-slider-ready</code> et neutralise ces deux aplats.
          </p>
        </li>
        <li>
          <p class="desc">
            <strong>Sous 768px</strong>, les icônes et le bouton d'action s'effacent, l'avatar reste — il
            est le chemin de retour — et la pilule défile si les onglets ne tiennent plus.
          </p>
        </li>
        <li>
          <p class="desc">
            <strong>Sous <code>prefers-reduced-motion</code></strong>, la pastille se repositionne d'un
            coup : ce sont les durées des tokens qui tombent à zéro, le composant n'a rien à savoir de la
            préférence.
          </p>
        </li>
      </ul>
    </section>

    <!-- ── Card ─────────────────────────────────────────────────────────── -->
    <section>
      <h2>Card</h2>

      <p class="section-note">
        <strong>Ce qu'elle est.</strong> Une fiche qui présente une chose : son image, une rangée
        de tags, son titre, son sous-titre, une ligne d'informations secondaires, puis deux autres
        emplacements libres — une seconde rangée de tags et les actions. Verticale ou horizontale,
        c'est la même fiche.
        <br />
        <strong>Ce qu'elle n'est pas.</strong> Ni la carte d'étude de cas — celle-là est une feuille
        pleine largeur qui monte du bas de la page, avec sa phrase d'impact et son carrousel, et elle
        est plus bas — ni un bouton : la carte entière ne se clique pas, et rien n'y est un lien. Ce
        qui mène quelque part se pose dans l'emplacement <code>actions</code>, et c'est un
        {' '}<em>Button</em>.
        <br />
        <span class="source">
          Figma <code>334:1129</code>. Le composant n'a pas de description : ce qui précède est lu sur
          le dessin, pas sur le fichier — voir plus bas.
        </span>
      </p>

      <div class="demo demo-card">
        <div class="card-stand">
          <Card
            title={cardDemo.title}
            subtitle={cardDemo.subtitle}
            meta={cardDemo.meta}
            image={cardDemo.image}
            headingLevel={3}
          >
            <Fragment slot="tags-top">
              {cardDemo.tagsTop.map((t) => <Tag>{t}</Tag>)}
            </Fragment>
            <Fragment slot="tags">
              {cardDemo.tags.map((t) => <Tag>{t}</Tag>)}
            </Fragment>
            <Fragment slot="actions">
              <Button size="sm" variant="secondary" iconEnd="arrow-narrow-right">
                {cardDemo.action.label}
              </Button>
            </Fragment>
          </Card>
        </div>
      </div>

      <h3>Les deux orientations</h3>
      <p class="section-note">
        <strong>Verticale, l'image est en tête et prend toute la largeur de la carte.</strong>
        {' '}Horizontale, elle occupe la moitié gauche et le texte se centre en face, sur sa hauteur.
        C'est la seule différence : mêmes marges, mêmes espacements, même dessin du texte. Le
        contenu ci-dessus et ci-dessous est le même.
      </p>

      <div class="demo demo-card">
        <div class="card-stand-wide">
          <Card
            orientation="horizontal"
            title={cardDemo.title}
            subtitle={cardDemo.subtitle}
            meta={cardDemo.meta}
            image={cardDemo.image}
            headingLevel={3}
          >
            <Fragment slot="tags-top">
              {cardDemo.tagsTop.map((t) => <Tag>{t}</Tag>)}
            </Fragment>
            <Fragment slot="tags">
              {cardDemo.tags.map((t) => <Tag>{t}</Tag>)}
            </Fragment>
            <Fragment slot="actions">
              <Button size="sm" variant="secondary" iconEnd="arrow-narrow-right">
                {cardDemo.action.label}
              </Button>
            </Fragment>
          </Card>
        </div>
      </div>

      <p class="section-note">
        <strong>La carte prend la largeur qu'on lui donne</strong> — c'est la page qui décide, comme
        pour la carte d'étude de cas. Les deux cadres ci-dessus ne montrent donc pas une largeur du
        composant mais celle que Figma lui dessine : <code>337</code> pour la verticale, le plafond de
        {' '}<code>768</code> pour l'horizontale.
        <br />
        <strong>Sous 768px, l'horizontale repasse en colonne.</strong> Figma la borne à
        {' '}<code>560</code> de large au minimum, et deux colonnes ne tiennent pas dans un téléphone de
        390. Ce cas n'est pas dessiné : c'est une décision du code, prise au seul point de rupture du
        système.
      </p>

      <h3>Les deux tailles de titre</h3>
      <p class="section-note">
        <strong>Le titre descend d'un cran quand la carte n'est pas la chose la plus grosse de la
        page.</strong> <code>titleSize="title"</code> est le défaut et la maquette : la taille d'un
        {' '}<code>h2</code>, <code>2rem</code>. <code>titleSize="heading"</code> prend celle d'un
        {' '}<code>h4</code>, <code>1.25rem</code> — pour une grille serrée, ou sous un titre de page
        qui doit rester devant.
        <br />
        <strong>Seule la taille change.</strong> La police, la graisse, l'interligne et
        l'interlettrage suivent d'eux-mêmes : l'interligne est un ratio et l'interlettrage est en
        {' '}<code>em</code>, donc les deux se recalculent sur la nouvelle taille. Un titre en
        {' '}<code>heading</code> est exactement un <code>h4</code> du système, et pas un titre de
        carte rapetissé.
        <br />
        <strong>Ce n'est pas <code>headingLevel</code>.</strong> Le rang dit où le titre se range
        dans le plan du document, la taille dit ce qu'on voit. Les deux sont restés séparés depuis
        le début — une carte peut être un <code>h2</code> en petit, ou un <code>h4</code> en gros,
        et rien dans le composant ne les lie.
      </p>

      <div class="demo demo-card">
        <div class="card-stand">
          <Card
            title={cardDemo.title}
            subtitle={cardDemo.subtitle}
            meta={cardDemo.meta}
            image={cardDemo.image}
            headingLevel={3}
            titleSize="heading"
          >
            <Fragment slot="tags-top">
              {cardDemo.tagsTop.map((t) => <Tag>{t}</Tag>)}
            </Fragment>
            <Fragment slot="tags">
              {cardDemo.tags.map((t) => <Tag>{t}</Tag>)}
            </Fragment>
            <Fragment slot="actions">
              <Button size="sm" variant="secondary" iconEnd="arrow-narrow-right">
                {cardDemo.action.label}
              </Button>
            </Fragment>
          </Card>
        </div>
      </div>

      <p class="section-note">
        <strong>La bascule ne réécrit pas la taille du titre, elle repose
        {' '}<code>--card-title-size</code> sur la carte.</strong> L'endroit qui décide reste donc
        unique, et l'alias <code>card.title.size</code> sert enfin à ce pour quoi il avait été gardé :
        être le point où la typographie d'une carte bouge sans emporter les titres de page.
      </p>

      <h3>Les trois emplacements</h3>
      <p class="section-note">
        <strong>Les tags et les actions ne sont pas des props, ce sont des slots nommés</strong> — les
        mêmes que dans Figma. La carte ne pose que la rangée qui les tient : les tags se replient sur
        plusieurs lignes, les actions se calent à droite. Ce qu'on y met se dessine tout seul.
        <br />
        <strong>Les tags ont deux rangées, et seule leur place les distingue.</strong>
        {' '}<code>tags-top</code> passe au-dessus du titre, avant tout le texte ;
        {' '}<code>tags</code> reste sous les informations secondaires. Le dessin des deux est
        exactement le même — même rentrée de 16, même écart de 8, même repli — et c'est voulu : deux
        rangées de pilules qui ne se ressembleraient pas seraient deux objets, pas un emplacement
        dédoublé.
        <br />
        <strong>Ce qui va dans l'une plutôt que dans l'autre reste à écrire.</strong> La maquette met
        les mêmes tags aux deux endroits, donc elle ne tranche pas ; la doc, elle, montre une
        catégorie en haut et les méthodes en bas, parce que c'est la lecture la plus évidente de deux
        rangées superposées. Ce n'est pas une règle que le composant tient — c'est une doctrine, au
        même titre que « des Tag et rien d'autre ».
        <br />
        <strong>Un emplacement vide n'existe pas</strong> : sans tag, la rangée des tags n'est pas
        rendue, et l'espacement du corps ne lui compte pas de place. C'est ce que dit Figma —
        {' '}<code>displayEmptyByDefault: false</code>.
        <br />
        <strong>Figma restreint l'emplacement des tags aux Tag</strong> et laisse celui des actions
        ouvert. Le code ne peut pas imposer la première règle ; elle reste une doctrine. Dans le
        fichier, l'action est un <em>Button</em> secondaire de taille <code>sm</code>, réduit à sa
        seule flèche.
      </p>

      <h3>Ce qu'elle fait quand une prop manque</h3>
      <p class="section-note">
        <strong>Seul le titre est obligatoire.</strong> Sans image, la carte ne réserve pas la place —
        elle commence au texte. Sans sous-titre, sans ligne secondaire, sans tags, sans actions : la
        ligne n'est pas rendue, et rien ne laisse un trou. Une carte réduite à son titre est une carte
        valide.
      </p>

      <h3>Props</h3>
      <div class="table-scroll">
        <table>
          <thead>
            <tr><th>Prop</th><th>Type</th><th>Défaut</th><th>Rôle</th></tr>
          </thead>
          <tbody>
            {
              cardProps.map(([nom, type, defaut, role]) => (
                <tr>
                  <td><code>{nom}</code></td>
                  <td><code>{type}</code></td>
                  <td>{defaut}</td>
                  <td>{role}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h4>Slots</h4>
      <div class="table-scroll">
        <table>
          <thead>
            <tr><th>Slot</th><th>Rôle</th></tr>
          </thead>
          <tbody>
            {
              cardSlots.map(([nom, role]) => (
                <tr>
                  <td><code>{nom}</code></td>
                  <td>{role}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h3>L'image s'adapte, elle ne commande pas</h3>
      <p class="section-note">
        <strong>C'est la carte qui donne sa place à l'image, jamais le rapport du fichier.</strong>
        {' '}<code>object-fit: cover</code> est ce qui rend ça tenable : l'image est recadrée, jamais
        déformée, et deux photos de rapports différents font exactement la même bande. Une carte ne
        change donc pas de dessin selon la photo qu'on y met.
        <br />
        <strong>Horizontale, les deux colonnes remplissent la carte</strong> — l'image et le bloc de
        contenu font sa hauteur, l'une comme l'autre. Le contenu, lui, se centre dans sa colonne :
        un titre court ne se colle pas en haut d'une carte haute, il reste au milieu. C'est
        exactement ce que Figma pose sur ce bloc.
        <br />
        <strong>La hauteur vient du plus haut des deux</strong> : le plancher de l'image, ou le
        contenu du bloc quand il le dépasse. Une carte dont le titre se replie sur trois lignes a
        donc une image aussi haute que son texte, et non une image de 256 centrée entre deux bandes
        vides.
        <br />
        <strong>Verticale, l'image est ce qui donne et reprend la hauteur.</strong> Sans consigne,
        elle vaut celle de Figma. Si une page impose une hauteur à la carte, c'est l'image qui
        absorbe le surplus ou qui se resserre — le texte, lui, ne bouge pas. C'est la même règle que
        la carte d'étude de cas, où l'en-tête est le point fixe et le carrousel cède. Une grille de
        cartes à hauteur égale aligne donc ses images sans qu'on ait à mesurer quoi que ce soit.
      </p>

      <h3>Reprendre la hauteur de l'image</h3>
      <p class="section-note">
        <strong>Un seul levier.</strong> <code>--card-media-height</code> vaut <code>324px</code> en
        vertical et <code>256px</code> en horizontal. Elle se pose en <code>style</code> sur une
        carte, ou sur un ancêtre pour toute une grille. Le reste ne se reprend pas — une carte qui
        change de marges, de rayon ou d'ombre n'est plus cette carte.
        <br />
        <strong>C'est le seul réglage du système dont le sens change d'une orientation à l'autre</strong>,
        et c'est assumé. Verticale, c'est une <em>hauteur</em> : celle que l'image prend quand rien ne
        la contraint. Horizontale, c'est un <em>plancher</em> : la hauteur vient du texte d'en face, et
        cette valeur empêche seulement une carte réduite à son titre d'écraser son image sur deux
        lignes.
      </p>

      <h3>Tokens</h3>
      <p class="section-note">
        Les {cardTokens.length} tokens <code>card.*</code> : la taille et l'encre des trois lignes de
        texte de la carte. Ils décrivent cet objet et pas le système — c'est pour ça qu'ils sont ici
        plutôt que dans <a href={withBase('/foundations')}>Fondations</a>.
        <br />
        <strong>Ce sont six alias, et c'est voulu.</strong> Aucun ne porte de valeur à lui : chacun
        renvoie à une primitive que le système avait déjà — <code>card.title.size</code> lit
        {' '}<code>font.size.title</code>, qui est aussi la taille d'un <code>h2</code>. Le token n'ajoute
        donc pas une valeur, il ajoute un <em>endroit</em> : celui où la typographie d'une carte peut
        bouger sans emporter les titres de page avec elle. C'est ce que fait déjà le groupe
        {' '}<code>button</code> avec <code>button.radius</code>, qui n'est qu'un alias de
        {' '}<code>radius.pill</code>.
        <br />
        <strong>Ils ne fixent que la taille et l'encre.</strong> La police, la graisse, l'interligne et
        l'interlettrage du titre restent ceux d'un <code>h2</code>, posés par <code>global.css</code>
        {' '}pour tous les rangs : les nommer ici aurait détaché les titres de carte de l'échelle
        typographique du système, ce qui est exactement ce qu'un design system ne doit pas laisser
        arriver par distraction.
      </p>
      <ul class="plain token-list">
        {
          cardTokens.map((t) => (
            <li>
              <code class="name">
                {t.name} — {t.resolved}
                {t.alias && <em class="alias"> ← {t.alias}</em>}
              </code>
              {t.description && <p class="desc">{t.description}</p>}
            </li>
          ))
        }
      </ul>
      <p class="section-note">
        <strong>La carte d'étude de cas ne les lit pas.</strong> Son titre et sa phrase d'impact
        portent pourtant les mêmes valeurs, et c'était l'autre partage possible. Le groupe a été
        gardé sur la fiche seule : les deux objets pourront donc diverger, et si l'un doit suivre
        l'autre, c'est une décision à reprendre — pas un oubli.
      </p>

      <h3>Ce que la maquette ne dit pas</h3>

      <p class="flag">
        <strong>Le composant n'a pas de description.</strong> C'est d'elle que sortent normalement le
        « ce qu'elle est » et le « ce qu'elle n'est pas » ; ici la doctrine ci-dessus est déduite du
        dessin et du reste du système. Elle n'engage donc que le code, et c'est l'écart le plus cher
        de cette section : deux personnes qui lisent le même dessin n'en tirent pas les mêmes
        interdits. Une description dans Figma les trancherait pour de bon.
      </p>

      <p class="flag">
        <strong>Deux noms à reprendre.</strong> Le composant s'appelle <code>Cards</code> au pluriel,
        avec une espace finale — un nom de tiroir, pas un nom d'objet : le code le nomme
        {' '}<code>Card</code>. Et la propriété qui commande les deux variantes s'appelle
        {' '}<code>Property 1</code>, ce qui ne dit rien de ce qu'elle fait : le code la nomme
        {' '}<code>orientation</code>. Les deux se renomment côté Figma.
      </p>

      <p class="flag">
        <strong>La seconde taille de titre n'est pas dessinée.</strong> Le fichier ne connaît que
        {' '}<code>heading/title</code> sur ce nœud — <code>334:1122</code>, lié à
        {' '}<code>card/title/size</code> — et <code>titleSize="heading"</code> n'a donc aucun frame
        qui le montre. C'est une décision du code, comme le passage en colonne sous 768px : la
        maquette n'est pas en retard, elle n'a simplement jamais eu à trancher ce cas. Elle le
        deviendrait le jour où une vue publie les deux tailles côte à côte — c'est ce jour-là qu'un
        second frame vaudrait la peine, pas avant.
      </p>

      <p class="flag">
        <strong>La rangée de tags du haut n'est pas un slot.</strong> Dans le fichier, c'est un frame
        nommé <code>Frame 6</code> — <code>392:1075</code> en vertical, <code>392:1076</code> en
        horizontal — qui contient deux instances de <em>Tag</em>, là où la rangée du bas est un vrai
        slot nommé <code>Tags</code>. L'emplacement n'est donc pas remplissable dans la maquette, et
        il n'a pas de nom : <code>tags-top</code> est une décision du code, comme
        {' '}<code>orientation</code> l'a été. Le geste tient en deux réglages — convertir le frame en
        slot, le nommer.
        <br />
        <strong>Et les deux rangées y portent le même contenu témoin</strong>, quatre fois
        {' '}<em>Accent</em>. Rien dans le dessin ne dit donc ce qui va en haut plutôt qu'en bas : la
        doctrine écrite plus haut est déduite, pas lue. C'est le même manque que la description
        absente, en plus petit.
      </p>

      <p class="flag">
        <strong>Le fond blanc de la carte n'est lié à aucune variable.</strong> La valeur est
        exactement celle de <code>color.bg.default</code>, et c'est ce que le code écrit — mais rien
        dans le fichier ne le dit, et un changement de la variable ne repeindrait pas la maquette. Il
        manque une liaison, pas un token.
      </p>

      <p class="section-note">
        <strong>Les deux ombres sont des tokens.</strong> <code>shadow/md</code> pour la carte,
        {' '}<code>shadow/lg</code> pour l'image — la même que les vignettes du carrousel, et
        maintenant lue au même endroit par les deux. Figma n'ayant pas de type de variable « ombre »,
        chaque morceau est nommé seul — décalage, flou, étendue, couleur — puis lié à la couche dans
        le fichier. <code>npm run tokens</code> les remet bout à bout. Le dessin et le code lisent
        donc la même valeur, et plus rien ne peut diverger.
      </p>

      <p class="flag">
        <strong>Figma centrerait l'image là où le code l'étire.</strong> Dans le fichier, l'image de
        la carte horizontale est haute de <code>256</code> et la carte s'ajuste à son contenu : les
        deux tombent juste parce que le texte de la maquette fait exactement cette hauteur. Avec un
        titre de vraie longueur, l'auto-layout laisserait l'image à 256 et la centrerait entre deux
        bandes vides — ce que le code refuse de faire. L'écart ne se voit donc pas sur le nœud tel
        qu'il est dessiné aujourd'hui, et c'est bien pour ça qu'il est écrit ici. Le geste côté
        Figma tient en un réglage : passer la hauteur de l'image en <em>fill</em>, comme sa largeur.
      </p>

      <p class="flag">
        <strong>La hauteur de l'image n'a pas de token</strong> — <code>324</code> en vertical,
        {' '}<code>256</code> en horizontal. Elle est hissée en <code>--card-media-height</code>, qui est
        aussi le point de surcharge public de la carte. Aucun groupe de tokens ne décrit une hauteur
        de média ; l'ouvrir pour deux nombres serait prématuré, mais un troisième le rendrait
        nécessaire.
      </p>

      <p class="flag">
        <strong>L'écart entre deux actions vaut <code>space.xs</code></strong>, là où l'en-tête
        d'étude de cas desserre le sien pour tenir WCAG 2.5.8. La règle n'est pas contredite : les
        boutons d'action mesurent au moins <code>button.height.sm</code>, soit 44px, et une cible de
        44px satisfait 2.5.8 par sa taille sans rien demander à sa marge. Ce serait faux si
        l'emplacement recevait des cibles plus petites — c'est une raison de plus pour n'y mettre que
        des boutons.
      </p>
    </section>

    <!-- ── Case Study Card ──────────────────────────────────────────────── -->
    <section>
      <h2>Case Study Card</h2>

      <p class="section-note">
        <strong>Ce qu'elle est.</strong> Une étude de cas présentée en pleine largeur : l'année et le
        client, le titre, la phrase d'impact, les méthodes, le lien vers l'étude — puis les images du
        projet, qui défilent.
        <br />
        <strong>Ce qu'elle n'est pas.</strong> Ni une vignette dans une grille — les coins bas carrés
        et l'ombre projetée vers le haut disent une feuille qui monte depuis le bas de la page, pas une
        boîte posée au milieu — ni une galerie : le carrousel montre le travail, il ne le remplace pas.
        La carte ne connaît ni les études de cas ni leurs URLs ; tout tombe des props.
        <br />
        <span class="source">Figma <code>88:131</code>, en situation <code>176:1248</code>.</span>
      </p>

      <div class="demo demo-case-study">
        <CaseStudyCard
          eyebrow={caseStudyDemo.eyebrow}
          title={caseStudyDemo.title}
          impact={caseStudyDemo.impact}
          tags={caseStudyDemo.tags}
          action={caseStudyDemo.action}
          images={caseStudyImages}
          headingLevel={3}
        />
      </div>

      <p class="section-note">
        La carte prend la largeur de son conteneur : c'est la page qui décide si elle est pleine
        largeur, la carte ne le sait pas. Ici elle est bornée par le cadre de démonstration.
      </p>

      <h3>Props</h3>
      <div class="table-scroll">
        <table>
          <thead>
            <tr><th>Prop</th><th>Type</th><th>Défaut</th><th>Rôle</th></tr>
          </thead>
          <tbody>
            {
              caseStudyCardProps.map(([nom, type, defaut, role]) => (
                <tr>
                  <td><code>{nom}</code></td>
                  <td><code>{type}</code></td>
                  <td>{defaut}</td>
                  <td>{role}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h3>Ses deux moitiés, utilisables seules</h3>

      <div class="family">
        <h4>L'en-tête <span class="ref">Figma 88:74</span></h4>
        <div class="demo demo-header">
          <CaseStudyHeader
            eyebrow={caseStudyDemo.eyebrow}
            title={caseStudyDemo.title}
            impact={caseStudyDemo.impact}
            tags={caseStudyDemo.tags}
            action={caseStudyDemo.action}
            headingLevel={5}
          />
        </div>
        <p class="desc">
          Le titre et le bouton partagent une ligne et s'alignent sur leur bas. Rétrécissez la fenêtre :
          sous 320px de titre, le bouton passe dessous plutôt que d'écraser le titre. Ses props sont
          celles de la carte, moins <code>images</code> et <code>imagesLabel</code> — la carte ne fait
          que les lui passer.
        </p>
      </div>

      <div class="family">
        <h4>Le carrousel <span class="ref">Figma 88:85</span></h4>
        <div class="demo demo-carousel">
          <Carousel items={caseStudyImages} label="Démonstration — images du projet" />
        </div>
        <p class="desc">
          Les flèches sont posées par-dessus les images, collées aux deux bords et centrées sur la
          hauteur de la piste. Elles avancent d'une vignette et se désactivent en bout de piste. La
          piste défile aussi au doigt, au trackpad et au clavier — tabulez jusqu'à elle, puis flèches
          gauche et droite.
        </p>
      </div>

      <h3>Props du carrousel</h3>
      <div class="table-scroll">
        <table>
          <thead>
            <tr><th>Prop</th><th>Type</th><th>Défaut</th><th>Rôle</th></tr>
          </thead>
          <tbody>
            {
              carouselProps.map(([nom, type, defaut, role]) => (
                <tr>
                  <td><code>{nom}</code></td>
                  <td><code>{type}</code></td>
                  <td>{defaut}</td>
                  <td>{role}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h3>Ce que la maquette ne dit pas</h3>
      <ul class="plain token-list">
        <li>
          <p class="desc">
            <strong>Les flèches sont une commodité.</strong> Elles sont masquées dans le HTML et c'est
            le script qui les révèle — puis les masque à nouveau si tout tient dans la largeur. Sans
            JavaScript la piste défile déjà, et sa barre de défilement reste visible : c'est alors la
            seule chose qui dit que ça défile.
          </p>
        </li>
        <li>
          <p class="desc">
            <strong>Une barre posée par-dessus une zone qui défile doit se laisser traverser.</strong>
            {' '}Figma pose la nav en absolu sur toute la largeur de la piste, mais ne dit rien de ce qu'il
            advient des gestes : telle quelle, cette bande avalerait le défilement au doigt et à la
            molette au milieu des images — une panne qu'on ne voit pas en cliquant les flèches. Elle
            est donc en <code>pointer-events: none</code>, et chaque flèche le reprend pour son compte
            dans son attribut <code>style</code>, faute qu'un style scopé d'Astro atteigne la racine
            d'un composant enfant.
          </p>
        </li>
        <li>
          <p class="desc">
            <strong>Le focus ne se perd pas.</strong> Quand une flèche se désactive sous le focus, le
            script le déplace sur l'autre plutôt que de le laisser retomber sur le
            {' '}<code>&lt;body&gt;</code>.
          </p>
        </li>
        <li>
          <p class="desc">
            <strong>C'est le seul composant qui lit <code>prefers-reduced-motion</code>.</strong> Le
            {' '}<code>behavior: 'smooth'</code> du défilement n'est pas une durée : <code>tokens.css</code>
            {' '}ne peut pas le remettre à zéro comme il le fait des <code>motion.duration.*</code>. Le
            script bascule donc lui-même sur <code>'auto'</code>.
          </p>
        </li>
        <li>
          <p class="desc">
            <strong>Sous 768px</strong>, les marges de 48px tomberaient à la moitié d'un écran de 390 :
            elles passent à <code>--space-xl</code>, le titre à <code>--font-size-subtitle</code> et la
            piste à <code>272px</code>, ce qui laisse aux vignettes les 240px qu'elles avaient déjà.
            {' '}<strong>Et les tags s'effacent</strong>, comme les icônes et l'action du Nav au même point
            de rupture : c'est ce que la maquette mobile dessine, et ce n'est pas qu'une économie de
            place. Trois méthodes qui se replient sur trois lignes dans une colonne de 390 pèsent
            {' '}<code>119px</code> — un tiers de l'en-tête — pour une information de second plan, lue
            après le titre et l'impact. <code>display: none</code> et non un masquage visuel : ces
            tags ne font pas partie de la vue mobile, ils n'ont donc à rester ni dans l'ordre de
            tabulation ni dans l'arbre d'accessibilité.
          </p>
        </li>
      </ul>

      <p class="flag">
        <strong>La carte accepte qu'on lui impose sa hauteur.</strong> Par défaut elle fait la taille
        de son contenu — 735 px à 1280 px de large, ce que Figma dessine.
        {' '}<code>--card-height</code>, posée depuis l'extérieur, la borne : c'est ainsi que
        {' '}<em>Case Study List</em> lui fait remplir un écran entier, donc en recouvrir vraiment une
        autre. Une hauteur et non un plancher, sans quoi la carte grandirait au-delà de l'écran dès
        que son contenu dépasse, et son bas resterait hors d'atteinte une fois la carte collée en
        haut. Bornée, elle passe l'écart au carrousel — c'est lui qui prend ou rend la place, jamais
        l'en-tête.
      </p>

      <p class="section-note">
        <strong>Les ombres sont des tokens.</strong> <code>shadow/lg</code> sur les vignettes,
        {' '}<code>shadow/lg-invert</code> sur la carte. Les variables locales
        {' '}<code>--card-shadow</code> et <code>--carousel-item-shadow</code> restent, mais elles ne
        portent plus de valeur : elles donnent un nom au rôle, et évitent qu'une carte imbriquée dans
        une autre hérite de l'ombre du dessus — les deux composants emploient le même nom pour deux
        ombres différentes.
      </p>

      <p class="flag">
        <strong>Les deux ombres de la carte divergent.</strong> Le composant <code>88:131</code> déclare
        {' '}<code>0 -30px 30px -14px</code> ; l'instance d'exemple <code>176:1248</code> déclare
        {' '}<code>0 -22px 48px -12px</code>. Le code suit le composant — c'est lui la spécification, l'autre
        est une surcharge locale. À réaligner côté Figma.
      </p>

      <p class="flag">
        <strong>L'eyebrow contredit le système.</strong> Figma le dessine en Inter semibold ;
        {' '}<code>global.css</code> réserve cette forme — 13px, capitales, interlettrage large — au
        {' '}<code>h6</code>, en Poppins bold. Le code suit Figma et ne rend donc pas un <code>h6</code> :
        ce n'est de toute façon pas un titre mais une ligne de contexte au-dessus du titre. À trancher
        côté Figma : ou l'eyebrow rentre dans le rang, ou le système reconnaît deux eyebrows.
      </p>

      <p class="flag">
        <strong>Deux écarts d'espacement.</strong> Figma pose <code>33px</code> entre les vignettes et
        {' '}<code>10px</code> entre les tags. Aucun token ne porte ces deux valeurs : la première devient
        {' '}<code>--space-2xl</code> (32), la seconde <code>--space-md</code> (12) — on n'a jamais intérêt à
        resserrer l'écart entre deux cibles voisines (WCAG 2.5.8).
      </p>

      <p class="flag">
        <strong>Le Slot Figma accepte tout, le carrousel n'accepte que des images.</strong> La piste
        prend un tableau <code>items</code> plutôt qu'un slot : la hauteur, le rayon et l'ombre des
        vignettes sont l'affaire du carrousel, et les styles scopés d'Astro n'atteignent pas un contenu
        slotté. Même coupure que le Nav, qui prend un tableau <code>links</code>. Le jour où une
        vignette n'est plus une image, c'est le composant qu'il faut rouvrir.
      </p>

      <p class="flag">
        <strong>L'en-tête est le point fixe, le carrousel est ce qui bouge.</strong> Figma fige la
        piste à <code>442px</code> — le Slot de <code>88:143</code>, marges comprises — dont
        {' '}<code>410</code> pour les images. C'est la hauteur d'où l'on part. Mais dans une carte dont la
        hauteur est imposée, comme dans <em>Case Study List</em> où une carte fait exactement un
        écran, le carrousel prend ou rend tout ce qui reste, et les vignettes le suivent : c'est la
        piste qui porte la hauteur, l'image la remplit. L'en-tête, lui, ne bouge pas — il est protégé
        par la taille minimale automatique des boîtes flexibles, que le carrousel lève sur lui-même
        par <code>min-height: 0</code>. Montré seul, hors de toute carte, le carrousel garde ses
        {' '}<code>442</code>.
      </p>

      <p class="flag">
        <strong>Trois coquilles dans le texte de la maquette.</strong> L'exemple Figma écrit
        « deployements », « langages » et « Raoadmap ». La démo ci-dessus les corrige ; Figma reste à
        corriger.
      </p>
    </section>
    <!-- ── Intro ────────────────────────────────────────────────────────── -->
    <section>
      <h2>Intro</h2>

      <p class="section-note">
        <strong>Ce qu'il est.</strong> L'ouverture d'une page d'accueil : un visage, une salutation, la
        phrase qui dit ce qu'on fait, et le bouton qui mène à la suite. Un seul par page — c'est lui qui
        porte le <code>h1</code>.
        <br />
        <strong>Ce qu'il n'est pas.</strong> Ni un en-tête de section — ça, c'est
        {' '}<em>CaseStudyHeader</em>, qui ouvre une carte et non une page — ni un porteur de contenu : le
        visage, les textes et la destination du bouton tombent tous des props, parce qu'ils
        appartiennent au site et pas au système.
        <br />
        <span class="source">Nœud Figma <code>209:2348</code>, « Section.Intro ».</span>
      </p>

      <div class="demo demo-intro">
        <Intro
          avatar={introDemo.avatar}
          greeting={introDemo.greeting}
          headline={introDemo.headline}
          description={introDemo.description}
          action={introDemo.action}
          headingLevel={2}
        />
      </div>

      <h3>Props</h3>
      <div class="table-scroll">
        <table>
          <thead>
            <tr><th>Prop</th><th>Type</th><th>Défaut</th><th>Rôle</th></tr>
          </thead>
          <tbody>
            {
              introProps.map(([nom, type, defaut, role]) => (
                <tr>
                  <td><code>{nom}</code></td>
                  <td><code>{type}</code></td>
                  <td>{defaut}</td>
                  <td>{role}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="flag">
        <strong>L'écart sous le bloc de texte se laisse resserrer.</strong> Figma pose
        {' '}<code>space.layout.64</code> entre le bloc et le bouton, et c'est ce que l'intro garde partout
        — mais la valeur est <em>lue</em> dans <code>--intro-gap</code>, jamais déclarée sur
        {' '}<code>.intro</code>, pour qu'une valeur posée sur un ancêtre passe au travers. C'est le seul
        endroit de l'intro où il y a de l'air à reprendre, et une page qui cale son premier écran sur
        la hauteur de la fenêtre en a besoin : sous 690 px, le gabarit le ramène à
        {' '}<code>space.xl</code> pour que l'intro tienne dans ce qu'on lui laisse. Déclarer la variable
        sur <code>.intro</code> battrait l'héritage et le point de surcharge ne servirait à rien.
      </p>

      <p class="flag">
        <strong>Les tailles sont liées, les couleurs ne le sont pas.</strong> Les trois calques
        portent maintenant un style de texte — <code>body/hero</code>, <code>heading/display</code>,
        {' '}<code>body/lead</code> — et deux des trois tailles tombent d'une variable. Les
        {' '}<em>couleurs</em>, elles, restent tapées à la main : noir pur, <code>#2f2d2e</code> et
        {' '}<code>#666</code>. Les deux premières valent par chance <code>color.text.default</code> ; la
        troisième, non — le gris du système est <code>#6a676d</code>. Le code prend le token, donc la
        description ne s'affiche pas dans le gris de la maquette. À lier côté Figma, c'est le dernier
        morceau.
      </p>

      <p class="flag">
        <strong>Le style <code>heading/display</code> se contredit.</strong> Sa description annonce
        « line-height.tight + letter-spacing.tight » ; ses valeurs disent <code>1.23</code> et
        {' '}<code>0</code>. C'est la note qui a tort, pas le style : <code>heading/title</code>, lui, est
        bien serré. Le code suit les valeurs — <code>global.css</code> desserre le <code>h1</code>, et
        le composant ne surcharge plus rien. Deux choses restent à faire côté Figma : réécrire la
        description, et décider si <code>1.23</code> mérite un cran dans l'échelle. Faute de quoi le
        code prend <code>line-height.snug</code> (1.2), soit 1,3px de moins par ligne.
      </p>

      <p class="flag">
        <strong>Le titre en mobile tient, mais pas jusqu'au plancher déclaré.</strong> La variante
        mobile de <code>142:1354</code> garde <code>42px</code> dans un cadre de 390px, et le code la
        suit : « collaborative », le mot le plus long, mesure 289px et passe jusqu'à 337px de large.
        En dessous il sort de l'écran, alors que le fichier déclare toujours son plancher à 320px
        (<code>layout/mobile</code>). Le composant pose donc un filet sous 360px — la largeur du plus
        étroit des téléphones courants. Ce n'est pas le point de rupture du système (767px) : il ne
        change pas de mise en page, il empêche un mot de déborder. À trancher côté Figma : ou la
        variante mobile descend jusqu'à 320, ou le plancher remonte.
      </p>

      <p class="flag">
        <strong>La mesure du bloc n'a pas de token.</strong> Figma la donne en dur —
        {' '}<code>929px</code>, minimum <code>280px</code>. Le composant la pose en variable locale
        {' '}<code>--intro-measure</code>, comme la carte d'étude de cas pose <code>--header-title-min</code>.
        Le jour où le système nomme ses mesures de texte, ces deux-là rentrent dans le rang.
      </p>
    </section>

    <!-- ── Case Study List ──────────────────────────────────────────────── -->
    <section>
      <h2>Case Study List</h2>

      <p class="section-note">
        <strong>Ce qu'il est.</strong> Les études de cas empilées, une par écran. Chaque carte est une
        couche collée en haut : elle monte par-dessus ce qui la précède, la suivante arrive et la
        recouvre, et le geste inverse défait exactement la même chose. Tout le mouvement est celui du
        défilement natif — aucun script ne déplace quoi que ce soit.
        <br />
        <strong>Ce qu'il n'est pas.</strong> Ni une grille de vignettes — la carte prend la largeur
        entière et n'a pas de format court — ni un porteur de contenu : les études, leurs URLs et leurs
        images tombent des props. Et ce n'est pas une animation : rien n'a de durée ici, le mouvement
        est celui du doigt.
        <br />
        <span class="source">
          Page Figma <code>222:1168</code>, composant <code>222:814</code>, états empilés
          {' '}<code>222:912</code> et <code>222:1043</code>.
        </span>
      </p>

      <div class="demo demo-list">
        <p class="fold-stand-in">Le premier écran de la page — nav et intro</p>
        <CaseStudyList
          items={caseStudies.slice(0, 2).map((c) => ({ ...c, images: [] }))}
          label="Démonstration — études de cas"
          headingLevel={3}
        />
      </div>

      <p class="demo-note">
        La pile est ici en réduction, dans une boîte qui défile, et les cartes sont montrées sans leur
        carrousel : c'est ce qu'il faut pour tenir dans une page de doc. En vraie grandeur, une couche
        fait la hauteur de l'écran — <a href={withBase('/templates/home')}>voir le gabarit</a>.
      </p>

      <h3>Props</h3>
      <div class="table-scroll">
        <table>
          <thead>
            <tr><th>Prop</th><th>Type</th><th>Défaut</th><th>Rôle</th></tr>
          </thead>
          <tbody>
            {
              caseStudyListProps.map(([nom, type, defaut, role]) => (
                <tr>
                  <td><code>{nom}</code></td>
                  <td><code>{type}</code></td>
                  <td>{defaut}</td>
                  <td>{role}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h3>Ce que la page doit porter</h3>
      <p>
        Le premier écran — la nav et l'intro — est la <strong>couche du dessous</strong> de la pile :
        il tient sa place, et les cartes lui passent dessus. C'est à la page de le poser, parce que la
        liste ne peut pas mesurer ce qui est au-dessus d'elle, et que le mesurer en JavaScript ferait
        sauter la carte au chargement. Trois règles suffisent :
      </p>
      <pre><code>{`.home       { --fold-peek: 90px; }
.home-deck  { }   /* le premier écran + la pile, et rien d'autre */
.home-first { position: sticky;
              top: var(--nav-height);
              height: calc(100svh - var(--fold-peek) - var(--nav-height)); }`}</code></pre>
      <p>
        Une <em>hauteur</em>, et non un plancher : c'est elle qui garantit le liseré à toute
        hauteur d'écran. Avec <code>min-height</code>, un contenu un peu grand pousse le bloc et mange
        le liseré. Reste à donner à la liste l'id de ce bloc, par <code>covers</code>, pour qu'elle le
        rende inerte une fois recouvert.
      </p>
      <p>
        <code>.home-deck</code> n'a aucun style et n'est pas décoratif : c'est lui qui <strong>borne
        le collage</strong>. Un élément positionné se peint devant un élément qui ne l'est pas, quel
        que soit l'ordre du DOM — sans ce bloc, le premier écran resterait collé jusqu'au bas de la
        page et se peindrait par-dessus tout ce qui suit la pile. Il faut donc dire où son collage
        cesse, et c'est là où la pile s'arrête.
      </p>
      <p>
        <strong>Ces règles n'ont pas de variante mobile</strong>, et c'est voulu : le premier écran
        reste une couche à toutes les largeurs, donc le liseré est garanti partout, dès le
        chargement. La nav, elle, ne relève pas de ce bloc : elle porte son propre collage et son
        propre rang, les mêmes des deux côtés.
      </p>
      <p>
        Une dernière règle, et elle ne se devine pas : <strong>le bloc qui suit la pile doit être
        positionné</strong> — <code>position: relative</code> suffit, sans décalage. Sur une fenêtre
        courte l'intro déborde de son écran par le bas ; une carte la recouvre pendant toute la pile,
        mais en fin de page il n'y a plus de carte. Le premier écran est collé, donc positionné, et
        il se peint par-dessus un bloc qui ne l'est pas, quel que soit l'ordre du DOM. Lui donner un
        fond n'y change rien — il serait peint dans la mauvaise couche. Positionné, il passe devant :
        il devient le sol qui recouvre, comme les cartes avant lui, et sans qu'un
        {' '}<code>z-index</code> soit écrit.
      </p>
      <p>
        Le reste tombe tout seul. Le bouton de l'intro et l'onglet du Nav pointent
        {' '}<code>#projets</code>, la liste porte cette ancre, et le navigateur amène son haut à
        {' '}<code>100svh</code> moins le liseré — c'est-à-dire exactement la position « première carte
        collée en haut ». Le clic et le défilement décrivent le même état sans partager une ligne de
        code.
      </p>

      <div class="table-scroll">
        <table>
          <thead>
            <tr><th>Variable</th><th>Défaut</th><th>Rôle</th></tr>
          </thead>
          <tbody>
            {
              caseStudyListVars.map(([nom, defaut, role]) => (
                <tr>
                  <td><code>{nom}</code></td>
                  <td><code>{defaut}</code></td>
                  <td>{role}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h3>Ce que la maquette ne dit pas</h3>

      <p class="flag">
        <strong>Le 50px de Figma n'est pas le liseré.</strong> C'est l'écart entre l'intro et la liste
        au repos (<code>209:2383</code>, <code>itemSpacing: 50</code>) et le chevauchement entre cartes
        une fois empilées (<code>222:912</code>, <code>itemSpacing: −50</code>). Le liseré, lui, tombe
        tout seul dans la maquette et n'y est pas constant : <code>166px</code> au repos
        (834 − 101 − 517 − 50), <code>70px</code> une fois la première carte montée. Le code fait le
        choix inverse — un liseré <em>garanti</em> dans tous les états — parce que c'est l'intention.
        Il vaut <strong>90px</strong>, et ce nombre est un arbitrage, pas une lecture : il a été jugé
        à l'écran, et il tombe entre les <code>166</code> et les <code>70</code> que la maquette
        dessine. Il y était à 50 jusqu'au 2026-08-25 ; le déplacement rapproche le code de ce qui est
        dessiné plutôt qu'il ne l'en éloigne. Les deux lectures se rejoignent à une condition, qui est
        devenue la clé du calcul : une carte au repos occupe la hauteur de l'écran.
      </p>

      <p class="flag">
        <strong>Trois mesures de la maquette ne suivent pas.</strong> Le bloc nav + intro est dessiné à
        668px là où un liseré de 90 en demande 744 sur un écran de 834 — les 76px d'écart sont l'air
        qui manque autour de l'intro. Et les deux cartes sont dessinées à 814 et 776px là où le
        comportement en demande 834. À reprendre côté Figma : c'est le fichier qui doit rattraper le
        code, pas l'inverse.
      </p>

      <p class="flag">
        <strong>Le mouvement n'est écrit nulle part.</strong> Aucune réaction de prototypage n'est
        posée sur la page HP — les trois frames sont des captures d'états, et <code>222:1042</code>
        {' '}mime le recouvrement en <em>réordonnant</em> les cartes dans son auto-layout. C'est un
        artifice de maquette : en défilement réel rien ne se réordonne, une couche en recouvre
        simplement une autre. Le comportement ne vient donc pas du fichier mais de la consigne, et
        c'est ici qu'il est écrit.
      </p>

      <p class="flag">
        <strong>Le liseré n'a pas de token.</strong> Le cran voisin, <code>space.layout.96</code>,
        vaut 96 : ces 6px d'écart déplaceraient le liseré à chaque cran, puisqu'il entre dans le calcul
        de position. La valeur reste donc en dur, dans <code>--fold-peek</code>, comme
        {' '}<code>--card-shadow</code> et <code>--intro-measure</code> avant elle. Le jour où Figma nomme
        ce 90, il rentre dans le rang.
      </p>

      <p class="flag">
        <strong>La vignette du carrousel n'est plus figée à 410 px.</strong> Une couche fait
        exactement un écran, et la carte est bornée à cette hauteur : l'en-tête ne bouge pas, et c'est
        le carrousel qui prend ou rend la place. La vignette vaut les <code>410px</code> de Figma quand
        la fenêtre fait 735 px de haut — la hauteur naturelle de la carte — puis suit dans les deux
        sens : <code>315</code> à 640, <code>375</code> à 700, <code>509</code> à 834, <code>675</code>
        {' '}à 1000. L'image maigrit ou grossit, elle n'est jamais rognée, et rien ne sort de l'écran à
        aucune hauteur. C'est un écart avec Figma, qui fige cette hauteur : à trancher côté fichier.
      </p>

      <p class="flag">
        <strong>Le seul script pose <code>inert</code>, et rien d'autre.</strong> Une carte recouverte
        garde sa place dans l'écran : elle reste donc atteignable au clavier, et le focus se poserait
        sur un bouton invisible — l'échec WCAG 2.4.11, <em>Focus Not Obscured</em>. Le cas a été
        mesuré, pas supposé : sans le script, le bouton « Read the story » de la première carte prend
        le focus alors que la deuxième le couvre entièrement. Le script constate ce que le CSS a déjà
        fait et le dit au clavier et aux lecteurs d'écran ; il ne déplace rien et ne dessine rien.
        Sans lui, la pile marche entièrement et n'est que moins sûre au clavier — le même contrat que
        les flèches du <em>Carousel</em>.
      </p>

      <p class="flag">
        <strong>L'écart que Figma pose sous l'intro est absorbé par le centrage.</strong> Il le pose en
        {' '}<code>itemSpacing</code> sur <code>209:2383</code>, mais Figma ne dessine aucun mou : son
        premier écran fait exactement la taille de son contenu. Dès qu'on cale ce bloc sur la hauteur
        de la fenêtre, il y a du mou, et le répartir autour de l'intro vaut mieux que de tout laisser
        tomber sous elle. Sur une fenêtre basse — moins de 690 px — c'est l'inverse : l'intro se
        resserre, son grand écart interne retombe à <code>space.xl</code>. Le liseré, lui, ne cède
        jamais.
      </p>

      <p class="flag">
        <strong>La dernière carte a besoin de ce qui la suit.</strong> Le collage s'arrête au bas de la
        liste : sans rien après elle, la dernière couche traverse l'écran sans jamais s'y arrêter. Sur
        une page d'accueil, la section suivante fait cette butée — le composant n'invente pas un vide
        pour la remplacer.
      </p>

      <p class="flag">
        <strong>Le premier écran est une couche, pas un décor.</strong> La nav et l'intro restent en
        place, et la première carte vient <em>par-dessus</em> elles — c'est la maquette
        {' '}<code>222:907</code>, où la nav n'est nulle part en haut de l'écran. Elles gardent donc leur
        place dans la page tout en étant invisibles, ce qui les laisserait atteignables au clavier :
        d'où <code>covers</code>, et le <code>inert</code> que le script leur pose au bon moment.
        Sans cette prop, la pile fonctionne mais le bouton de l'intro reste dans l'ordre de
        tabulation derrière une carte opaque.
        <br />
        <strong>Les cartes s'empilent à toutes les largeurs</strong>, et passent sous la nav, qui
        écrit son propre rang et le garde des deux côtés. Sur téléphone en revanche, le premier écran
        n'est pas une couche : l'intro n'y tient pas, et <code>covers</code> n'a alors rien à rendre
        inerte puisque rien ne la recouvre — elle défile normalement. Voir plus bas.
      </p>

      <p class="flag">
        <strong>Le mobile n'est pas dessiné, et la pile s'y empile quand même.</strong> Il n'y a plus
        de cas mobile dans ce composant — une seule règle vaut à toutes les largeurs, et le système a
        une bascule de moins. Ça n'a pas toujours été vrai, et l'histoire tient en deux mesures.
        <br />
        La pile se défaisait sous 768px parce que <strong>le contrat de la carte se retournait à cette
        largeur</strong>. « L'en-tête est le point fixe, le carrousel prend ou rend la place » vaut à
        1200px, où l'en-tête est compact ; dans une colonne de 390 il mesurait <code>361px</code>,
        soit 55% de l'écran, et la carte réclamait <code>753px</code>. Le carrousel payait seul : sa
        vignette tombait à 147px sur une fenêtre de 660, à 13px sur les 553 d'un petit iPhone.
        <br />
        <strong>Effacer les tags a rendu 132px</strong>, et tout a basculé. L'en-tête retombe à
        {' '}<code>229px</code> — 30 à 46% de l'écran selon l'appareil — et la carte ne réclame plus que
        {' '}<code>621px</code>, c'est-à-dire moins que la plupart des téléphones :
      </p>

      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th>Fenêtre (<code>svh</code>)</th><th>En-tête</th><th>Carte voulue</th>
              <th>Carrousel</th><th>Vignette</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>553 — petit iPhone</td><td>257px (46%)</td><td>649px</td><td>176px</td><td>144 × 310</td></tr>
            <tr><td>660</td><td>229px (35%)</td><td>621px</td><td>311px</td><td>279 × 600</td></tr>
            <tr><td>760 — grand téléphone</td><td>229px (30%)</td><td>621px</td><td>411px</td><td>379 × 815</td></tr>
          </tbody>
        </table>
      </div>

      <p class="flag">
        Les chiffres sont mesurés sur le gabarit, carte collée en haut, pas estimés. À 760 le
        carrousel retrouve les <code>411px</code> que Figma dessine en desktop : la carte n'est plus
        contrainte du tout. Seul le petit iPhone serre encore, et il serre honnêtement — 144px de
        vignette, pas 13.
        <br />
        <strong>Reste un écart, et c'est le seul du système où une mesure de dessin n'est pas
        constante.</strong> La couche fait <code>100svh</code>, c'est-à-dire la hauteur d'écran
        {' '}<em>barre d'URL visible</em> — la plus petite des deux que donne un téléphone. Quand la barre
        se rétracte au défilement, l'écran grandit de 60 à 90px et la carte ne bouge pas : le liseré
        vaut <code>90px</code> au chargement et <code>~160px</code> en lecture, et il repasse à 90 si
        l'on remonte. Aucun émulateur ne le montre — cette barre ne se rétracte que sur un appareil
        réel.
        <br />
        <code>100dvh</code> rendrait le liseré constant, au prix d'une couche qui se redimensionne à
        chaque glissement de la barre : l'en-tête étant le point fixe, c'est le carrousel qui
        grandirait et rétrécirait de ~70px, à chaque arrêt et à chaque reprise. Une carte qui ne
        tremble jamais a été jugée préférable à un liseré constant. La bascule reste d'une ligne si
        l'usage dit le contraire.
      </p>

      <p class="flag">
        <strong>Sur téléphone, l'intro déborde sous la première carte — et c'est le liseré qui
        prime.</strong> Le premier écran est une couche à toutes les largeurs : sa hauteur vaut la
        fenêtre moins le liseré et moins la barre, ce qui garantit l'affleurement partout. Mais
        l'intro de démonstration réclame <code>741px</code> dans une colonne de 412, où son titre se
        replie sur sept lignes, quand le premier écran n'en offre qu'environ <code>620</code>. Elle
        déborde donc par le bas, et la carte passe dessus — description et bouton compris.
        <br />
        <strong>Ce n'est pas un cas mobile, c'est le cas des fenêtres courtes</strong>, que le système
        connaît déjà : un écran de bureau trop bas produit exactement le même débordement, et
        {' '}<code>justify-content: safe center</code> le fait tomber du bon côté — l'intro reste sous la
        nav et ne dépasse que par le bas, là où quelque chose la recouvre toujours. Seule la fréquence
        change : sur téléphone c'est la règle plutôt que l'exception. L'arbitrage est explicite —
        {' '}<strong>le liseré prime sur ce qui dépasse</strong> — et il se renverse le jour où la maquette
        dessine une intro mobile plus courte. Le titre, lui, reste celui de Figma : 42px, sept lignes,
        et personne n'y touche pour faire tenir une géométrie.
      </p>
    </section>
  </main>
</DocsLayout>

