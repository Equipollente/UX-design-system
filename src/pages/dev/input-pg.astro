---
// Page d'essai d'InputPG : toutes les variantes de ton `_FormGroup`, pour les voir.
// Elle n'est pas dans la doc du système.
import BaseLayout from '../../design-system/layouts/BaseLayout.astro';
import InputPG from '../../design-system/components/InputPG.astro';
import Icon from '../../design-system/components/Icon.astro';

const statuses = ['rest', 'error', 'success', 'disabled'] as const;
const sizes = ['small', 'medium', 'large'] as const;
const messages = {
  rest: undefined,
  error: 'Il manque l’extension : .fr, .com…',
  success: 'Cette adresse est disponible.',
  disabled: undefined,
};
---

<BaseLayout title="InputPG">
  <main>
    <h1>InputPG</h1>

    <h2>Statuts, en taille moyenne</h2>
    <div class="grid">
      {statuses.map((status) => (
        <InputPG
          id={`statut-${status}`}
          label={`status = ${status}`}
          status={status}
          value="Valeur"
          message={messages[status]}
          hint="Le texte d’aide reste affiché."
        />
      ))}
    </div>

    <h2>Tailles</h2>
    <div class="grid">
      {sizes.map((size) => (
        <InputPG id={`taille-${size}`} label={`size = ${size}`} size={size} placeholder="Un exemple" />
      ))}
    </div>

    <h2>Avec icône (slot) et compteur</h2>
    <div class="grid">
      <InputPG id="recherche" label="Recherche" type="search" placeholder="Chercher…">
        <Icon name="search-2" slot="icon-start" />
      </InputPG>
      <InputPG id="sujet" label="Sujet" required counter maxlength={40} value="Bonjour" hint="40 caractères au plus." />
    </div>
  </main>
</BaseLayout>

<style>
  main {
    padding: 2rem;
    max-width: 72rem;
    margin: 0 auto;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 2rem;
    margin-block: 1rem 3rem;
  }
</style>
