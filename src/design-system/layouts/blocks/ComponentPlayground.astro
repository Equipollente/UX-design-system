---
import Tabs from '../../components/tabs/Tabs.astro';
import TabList from '../../components/tabs/TabList.astro';
import TabButton from '../../components/tabs/TabButton.astro';
import TabPanel from '../../components/tabs/TabPanel.astro';

interface Props {
  /** Code Astro correspondant au rendu fourni par le slot `preview`. */
  code?: string;
  /** Préfixe unique utilisé par les identifiants accessibles du Playground. */
  id?: string;
}

const { code, id = 'playground' } = Astro.props;
const visualisationTabId = `${id}-visualisation-tab`;
const visualisationPanelId = `${id}-visualisation-panel`;
const codeTabId = `${id}-code-tab`;
const codePanelId = `${id}-code-panel`;
const htmlTabId = `${id}-html-tab`;
const htmlPanelId = `${id}-html-panel`;
---

<section data-slot="Playground" data-playground id={id} aria-labelledby={`${id}-title`}>
  <header class="playground-header">
    <h2 id={`${id}-title`}>Playground</h2>
    <p>Une frame pour paramétrer chaque composant lié au composant documenté.</p>
  </header>

  <div class="playground-frame">
    <div class="playground-controls">
      <slot name="controls" />
    </div>

    <div class="playground-preview" aria-live="polite">
      <h3>Rendu en direct</h3>
      <Tabs>
        <TabList label="Rendu du composant">
          <TabButton id={visualisationTabId} controls={visualisationPanelId} selected>
            Visualisation
          </TabButton>
          <TabButton id={codeTabId} controls={codePanelId}>
            Code
          </TabButton>
          <TabButton id={htmlTabId} controls={htmlPanelId}>
            HTML
          </TabButton>
        </TabList>

        <TabPanel id={visualisationPanelId} labelledby={visualisationTabId}>
          <div class="demo-frame">
            <slot name="preview" />
          </div>
        </TabPanel>

        <TabPanel id={codePanelId} labelledby={codeTabId} hidden>
          <pre><code data-playground-code>{code}</code></pre>
        </TabPanel>

        <TabPanel id={htmlPanelId} labelledby={htmlTabId} hidden>
          <pre><code data-playground-html></code></pre>
        </TabPanel>
      </Tabs>
    </div>
  </div>
</section>

<script>
  const VOID_ELEMENTS = new Set([
    'area', 'base', 'br', 'col', 'embed', 'hr', 'img', 'input',
    'link', 'meta', 'param', 'source', 'track', 'wbr',
  ]);

  // Astro-cid et data-attributes internes au Playground : sans valeur pour
  // un consommateur qui copie-colle le rendu sur un autre site.
  function stripInternalAttributes(html: string): string {
    return html
      .replace(/\s+data-astro-cid-[a-z0-9]+(="[^"]*")?/gi, '')
      .replace(/\s+data-[a-z-]*playground[a-z-]*(="[^"]*")?/gi, '');
  }

  // Ré-indente un innerHTML brut : lisible, pas un vrai parseur HTML.
  function prettyPrintHtml(html: string): string {
    const withBreaks = stripInternalAttributes(html).replace(/>\s*</g, '>\n<').trim();
    if (!withBreaks) return '';
    let indent = 0;
    return withBreaks
      .split('\n')
      .map((raw) => raw.trim())
      .filter(Boolean)
      .map((line) => {
        const isClosingTag = /^<\//.test(line);
        const isComment = /^<!--/.test(line);
        const isSelfClosing = /\/>$/.test(line);
        const isInlinePair = /^<[^>]+>.*<\/[^>]+>$/.test(line);
        const tagName = line.match(/^<\/?([a-zA-Z0-9-]+)/)?.[1]?.toLowerCase();
        const isVoid = tagName ? VOID_ELEMENTS.has(tagName) : false;

        if (isClosingTag) indent = Math.max(indent - 1, 0);
        const rendered = `${'  '.repeat(indent)}${line}`;
        if (!isClosingTag && !isComment && !isSelfClosing && !isVoid && !isInlinePair) {
          indent += 1;
        }
        return rendered;
      })
      .join('\n');
  }

  // Une règle Astro scopée porte un data-astro-cid-* en plus du sélecteur
  // écrit par l'auteur ; on le retire pour que la règle s'applique par classe
  // seule, comme sur un site qui n'a pas la chaîne de build Astro.
  function stripCidFromSelector(cssText: string): string | null {
    const cleaned = cssText.replace(/\[data-astro-cid-[a-z0-9]+\]/gi, '').trim();
    const selector = cleaned.slice(0, cleaned.indexOf('{')).trim();
    return selector ? cleaned : null;
  }

  // Styles scopés Astro : chaque composant rendu porte un data-astro-cid-*,
  // on récupère dans les feuilles de style les règles qui le référencent —
  // celles du composant documenté et de ceux qu'il compose — puis on les
  // rend portables (sélecteur nettoyé de son data-astro-cid).
  function collectScopedStyles(root: HTMLElement): string {
    const cids = new Set<string>();
    root.querySelectorAll('*').forEach((el) => {
      Array.from(el.attributes).forEach((attr) => {
        if (/^data-astro-cid-/.test(attr.name)) cids.add(attr.name);
      });
    });
    if (cids.size === 0) return '';

    const seen = new Set<string>();
    const rules: string[] = [];

    const visit = (rule: CSSRule): string | null => {
      if (rule instanceof CSSMediaRule) {
        const inner = Array.from(rule.cssRules)
          .map(visit)
          .filter((entry): entry is string => Boolean(entry));
        return inner.length ? `@media ${rule.media.mediaText} {\n  ${inner.join('\n  ')}\n}` : null;
      }
      const selectorText = (rule as CSSStyleRule).selectorText;
      if (!selectorText) return null;
      if (!Array.from(cids).some((cid) => selectorText.includes(cid))) return null;
      return stripCidFromSelector(rule.cssText);
    };

    Array.from(document.styleSheets).forEach((sheet) => {
      let cssRules: CSSRuleList;
      try {
        cssRules = sheet.cssRules;
      } catch {
        return; // feuille cross-origin (polices, etc.), inaccessible
      }
      Array.from(cssRules).forEach((rule) => {
        const cleaned = visit(rule);
        if (cleaned && !seen.has(cleaned)) {
          seen.add(cleaned);
          rules.push(cleaned);
        }
      });
    });
    return rules.join('\n\n');
  }

  const TOKENS_IMPORT = "import 'ux-design-system/styles/tokens.css';";

  document.querySelectorAll<HTMLElement>('[data-playground]').forEach((playground) => {
    playground.querySelectorAll<HTMLElement>('[data-playground-toggle]').forEach((toggle) => {
      const name = toggle.dataset.playgroundToggle;
      const input = toggle.querySelector<HTMLInputElement>('input');
      if (!name || !input) return;

      const targets = playground.querySelectorAll<HTMLElement>(
        `[data-playground-options="${name}"], [data-playground-preview="${name}"]`,
      );

      const update = () => {
        const visible = input.checked;
        targets.forEach((target) => {
          target.hidden = !visible;
          target.style.display = visible ? '' : 'none';
        });
      };

      input.addEventListener('change', update);
      update();
    });

    const demoFrame = playground.querySelector<HTMLElement>('.demo-frame');
    const htmlOutput = playground.querySelector<HTMLElement>('[data-playground-html]');
    if (!demoFrame || !htmlOutput) return;

    const updateHtmlTab = () => {
      const html = prettyPrintHtml(demoFrame.innerHTML);
      const styles = collectScopedStyles(demoFrame);
      htmlOutput.textContent = styles
        ? `${TOKENS_IMPORT}\n\n${html}\n\n${styles}`
        : `${TOKENS_IMPORT}\n\n${html}`;
    };

    updateHtmlTab();
    new MutationObserver(updateHtmlTab).observe(demoFrame, {
      childList: true,
      subtree: true,
      attributes: true,
      characterData: true,
    });
  });
</script>

<style>
  [data-slot='Playground'] {
    display: grid;
    gap: var(--space-lg);
  }

  .playground-header {
    display: grid;
    gap: var(--space-xs);
  }

  h2,
  p {
    margin: 0;
  }

  h2 {
    font-size: var(--font-size-title);
  }

  h3 {
    margin: 0;
    font-size: var(--font-size-heading);
  }

  p {
    color: var(--color-text-muted);
  }

  .playground-frame {
    display: grid;
    grid-template-columns: minmax(12rem, 0.7fr) minmax(0, 1.3fr);
    align-items: start;
    gap: var(--space-xl);
    width: 100%;
    min-width: 0;
    padding: var(--space-xl);
    border-radius: var(--radius-md);
    background: var(--color-bg-surface);
  }

  .playground-controls,
  .playground-preview {
    min-width: 0;
  }

  .playground-controls {
    max-height: 70vh;
    overflow-y: auto;
    padding-right: var(--space-xs);
  }

  .playground-preview {
    position: sticky;
    top: var(--space-xl);
  }

  .playground-controls :global(form) {
    display: grid;
    gap: var(--space-lg);
  }

  .playground-controls :global(fieldset) {
    display: grid;
    gap: var(--space-md);
    min-inline-size: 0;
    margin: 0;
    padding: var(--space-lg);
    border: var(--border-width-default) solid var(--color-border-default);
    border-radius: var(--radius-md);
    background: var(--color-bg-default);
  }

  .playground-controls :global(legend) {
    padding-inline: var(--space-xs);
    color: var(--color-text-default);
    font-family: var(--font-family-body);
    font-size: var(--font-size-body);
    font-weight: var(--font-weight-medium);
    line-height: var(--font-line-height-tight);
  }

  .playground-controls :global([data-playground-group] .btn) {
    --btn-h: var(--button-height-sm);
    --btn-px: var(--button-padding-x-sm);
    --btn-gap: var(--button-gap-sm);
    --btn-icon: var(--button-icon-size-sm);
    --btn-min-w: var(--button-min-width-sm);
  }

  .playground-preview {
    width: 100%;
  }

  .demo-frame {
    width: 100%;
    min-height: 12rem;
    padding: var(--space-xl);
    background: var(--color-bg-default);
  }

  pre {
    width: 100%;
    min-width: 0;
    margin: 0;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  @media (max-width: 767px) {
    .playground-frame {
      grid-template-columns: 1fr;
    }

    .playground-controls {
      max-height: none;
      overflow-y: visible;
      padding-right: 0;
    }

    .playground-preview {
      position: static;
      top: auto;
    }
  }
</style>
