---
// AddImage — le cycle complet d'un dépôt d'image dans un formulaire : le champ
// qui l'accepte, sa progression, son échec, et l'image qu'il finit par tenir.
//
// Ce n'est pas un bouton : un bouton déclenche une action, l'état `add` ouvre
// le sélecteur de fichiers du système et rend un fichier au formulaire. Ce
// n'est plus vrai que « ça ne montre jamais ce qui a été déposé » : l'état
// `success` montre l'image déposée, avec de quoi la revoir ou la retirer —
// exactement ce que fait EditImageGallery, mais pour UNE image dans SON
// emplacement plutôt que pour la liste de celles déjà validées. Un formulaire
// qui dépose plusieurs images compose donc un AddImage par emplacement, et une
// EditImageGallery pour la liste qui en résulte une fois le formulaire soumis ;
// un AddImage seul suffit à représenter un unique emplacement du début à la
// fin de son cycle.
//
// Nœuds Figma : 343:315 (les 4 états d'interaction du champ — Default/Hover/
// Focused/Disabled, toujours l'état `add`) et 418:1020, « Add Image process »
// (les 4 étapes du cycle — State=add/in progress/fail/success). Les deux
// coexistent dans le fichier ; le second enveloppe le premier pour son
// premier état et ajoute les trois suivants.
//
// L'état `add` est un <input type="file"> et son <label>, et c'est ce qui lui
// permet de fonctionner sans une ligne de JavaScript : cliquer la zone ouvre
// le sélecteur, Entrée et la barre d'espace aussi. Les trois autres états ne
// sont plus un contrôle : ce sont des rendus conditionnels, pilotés par les
// props `state`, `progress`, `failMessage`, `image` — jamais par un script du
// composant (aucun composant du système n'en porte par défaut). Le champ est
// déporté hors du cadre plutôt que masqué en `add` — `display: none` le
// retirerait du parcours au clavier et de l'arbre d'accessibilité.
//
// Ce que Figma déclare et qui n'est pas ici :
// — taille 240 × 140 non contrainte, padding 28/24 composé de tokens, icône
//   32 = space/2xl, trait redessiné à 1, anneau de focus 2, couleur icône en
//   currentColor, pas de glisser-déposer — ces écarts sont ceux de l'état
//   `add`, inchangés ;
// — le nœud dessine aussi l'état `add` en trait pointillé ; le code le garde
//   plein, comme avant cette évolution — un écart pré-existant, remarqué en
//   construisant les deux nouvelles boîtes (qui, elles, sont pointillées
//   comme le nœud le demande), pas corrigé faute de demande sur cet état-là ;
// — la piste de progression ne fait pas 114 de large : comme la boîte
//   elle-même, elle suit la largeur que l'appelant lui donne ;
// — le trait de la boîte `fail` est écrit en `color/border/default`, qui
//   vaut exactement la couleur de son propre fond `color/accent/100` — donc
//   invisible en rendu normal. À trancher dans Figma, pas une épaisseur à
//   changer ;
// — le message de `fail` reprend le mot du nœud tel quel, coquille comprise
//   (« telechargement » sans accent) : c'est une prop, pas un texte à
//   corriger en dur.

import Icon from './Icon.astro';
import Button from './Button.astro';

interface Props {
  /** Lie le libellé au champ en `state="add"`. Unique dans la page. */
  id: string;
  /** Ce que la zone propose de faire en `state="add"`. Un verbe : « Add image ». N'a de sens que là. */
  label?: string;
  /** Ce qu'elle accepte, en toutes lettres. Lu après le libellé, pas laissé flottant. */
  hint?: string;
  /** Les types acceptés, au format de l'attribut natif : « image/png,image/jpeg ». */
  accept?: string;
  /** Autorise plusieurs fichiers en une fois. */
  multiple?: boolean;
  name?: string;
  required?: boolean;
  disabled?: boolean;
  /** Cache l'élément entier — le crochet que la démo de /formulaire togglera. */
  hidden?: boolean;
  /**
   * L'étape du cycle de dépôt. `add` est le champ natif ; les trois autres
   * sont un rendu conditionnel piloté par les props ci-dessous — jamais par
   * un script du composant.
   */
  state?: 'add' | 'in-progress' | 'fail' | 'success';
  /** Le mot affiché pendant `state="in-progress"`, avant le pourcentage. */
  progressLabel?: string;
  /** La fraction déposée, 0 à 100. N'a de sens qu'en `state="in-progress"`. */
  progress?: number;
  /** Le message d'échec. N'a de sens qu'en `state="fail"`. */
  failMessage?: string;
  /**
   * Le bouton qui relance le dépôt en `state="fail"`. Sans `href`, un bouton
   * inerte — c'est à l'appelant de lui donner un geste.
   */
  retry?: { label: string; href?: string };
  /** L'image déjà déposée, montrée en `state="success"`. */
  image?: {
    id: string;
    src: string;
    alt: string;
    href?: string;
    width?: number;
    height?: number;
  };
  /** Le mot du bouton qui ouvre l'image en `state="success"`. */
  viewLabel?: string;
  /** Le mot du bouton qui la retire en `state="success"`. */
  removeLabel?: string;
  /** Le `name` du bouton supprimer en `state="success"`. Sa `value` est l'`id` de l'image. */
  removeName?: string;
  class?: string;
}

const {
  id,
  label,
  hint,
  accept,
  multiple = false,
  name,
  required = false,
  disabled = false,
  state = 'add',
  progressLabel = 'téléchargement',
  progress = 0,
  failMessage,
  retry = { label: 'Recommencer' },
  image,
  viewLabel = 'voir',
  removeLabel = 'supprimer',
  removeName = 'remove',
  class: className,
  ...rest
} = Astro.props;

const hintId = hint ? `${id}-hint` : undefined;
const progressLabelId = `${id}-label`;
const clampedProgress = Math.min(100, Math.max(0, progress));

const boxClasses = ['add-image', className].filter(Boolean).join(' ');
const transientClasses = ['add-image', 'add-image-transient', className].filter(Boolean).join(' ');
const failClasses = ['add-image', 'add-image-transient', 'add-image-fail', className]
  .filter(Boolean)
  .join(' ');
const successClasses = ['add-image-success', className].filter(Boolean).join(' ');
---

{
  state === 'add' && (
    <label class={boxClasses} for={id} {...rest}>
      <input
        class="add-image-input"
        type="file"
        id={id}
        name={name ?? id}
        accept={accept}
        multiple={multiple}
        required={required}
        disabled={disabled}
        aria-describedby={hintId}
      />
      {/* L'icône double un mot écrit juste en dessous : elle est décorative, donc
          sans `label` — sans quoi les lecteurs d'écran diraient la chose deux fois. */}
      <Icon name="image-plus" class="add-image-icon" />
      <span class="add-image-label">{label}</span>
      {hint && (
        <span class="add-image-hint" id={hintId}>
          {hint}
        </span>
      )}
    </label>
  )
}

{
  state === 'in-progress' && (
    <div id={id} class={transientClasses} {...rest}>
      <span class="add-image-progress-label" id={progressLabelId}>
        {progressLabel}
      </span>
      <div
        class="add-image-progress-track"
        role="progressbar"
        aria-valuenow={clampedProgress}
        aria-valuemin="0"
        aria-valuemax="100"
        aria-labelledby={progressLabelId}
        style={`--add-image-progress: ${clampedProgress}%`}
      >
        <div class="add-image-progress-fill" />
      </div>
      <span class="add-image-progress-value">{clampedProgress}%</span>
    </div>
  )
}

{
  state === 'fail' && (
    <div id={id} class={failClasses} {...rest}>
      {/* `role="alert"` sur le message seul, pas sur toute la boîte : le
          bouton qui suit ne doit pas être avalé par la région live. */}
      <span class="add-image-fail-message" role="alert">
        {failMessage}
      </span>
      <Button variant="secondary" size="sm" href={retry.href}>
        {retry.label}
      </Button>
    </div>
  )
}

{
  state === 'success' && image && (
    <div id={id} class={successClasses} {...rest}>
      <img
        class="add-image-success-image"
        src={image.src}
        alt={image.alt}
        width={image.width}
        height={image.height}
      />
      <div class="add-image-success-actions">
        {image.href && (
          <Button variant="secondary" size="md" href={image.href}>
            {viewLabel}
          </Button>
        )}
        {/* Le nom accessible dit de quelle image il s'agit — comme dans
            EditImageGallery, dont ce bloc reprend le motif pour un seul
            emplacement plutôt que pour une grille. */}
        <Button
          variant="alert"
          size="md"
          type="submit"
          name={removeName}
          value={image.id}
          aria-label={`${removeLabel} — ${image.alt}`}
        >
          {removeLabel}
        </Button>
      </div>
    </div>
  )
}

<style>
  /* Le champ est déporté hors du cadre, pas masqué : il reste au clavier et dans
     l'arbre d'accessibilité. `inset(50%)` le réduit à rien sans qu'aucune mesure
     soit écrite. */
  .add-image-input {
    position: absolute;
    clip-path: inset(50%);
  }

  /* La boîte, commune aux états `add`, `in-progress` et `fail`. Son rayon, son
     rembourrage horizontal et l'écart de ses lignes viennent du nœud, où ils
     sont liés. Sa taille, non : elle se dimensionne sur son contenu et prend
     la largeur que l'appelant lui donne. */
  .add-image {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    gap: var(--space-sm); /* 8 — l'itemSpacing du nœud */
    /* 24 en x, lié dans le nœud ; 24 + 4 = 28 en y, la mesure exacte du nœud. */
    padding: calc(var(--space-xl) + var(--space-xs)) var(--space-xl);
    /* L'icône descend par héritage jusqu'au <svg> : 32, la mesure du nœud. */
    --icon-size: var(--space-2xl);
    border-radius: var(--radius-lg); /* 28 */
    text-align: center;
    border: var(--border-width-default) solid var(--color-border-default);
    background: var(--add-image-bg, var(--color-bg-surface));
  }

  /* Le curseur et le survol ne valent que pour la boîte qui contient le champ
     réel — `in-progress` et `fail` ne sont pas cliquables. */
  .add-image:has(.add-image-input) {
    cursor: pointer;
  }

  .add-image:has(.add-image-input):hover {
    background: var(--add-image-bg-hover, var(--color-accent-100));
  }

  .add-image:has(.add-image-input):hover .add-image-label {
    color: var(--color-accent-600);
  }

  /* — focused — L'anneau du système, porté par la zone : le champ étant hors du
     cadre, son propre anneau ne se verrait pas. 2, la mesure du nœud. WCAG 2.4.7. */
  .add-image:has(.add-image-input:focus-visible) {
    outline: var(--border-width-focus) solid var(--color-border-focus);
    outline-offset: var(--button-focus-offset);
  }

  /* — disabled — écrit en dernier : à spécificité égale c'est l'ordre qui
     tranche, et une zone désactivée ne doit pas prendre le survol. La zone entière
     s'atténue, exactement comme le nœud le dessine : le libellé y garde son encre
     par-dessous, et n'a donc plus à virer au gris pour dire « éteint ». */
  .add-image:has(.add-image-input:disabled),
  .add-image:has(.add-image-input:disabled):hover {
    background: var(--add-image-bg, var(--color-bg-surface));
    opacity: var(--opacity-disabled);
    cursor: not-allowed;
  }

  .add-image-label {
    font-family: var(--font-family-body); /* Inter */
    font-size: var(--font-size-ui); /* 0.875rem — les 14 du nœud */
    font-weight: var(--font-weight-medium); /* 500 */
    line-height: var(--font-line-height-snug); /* 1.2 — les 120 % du nœud */
    letter-spacing: var(--font-letter-spacing-normal);
    color: var(--color-text-default);
  }

  /* L'indication a la même graisse et le même corps que le libellé dans le nœud :
     c'est l'encre seule qui la met au second plan. */
  .add-image-hint {
    font-family: var(--font-family-body);
    font-size: var(--font-size-ui);
    font-weight: var(--font-weight-medium);
    line-height: var(--font-line-height-snug);
    letter-spacing: var(--font-letter-spacing-normal);
    color: var(--color-text-muted);
  }

  /* — in-progress, fail — le nœud dessine les deux en trait pointillé, à la
     différence de `add` (voir le pavé de tête). */
  .add-image-transient {
    border-style: dashed;
  }

  .add-image-progress-label,
  .add-image-progress-value,
  .add-image-fail-message {
    font-family: var(--font-family-body);
    font-size: var(--font-size-ui);
    font-weight: var(--font-weight-medium);
    line-height: var(--font-line-height-snug);
    letter-spacing: var(--font-letter-spacing-normal);
  }

  .add-image-progress-label {
    color: var(--color-text-muted);
  }

  .add-image-progress-value {
    color: var(--color-text-default);
  }

  /* La piste ne fait pas 114 de large dans le code : comme la boîte, elle suit
     la largeur que l'appelant lui donne. Hauteur 8 = space/sm, exacte. */
  .add-image-progress-track {
    width: 100%;
    height: var(--space-sm);
    border-radius: var(--radius-pill);
    background: var(--color-neutral-400);
  }

  .add-image-progress-fill {
    height: 100%;
    width: var(--add-image-progress, 0%);
    border-radius: var(--radius-pill);
    background: var(--color-accent-300);
  }

  /* — fail — Surcharge nommée d'après l'objet, comme --add-image-bg : le fond
     plein remplace le fond surface. Le trait hérité de .add-image reste écrit
     en color/border/default, qui vaut exactement cette même couleur — voir le
     pavé de tête, c'est un écart Figma, pas un oubli d'ici. */
  .add-image-fail {
    background: var(--add-image-bg-fail, var(--color-accent-100));
  }

  .add-image-fail-message {
    color: var(--color-feedback-danger-500);
  }

  /* — success — plus de boîte pointillée : l'image tient toute la place, les
     boutons flottent par-dessus. Même motif qu'une vignette d'EditImageGallery,
     dupliqué et non partagé — voir le pavé de tête des deux fichiers. */
  .add-image-success {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
    height: calc(var(--space-layout-128) + var(--space-md)); /* 140, comme EditImageGallery */
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .add-image-success-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .add-image-success-actions {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
  }
</style>
