---
// CardImage — image optionnelle de la famille Cards.
// La carte décide si cette région existe ; ce composant décide quelle source
// afficher et porte le contrat d'accessibilité de l'image. Figma : 451:1006.

import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'img'> {
  /** Image informative principale. Son URL vient de l'appelant. */
  src?: string;
  /** Texte alternatif de l'image principale informative. */
  alt?: string;
  /** Image décorative de remplacement quand src est absent. */
  fallback?: string;
  /** Marque l'image principale comme décorative. */
  decorative?: boolean;
  /** Dimensions intrinsèques connues de l'image principale. */
  width?: number;
  height?: number;
}

const {
  src,
  alt,
  fallback,
  decorative = false,
  width,
  height,
  class: className,
  slot: _slot,
  ...rest
} = Astro.props as Props & { slot?: string };

const imageSrc = src ?? fallback;

if (!imageSrc) {
  throw new Error('CardImage : `src` ou `fallback` est requis.');
}

if (src && !decorative && alt === undefined) {
  throw new Error(
    "CardImage : une image informative demande `alt`. Utilisez `decorative` pour une image muette.",
  );
}

const imageAlt = decorative || !src ? '' : alt;
const classes = ['cards-card-image', className].filter(Boolean).join(' ');
---

<img
  data-slot="card-image"
  class={classes}
  src={imageSrc}
  alt={imageAlt}
  width={width}
  height={height}
  loading="lazy"
  decoding="async"
  referrerpolicy="no-referrer"
  {...rest}
/>

<style>
  .cards-card-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-sm);
  }
</style>
