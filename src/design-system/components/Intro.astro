---
// L'intro d'une page d'accueil : un visage, une salutation, la phrase qui dit ce
// qu'on fait, et le bouton qui mène à la suite.
//
// Figma l'appelle « Section.Intro » (209:2348). Le préfixe `Section.` est une
// convention de rangement du fichier, pas une partie du nom de l'objet : le code
// le nomme `Intro`.
//
// Le composant ignore tout du site qui l'emploie : ni le visage, ni les textes,
// ni la destination du bouton ne vivent ici. Tout tombe des props — le chemin de
// l'avatar y compris, puisque c'est le site qui le sert et donc lui qui sait le
// préfixer.

import Button from './Button.astro';

interface Props {
  /** Le visage. `src` passe par le withBase() du site : c'est son asset, pas le nôtre. */
  avatar: { src: string; alt: string };
  /** La salutation, au-dessus du titre. */
  greeting: string;
  headline: string;
  /** La phrase sous le titre. */
  description?: string;
  /** La suite. Sans href ⇒ <button> inerte, à câbler par l'appelant. */
  action?: { label: string; href?: string };
  /** 1 sur une page qui n'a pas d'autre titre — le cas d'une page d'accueil. Le
   *  rang ne change pas le dessin : la taille du titre vient du composant. */
  headingLevel?: 1 | 2;
  class?: string;
}

const {
  avatar,
  greeting,
  headline,
  description,
  action,
  headingLevel = 1,
  class: className,
} = Astro.props;

const Heading = `h${headingLevel}` as 'h1' | 'h2';
const classes = ['intro', className].filter(Boolean).join(' ');
---

<section class={classes}>
  <div class="block">
    <img class="avatar" src={avatar.src} alt={avatar.alt} width="64" height="64" />
    <p class="greeting">{greeting}</p>
    <Heading class="headline">{headline}</Heading>
    {description && <p class="description">{description}</p>}
  </div>

  {
    action && (
      <Button
        size="lg"
        href={action.href}
        iconEnd="corner-right-down"
        style="--btn-px: var(--button-padding-x-md); --btn-icon: var(--button-icon-size-md)"
      >
        {action.label}
      </Button>
    )
  }
</section>

<style>
  /* Le bloc est calé à gauche sur sa propre mesure, le bouton est centré sous
     lui : c'est ce que dessine Figma, en desktop comme en mobile (142:1193). */
  .intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    /* L'écart entre le bloc de texte et le bouton — le seul endroit de l'intro
       où il y a de l'air à reprendre. La valeur de Figma est le repli ; elle est
       seulement *lue*, jamais déclarée ici, pour qu'une valeur posée sur un
       ancêtre passe au travers. Une déclaration sur .intro battrait l'héritage
       et le point de surcharge ne servirait à rien.
       Ce que ça permet : un premier écran calé à la hauteur de la fenêtre, où
       l'intro doit tenir dans ce qu'on lui laisse. */
    gap: var(--intro-gap, var(--space-layout-64));
  }

  .block {
    /* La mesure du bloc de texte. L'export Figma la donne en dur : aucun token
       ne la porte, comme la largeur minimale du titre d'étude de cas. */
    --intro-measure: 929px;

    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    width: 100%;
    max-width: var(--intro-measure);
    padding: var(--space-xl);
  }

  /* Même traitement que l'avatar du Nav — c'est le même visage, à la même
     taille, dans le même rond. */
  .avatar {
    flex: none;
    width: 64px;
    height: 64px;
    border-radius: var(--radius-pill);
    object-fit: cover;
  }

  /* Les marges de global.css ne servent à rien ici : c'est le gap qui espace. */
  .greeting,
  .headline,
  .description {
    margin: 0;
  }

  /* Style Figma body/hero : font.size.heading sur la famille de corps. */
  .greeting {
    font-size: var(--font-size-heading);
    line-height: var(--font-line-height-body);
    color: var(--color-text-default);
  }

  /* Le titre porte son dessin lui-même — taille, interligne, interlettrage —
     parce que le composant accepte aussi un h2 : le rang se range sous ce que
     la page porte déjà, il ne change pas l'apparence. Les trois valeurs sont
     celles du style Figma heading/display, que global.css applique par
     ailleurs au h1 ; les répéter ici n'est pas un doublon, c'est ce qui rend
     les deux rangs identiques. Faute d'un cran à 1.23 dans l'échelle,
     l'interligne prend snug (1.2) — 1,3px de moins par ligne. */
  .headline {
    font-size: var(--font-size-display);
    line-height: var(--font-line-height-snug);
    letter-spacing: var(--font-letter-spacing-normal);
    color: var(--color-text-default);
  }

  .description {
    font-size: var(--font-size-body-lg);
    line-height: var(--font-line-height-body);
    color: var(--color-text-muted);
  }

  /* Figma dessine le mobile à 42px (variante mobile de 142:1354, cadre de
     390px) et le titre y passe : « collaborative », le mot le plus long, mesure
     289px et tient jusqu'à 337px de large environ. En dessous il sort de
     l'écran. Le filet est donc posé sous 360px — la largeur du plus étroit des
     téléphones courants — et non à 767px : sur tout appareil réel, la maquette
     s'affiche telle qu'elle est dessinée. Ce point de rupture n'est pas celui du
     système (767px) parce qu'il ne répond pas à la même question : il ne change
     pas de mise en page, il empêche un mot de déborder. */
  @media (max-width: 359px) {
    .headline {
      font-size: var(--font-size-title);
    }
  }
</style>
