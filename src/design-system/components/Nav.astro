---
// Nav — la barre de navigation du système : six boutons, l'avatar de retour à
// l'accueil, les quatre items, et l'action. Deux nœuds Figma la spécifient, qui
// sont la même instance dans deux états :
//   60:992  — sur la page d'accueil : avatar masqué, aucun item actif
//   166:475 — sur les autres pages : avatar visible, item de la page en blanc
//
// Le composant ignore tout du site qui l'utilise : ni la liste des liens, ni la
// page courante, ni la destination de l'avatar ne vivent ici. Les deux états ne
// sont donc pas une variante à déclarer — ils tombent des props qu'on reçoit.
//
// Pas de filet sous la barre : la description Figma du composant l'interdit
// explicitement — « There is NO rule beneath the bar: this system parts
// sections with whitespace. »

import Button from './Button.astro';
import Icon from './Icon.astro';
import type { IconName } from '../lib/icons';

interface Props {
  links: { href: string; label: string; icon?: IconName }[];
  /** Chemin courant. Aucun item n'est actif s'il ne correspond à aucun href. */
  current?: string;
  /** Le bouton avatar. Absent ⇒ non rendu, c'est l'état d'accueil. */
  home?: { href: string; src: string; alt: string };
  /** Le sixième bouton. Sans href ⇒ <button> inerte, à câbler par l'appelant. */
  action?: { label: string; icon?: IconName; href?: string };
  /** aria-label du <nav>. */
  label?: string;
  /**
   * La barre se colle en haut de la fenêtre et s'efface quand on descend. Absente,
   * elle reste posée à plat : c'est ce que doit rester une barre qu'on documente
   * plutôt qu'on habite.
   */
  sticky?: boolean;
}

const {
  links,
  current,
  home,
  action,
  label = 'Navigation principale',
  sticky = false,
} = Astro.props;

// La classe sert au style, l'attribut data- au comportement : la première porte le
// collage et le mouvement, le second est le point d'accroche du script.
const classes = ['nav-bar', sticky && 'sticky'].filter(Boolean).join(' ');
---

{/* L'avatar est un lien de navigation : il entre dans le landmark. Le bouton
    d'action, lui, reste dehors — il déclenche une action, il ne navigue pas. */}
<div class={classes} data-nav-sticky={sticky || undefined}>
  <nav aria-label={label}>
    {
      home && (
        <a class="home" href={home.href}>
          <img src={home.src} alt={home.alt} width="64" height="64" />
        </a>
      )
    }

    {/* data-nav-tabs est le point d'accroche du script : les classes servent au
        style, les attributs data- au comportement. */}
    <ul class="tabs" data-nav-tabs>
      {
        links.map(({ href, label: text, icon }) => (
          <li>
            <a class="tab" href={href} aria-current={href === current ? 'page' : undefined}>
              {icon && <Icon name={icon} class="tab-icon" />}
              <span>{text}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  {
    action && (
      /* Figma compose ce bouton avec la hauteur lg et le padding horizontal md.
         On passe donc size="lg" en surchargeant --btn-px plutôt que d'inventer
         une quatrième taille pour un seul appel.
         Le wrapper existe pour que le masquage mobile ne dépende pas de l'ordre
         des feuilles scopées entre ce fichier et Button.astro. */
      <div class="nav-action">
        <Button
          size="lg"
          href={action.href}
          icon={action.icon}
          style="--btn-px: var(--button-padding-x-md); --btn-min-w: 0"
        >
          {action.label}
        </Button>
      </div>
    )
  }
</div>

<style>
  .nav-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-lg);
    /* Ce padding vertical fait partie de ce que mesure le token nav.height, que
       les pages lisent pour caler leur premier écran sous la barre. Le changer
       ici sans reprendre la variable dans Figma décalerait ces pages. */
    padding: var(--space-md) var(--space-lg);
    /* Sans min-width: 0, le min-width: auto par défaut des éléments flex
       empêche la pilule de se contraindre, donc de défiler (cf. mobile). */
    min-width: 0;
  }

  /* Collée, la barre écrit le seul z-index du système, et ce n'est pas un oubli
     de doctrine : ici l'ordre du DOM ne suffit plus. Les couches de
     CaseStudyList sont positionnées et viennent après elle dans la page, donc
     elles la recouvriraient — et révéler une barre derrière une carte opaque ne
     révélerait rien. Un seul cran, qui est aussi le plancher : rien d'autre dans
     le système ne se hisse au-dessus de quoi que ce soit.
     Elle reste dans le flux, et c'est ce qui permet à la page de compter sa
     hauteur sans la mesurer — un liseré de carte calculé en JavaScript sauterait
     au chargement. */
  .nav-bar.sticky {
    position: sticky;
    top: 0;
    z-index: 1;
    /* translateY et non top : le déplacement reste au compositeur, sans
       recalculer la mise en page à chaque frame. */
    transform: translateY(var(--nav-shift, 0));
    /* Une entrée ou une sortie prend duration.slow — c'est ce que dit la
       description du token, et c'est le premier composant à s'en servir. La
       courbe est celle de l'arrivée ; l'état masqué reprend celle du départ.
       Sous prefers-reduced-motion, tokens.css remet la durée à zéro : la barre
       bascule alors sans trajet, et il n'y a rien à prévoir ici. */
    transition: transform var(--motion-duration-slow) var(--motion-easing-enter);
  }

  /* L'attribut est posé par le script, jamais par le rendu : sans JavaScript la
     barre reste collée et visible. On perd le mouvement, pas la navigation. */
  .nav-bar.sticky[data-nav-hidden] {
    --nav-shift: -100%;
    transition-timing-function: var(--motion-easing-exit);
  }

  nav {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    min-width: 0;
  }

  /* L'export Figma donne cette dimension en dur : aucun token ne la porte.
     À remonter côté Figma plutôt qu'à inventer un token ici. */
  .home {
    --nav-home-size: 64px;

    flex: none;
    width: var(--nav-home-size);
    height: var(--nav-home-size);
    border-radius: var(--radius-pill);
    overflow: hidden;
  }

  .home img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* La pilule lavande */
  .tabs {
    position: relative; /* repère de la pastille */
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin: 0;
    padding: var(--space-sm);
    list-style: none;
    background: var(--color-bg-surface);
    border-radius: var(--radius-pill);
    overflow: hidden;
  }

  /* La pastille qui glisse d'un onglet à l'autre. Un pseudo-élément plutôt
     qu'une balise : rien à ajouter au markup, donc rien à masquer aux lecteurs
     d'écran. Sa géométrie est celle de l'onglet visé, écrite par le script.
     Enfant de la pilule, elle défile avec elle sur mobile. */
  .tabs::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: var(--slider-w, 0);
    height: var(--slider-h, 0);
    transform: translate(var(--slider-x, 0), var(--slider-y, 0));
    background: var(--color-bg-default);
    border-radius: var(--radius-lg);
    opacity: 0;
    pointer-events: none;
    /* Un déplacement prend duration.default, un fondu duration.quick. Sous
       prefers-reduced-motion, tokens.css remet ces durées à zéro : rien à
       prévoir ici. */
    transition:
      transform var(--motion-duration-default) var(--motion-easing-standard),
      width var(--motion-duration-default) var(--motion-easing-standard),
      height var(--motion-duration-default) var(--motion-easing-standard),
      opacity var(--motion-duration-quick) var(--motion-easing-standard);
  }

  .tabs[data-slider-on]::before {
    opacity: 1;
  }

  /* Deux moments sans transition : le placement initial, et l'apparition depuis
     rien (sur l'accueil, où la pastille n'a pas d'onglet d'origine) — sans quoi
     elle glisserait depuis une position qu'elle n'occupait pas visiblement. */
  .tabs[data-slider-jump]::before {
    transition: opacity var(--motion-duration-quick) var(--motion-easing-standard);
  }

  /* Au chargement, la pastille est déjà en place : rien ne bouge, rien n'apparaît. */
  .tabs[data-slider-init]::before {
    transition: none;
  }

  .tab {
    position: relative; /* le libellé passe au-dessus de la pastille */
    display: flex;
    flex: none; /* Figma déclare les onglets shrink-0 : ils ne se compriment pas. */
    align-items: center;
    justify-content: center;
    height: var(--button-height-md);
    padding: var(--space-md);
    gap: var(--button-gap-sm);
    border-radius: var(--radius-lg);
    color: var(--color-text-on-highlight);
    font-family: var(--font-family-body);
    font-weight: var(--font-weight-medium);
    font-size: var(--font-size-body);
    line-height: var(--font-line-height-snug);
    text-decoration: none;
    white-space: nowrap;
    /* Un changement de couleur prend duration.quick. Sert au repli sans
       JavaScript, où c'est l'onglet lui-même qui porte le fond. */
    transition: background-color var(--motion-duration-quick) var(--motion-easing-standard);
  }

  /* L'état courant est stylé sur l'attribut ARIA, pas sur une classe : l'état
     visuel et l'état annoncé ne peuvent donc pas diverger. */
  .tab[aria-current='page'] {
    background: var(--color-bg-default);
  }

  .tab:hover:not([aria-current='page']) {
    background: var(--color-accent-100);
  }

  /* Ces deux aplats sont le plancher : sans JavaScript, la barre se comporte
     comme avant. Le script pose data-slider-ready et c'est la pastille qui
     prend le relais — un seul objet se déplace, rien ne clignote sous lui. */
  .tabs[data-slider-ready] .tab[aria-current='page'],
  .tabs[data-slider-ready] .tab:hover {
    background: transparent;
  }

  .tab-icon {
    --icon-size: var(--button-icon-size-md);
  }

  .nav-action {
    display: flex;
  }

  /* Sous 768px — le layout.Device Width que l'export Figma déclare pour la
     tablette — il ne reste que l'essentiel : l'avatar, qui est le chemin de
     retour, et les libellés. Les icônes et l'action s'effacent. */
  @media (max-width: 767px) {
    .nav-bar {
      gap: var(--space-sm);
      /* Même remarque qu'au repos : nav.height porte 72 dans le mode Mobile,
         que le build sort sous ce même point de rupture. */
      padding: var(--space-xs);
    }

    .tab-icon,
    .nav-action {
      display: none;
    }

    /* Le design s'arrête à 390px. Plus bas, et dès que l'avatar occupe sa
       place, les onglets ne tiennent plus : la pilule défile au lieu de rogner
       le dernier, qui deviendrait inatteignable avec l'overflow: hidden que
       déclare Figma. */
    .tabs {
      min-width: 0;
      max-width: 100%;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .tabs::-webkit-scrollbar {
      display: none;
    }
  }
</style>

<script>
  // La pastille du Nav. Le script ne fait que mesurer l'onglet visé et écrire sa
  // géométrie en variables CSS ; tout le rendu et le mouvement restent au CSS.
  for (const tabs of document.querySelectorAll<HTMLElement>('[data-nav-tabs]')) {
    const active = () => tabs.querySelector<HTMLElement>('.tab[aria-current="page"]');

    /** L'onglet actuellement visé. null = pastille éteinte. */
    let target: HTMLElement | null = null;

    /** Pose la pastille sur un onglet. Sans cible, elle s'éteint (cas accueil). */
    function place(tab: HTMLElement | null, jump = false) {
      target = tab;

      if (!tab) {
        tabs.removeAttribute('data-slider-on');
        return;
      }

      // Réapparaître après extinction doit être un fondu sur place, pas un
      // glissement depuis la dernière position occupée.
      const appears = !tabs.hasAttribute('data-slider-on');
      if (jump || appears) tabs.setAttribute('data-slider-jump', '');

      tabs.style.setProperty('--slider-x', `${tab.offsetLeft}px`);
      tabs.style.setProperty('--slider-y', `${tab.offsetTop}px`);
      tabs.style.setProperty('--slider-w', `${tab.offsetWidth}px`);
      tabs.style.setProperty('--slider-h', `${tab.offsetHeight}px`);
      tabs.setAttribute('data-slider-on', '');

      if (jump || appears) {
        void tabs.offsetWidth; // force le reflow avant de rendre la transition
        tabs.removeAttribute('data-slider-jump');
      }
    }

    const rest = () => place(active());

    // Un tap déclenche pointerover juste avant de quitter la page : on écarte
    // le tactile au niveau de l'événement plutôt qu'avec une media query lue au
    // chargement, qui se tromperait sur un portable à écran tactile.
    tabs.addEventListener('pointerover', (event) => {
      if (event.pointerType === 'touch') return;
      const tab = (event.target as Element).closest<HTMLElement>('.tab');
      if (tab) place(tab);
    });
    tabs.addEventListener('pointerleave', (event) => {
      if (event.pointerType === 'touch') return;
      rest();
    });

    tabs.addEventListener('focusin', (event) => {
      const tab = (event.target as Element).closest<HTMLElement>('.tab');
      if (tab) place(tab);
    });
    tabs.addEventListener('focusout', (event) => {
      if (!tabs.contains(event.relatedTarget as Node)) rest();
    });

    // Placement initial sans la moindre transition — pas même le fondu.
    tabs.setAttribute('data-slider-init', '');
    tabs.setAttribute('data-slider-ready', '');
    place(active(), true);
    requestAnimationFrame(() => tabs.removeAttribute('data-slider-init'));

    // Une mesure ne vaut que pour la mise en page du moment. Elle change au
    // redimensionnement, quand Poppins et Inter remplacent les polices de repli,
    // et — en dev, où Astro injecte les styles par JavaScript — après ce script
    // lui-même. Observer la pilule couvre les trois d'un coup, plutôt que de
    // courir après chacun. Le rAF évite de forcer un reflow dans le callback.
    new ResizeObserver(() => {
      requestAnimationFrame(() => place(target, true));
    }).observe(tabs);

    // La pilule peut garder la même largeur pendant que celle des onglets change
    // (mobile : max-width 100% et défilement). Un dernier recalage au cas où.
    document.fonts?.ready.then(() => place(target, true));
  }

  // Le masquage directionnel de la barre collée. Comme la pastille, le script ne
  // décide de rien qu'on voie : il constate le sens du défilement et pose un
  // attribut ; tout le mouvement reste au CSS.
  for (const bar of document.querySelectorAll<HTMLElement>('[data-nav-sticky]')) {
    // Deux nombres de comportement, pas de dessin — comme le seuil de 2px de
    // CaseStudyList ou le point de rupture de 767px, aucun des deux n'est un
    // token. Lus sur la barre avec un repli, pour qu'une page puisse les
    // reprendre sans toucher au composant.
    const nombre = (nom: string, repli: number) => {
      const valeur = Number.parseFloat(getComputedStyle(bar).getPropertyValue(nom));
      return Number.isFinite(valeur) ? valeur : repli;
    };

    const seuil = nombre('--nav-hide-after', 100);
    const grain = nombre('--nav-hide-grain', 6);

    /** La dernière position depuis laquelle on a tranché. */
    let repère = Math.max(0, window.scrollY);

    /** Le sens du dernier mouvement retenu. On part du haut : rien n'est masqué. */
    let versLeBas = false;

    /** Le focus est-il dans la barre ? Alors elle reste, quoi qu'il arrive. */
    let épinglée = false;

    let planifié = false;

    /** L'état est recalculé à partir de ses trois entrées, jamais basculé : quel
     *  que soit le chemin — défilement, focus, redimensionnement — il ne peut
     *  donc pas dériver. */
    const appliquer = () => {
      const masquer = versLeBas && !épinglée && Math.max(0, window.scrollY) > seuil;
      bar.toggleAttribute('data-nav-hidden', masquer);
    };

    const juger = () => {
      planifié = false;
      // Le rebond élastique d'iOS et de macOS passe sous zéro : ce n'est pas de
      // la page, on ne le compte pas.
      const y = Math.max(0, window.scrollY);

      // Sous le seuil, la barre est là quel que soit le sens : le haut de la page
      // est l'endroit où l'on a le plus besoin d'elle.
      if (y <= seuil) {
        repère = y;
        versLeBas = false;
        appliquer();
        return;
      }

      const écart = y - repère;

      // Sous le grain, on ne tranche pas — et surtout on ne déplace pas le
      // repère : c'est ce qui laisse un défilement lent s'accumuler jusqu'à le
      // franchir, au lieu de n'y arriver jamais. Sans lui, l'inertie d'un
      // trackpad ou d'iOS fait clignoter la barre sur des allers-retours d'un
      // pixel.
      if (Math.abs(écart) < grain) return;

      repère = y;
      versLeBas = écart > 0;
      appliquer();
    };

    // scrollY, et non un geste : c'est la seule mesure qui dise la vérité quand
    // la page saute sans qu'on ait rien fait défiler — touche Origine, lien
    // d'ancre, scrollTo. Un `wheel` ne verrait aucun de ces sauts et laisserait
    // la barre masquée en haut de page.
    // Sur la fenêtre, et non sur le document en capture comme CaseStudyList :
    // c'est scrollY qu'on lit, donc c'est la fenêtre qu'on écoute. En capture, le
    // défilement horizontal de la pilule en mobile nous réveillerait pour rien.
    // `passive` : on ne l'empêche jamais.
    // Une mesure par image et non une par évènement : un défilement inertiel en
    // émet plusieurs pour une seule image, et deux positions lues dans la même
    // image ne décrivent aucun mouvement. Le rAF n'est donc pas une optimisation,
    // c'est ce qui donne son sens à la comparaison.
    window.addEventListener(
      'scroll',
      () => {
        if (planifié) return;
        planifié = true;
        requestAnimationFrame(juger);
      },
      { passive: true },
    );

    // Le clavier passe devant la règle, et il épingle plutôt qu'il ne révèle :
    // révélée seulement, la barre se remasquerait au premier défilement suivant,
    // l'anneau de focus avec elle — c'est précisément ce que WCAG 2.4.11 interdit.
    // Épinglée, elle reste tant que le focus est dedans.
    // C'est le choix inverse de `inert`, et le paradoxe qu'il évite le justifie :
    // une barre inerte ne peut plus recevoir le focus, donc plus jamais se
    // révéler en le recevant — et le seul landmark de navigation de la page
    // disparaîtrait des lecteurs d'écran sur un critère de position de défilement.
    bar.addEventListener('focusin', () => {
      épinglée = true;
      appliquer();
    });

    // Une fois le focus sorti, on ne remasque pas : on recalcule, avec le sens
    // qu'on avait retenu.
    bar.addEventListener('focusout', (event) => {
      if (bar.contains(event.relatedTarget as Node)) return;
      épinglée = false;
      appliquer();
    });

    // Les ancres, pour que la barre ne mange pas la cible du lien qu'on suit.
    // Cette hauteur-là peut être mesurée : elle n'a de conséquence qu'au moment
    // du saut, et rien ne bouge au chargement. Celle dont dépend le liseré d'une
    // carte, elle, ne le peut pas — c'est pourquoi la page la calcule.
    const décaler = () => {
      document.documentElement.style.scrollPaddingTop = `${bar.offsetHeight}px`;
    };

    // `border-box`, impérativement : entre desktop et mobile, c'est le padding de
    // la barre qui change, pas son contenu — il reste haut de 64px des deux
    // côtés. Sur la boîte de contenu, observée par défaut, l'observateur ne
    // verrait jamais rien et le décalage resterait celui du premier rendu.
    new ResizeObserver(décaler).observe(bar, { box: 'border-box' });
    décaler();
  }
</script>
