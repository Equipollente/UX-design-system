---
// Radio — un choix parmi plusieurs, dont un seul peut être retenu.
//
// Ce n'est pas une case à cocher : une case se coche et se décoche toute seule,
// un radio ne se relâche qu'en en choisissant un autre. C'est aussi pourquoi il
// ne va jamais seul — il n'a de sens que dans un groupe qui partage un `name` et
// pose sa question en <legend>. Pour un oui/non isolé, c'est Checkbox.
//
// Nœud Figma : 876:64956 — 6 variantes, state × checked, plus `hint?` ; le cercle seul
// est la pièce interne `_RadioInput` (875:53423).
//
// Le contrôle est natif mais son dessin vient du système : `appearance: none`
// efface celui du navigateur, et tout ce qui le remplace est une variable. Le
// choix retenu n'a pas de point : c'est un anneau, le trait de 1
// (`border/width/default`) passe à 2 (`border/width/focus`) en `border/control`.
// Le trait étant dans la boîte, le cercle garde ses 18 dans les deux états.
//
// Toutes les mesures viennent du nœud, et aucune n'est approchée :
// — cercle 18 → `control/size` ;
// — écart au libellé 8 → `space/sm`, lié dans le nœud ;
// — écart libellé–aide 4 → `space/xs` ;
// — trait 1 → `border/width/default`, 2 retenu et anneau de focus →
//   `border/width/focus`.
//
// Désactivé : le cercle passe au gris du système (`category/neutral`), il ne
// s'atténue plus. Il n'y a pas de survol : un radio ne change pas sous la souris.

import FieldLabel from './FieldLabel.astro';
import FieldMessage from './_FieldMessage.astro';

interface Props {
  /** Lie le libellé au contrôle. Unique dans la page, pas seulement dans le groupe. */
  id: string;
  /** Le mot qui nomme ce choix-ci — pas la question, qui va en <legend>. */
  label: string;
  /** Le `name` du groupe. Deux radios ne s'excluent que s'ils le partagent. */
  name: string;
  /** Ce que le formulaire enverra si ce choix est retenu. À défaut, l'`id`. */
  value?: string;
  /** Le choix retenu à l'ouverture. Un seul du groupe doit le porter. */
  checked?: boolean;
  /** L'aide : ce que ce choix entraîne, dite sous le libellé. Le champ la désigne par `aria-describedby`. */
  hint?: string;
  disabled?: boolean;
  class?: string;
}

const {
  id,
  label,
  name,
  value,
  checked = false,
  hint,
  disabled = false,
  class: className,
  ...rest
} = Astro.props;

const classes = ['radio', disabled && 'radio-disabled', className].filter(Boolean).join(' ');
const messageId = `${id}-message`;
---

<div class={classes} {...rest}>
  <input
    class="radio-input"
    type="radio"
    id={id}
    name={name}
    value={value ?? id}
    checked={checked}
    disabled={disabled}
    aria-describedby={hint ? messageId : undefined}
  />
  <FieldLabel for={id} disabled={disabled}>{label}</FieldLabel>
  {hint && <FieldMessage type="hint" id={messageId}>{hint}</FieldMessage>}
</div>

<style>
  /* Deux colonnes : le cercle, puis le texte. Le libellé est sur la première ligne,
     l'aide sur la seconde, sous lui — le cercle reste centré sur le libellé, sans
     qu'aucune mesure n'ait à le décaler. Même grille que Checkbox. */
  .radio {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    column-gap: var(--space-sm); /* 8 — l'itemSpacing du nœud */
    row-gap: var(--space-xs); /* 4 — l'écart du LabelGroup */
  }

  .radio :global(.field-message) {
    grid-column: 2;
  }

  /* Le cercle. `appearance: none` efface le dessin du navigateur ; tout ce qui
     suit vient du système. 18, la mesure du nœud. */
  .radio-input {
    appearance: none;
    flex: none;
    margin: 0;
    width: var(--radio-size, var(--control-size));
    height: var(--radio-size, var(--control-size));
    border-radius: var(--radius-pill);
    border: var(--border-width-default) solid var(--color-border-default);
    /* WCAG 2.5.5 — le libellé est lié par `for`, il agrandit la cible. */
    cursor: pointer;
    /* Le changement de fond et de trait suit la même durée que le bouton du système. */
    transition:
      background-color var(--motion-duration-quick) var(--motion-easing-standard),
      border-color var(--motion-duration-quick) var(--motion-easing-standard);
  }

  /* — default — */
  .radio-input {
    background: var(--radio-bg, var(--color-bg-surface));
  }

  /* — focused — L'anneau du système remplace celui du navigateur. 2, la mesure
     du nœud, et WCAG 2.4.7 est tenu. */
  .radio-input:focus-visible {
    outline: var(--border-width-focus) solid var(--color-border-focus);
    outline-offset: var(--button-focus-offset);
  }

  /* — selected — Le choix retenu est un anneau, sans point : le trait passe de 1 à 2
     (`border/width/focus`) et prend la couleur de contrôle. Le trait étant dans la
     boîte, le cercle ne grandit pas. */
  .radio-input:checked {
    border-width: var(--border-width-focus);
    border-color: var(--radio-accent, var(--color-border-control));
  }

  /* — disabled — écrit en dernier : à spécificité égale c'est l'ordre qui tranche.
     Le cercle bascule vers le gris du système, comme le nœud : fond et trait
     `category/neutral` vide, trait gris et fond `bg/surface` retenu. */
  .radio-input:disabled {
    background: var(--color-category-neutral-bg);
    border-color: var(--color-category-neutral-border);
  }

  .radio-input:disabled:checked {
    background: var(--color-bg-surface);
  }

  .radio-disabled .radio-input,
  .radio-disabled :global(.field-label) {
    cursor: not-allowed;
  }
</style>
