---
// Select — un champ qui fait choisir **une** valeur dans une liste.
//
// C'est le choix simple : « Pays : France ». La liste se referme dès qu'on a choisi,
// la boîte dit le choix fait, ou le `placeholder` quand rien n'est choisi. Ce n'est
// pas MultiSelect, qui fait cocher plusieurs options et porte la limite, les
// pastilles et les choix épinglés — des props qui n'ont aucun sens pour un seul
// choix, et que Select ne laisse donc pas passer : `npm run check` les refuse.
// Ce n'est pas un champ texte à suggestions ni un menu d'actions non plus.
//
// Nœud Figma : 340:933 — `forms/Select`, 24 variantes (state × validation × text),
// propriétés label?, hint?, open?, value, placeholder. La boîte ne contient pas la
// liste : `open?` montre `_SelectPanel` (778:4266), en `type=single`.
//
// Le dessin, la recherche, les groupes, la création d'une option, le script et le
// style sont dans _Select.astro, que MultiSelect partage. Ce fichier ne fait que
// fixer `multiple` à faux et choisir les props offertes.
//
// `creatable` reste offert ici comme sur MultiSelect : créer « Autre : … » a du sens
// pour un choix unique.

import SelectBase from './_Select.astro';

type Base = Parameters<typeof SelectBase>[0];

// Ce qui n'a de sens que pour plusieurs choix : le nombre maximal, l'affichage en
// pastilles ou en compteur, la zone des choix épinglés, les valeurs multiples et
// les mots qui les accompagnent.
type MultipleOnly =
  | 'multiple'
  | 'values'
  | 'max'
  | 'display'
  | 'showSelected'
  | 'countOneLabel'
  | 'countLabel'
  | 'maxLabel'
  | 'removeLabel'
  | 'requiredMessage';

type Props = Omit<Base, MultipleOnly>;

const props = Astro.props as Props;
---

<SelectBase {...props} multiple={false} />
