---
// Select — un champ qui fait choisir une valeur dans une liste fermée.
//
// Ce n'est pas un menu : un menu déclenche des actions, un select renseigne une
// valeur qu'un formulaire enverra. Et ce n'est pas un champ texte à suggestions :
// la liste est close, on ne peut rien y écrire qui n'y soit pas.
//
// Le libellé n'est pas dessiné ici : il vient de FieldLabel, comme dans tous les
// autres champs. Le dessin de la boîte non plus — police, encre, fond, trait,
// rayon, rembourrage, hauteur, survol, désactivé : tout est la recette de balise
// de global.css, partagée mot pour mot avec Text field et Text Area. Ce fichier
// ne déclare plus que la place du champ et ce qui lui est propre : le chevron,
// et la place qu'il faut lui faire.
//
// Le <select> est natif. Un menu réécrit en div coûterait le clavier, la
// recherche à la frappe, et la roulette du téléphone — pour un chevron dessiné
// autrement. Le chevron du système est donc posé par-dessus, et le natif est
// masqué par appearance: none.
//
// Nœud Figma : 340:933 — 4 états. Ce composant a longtemps été écrit sans lui :
// on le croyait « spécifié en conversation », et personne ne l'avait cherché. Le
// relire a corrigé trois mesures — la boîte fait 36 et non les 44 du bouton, le
// chevron 20 et non 24, l'écart au libellé 5 et non 8.
//
// Mesures :
// — hauteur 36 → `space/2xl + space/xs`, exact ;
// — rembourrage 16 de côté → `button/padding-x/sm`, exact, tel que le nœud le lie.
//   Les 12 du haut et du bas, eux, ne tiennent pas dans une boîte de 36 : voir plus bas ;
// — chevron 20 → `button/icon-size/sm` ;
// — écart au libellé → `control/field-gap` = 5 ;
// — anneau de focus 2 → `border/width/focus`.
//
// Le rembourrage vertical vaut 0 dans la recette, et ce n'est pas un oubli : la
// boîte fait 36, la ligne 16,8 — les 12 du nœud n'y tiennent pas
// (12 + 16,8 + 12 = 40,8). Un `select` coupe son texte à la boîte de contenu, et
// les jambages de « pays » disparaissaient. Un `input` déclare les mêmes 12 sans
// que ça se voie, le navigateur centrant son texte lui-même ; la recette les
// remet à zéro pour les deux, et les deux champs d'une ligne s'écrivent ainsi de
// la même façon. L'écart avec les deux nœuds reste ouvert dans arbitrages.md.
//
// Ce champ portait un fond sans trait, quand ses deux voisins avaient un trait
// de 1 : le nœud a été redessiné, et les trois champs portent maintenant le même
// `border/default`. Leur survol aussi est devenu le même — le trait qui fonce en
// `neutral/500`, le geste que le nœud du champ texte dessinait déjà, plutôt que
// le fond en `neutral/100` que celui-ci grisait sans que ça se voie.
//
// La liste ouverte n'est pas ici non plus : elle est dessinée par le système
// d'exploitation, hors d'atteinte du CSS.

import FieldLabel from './FieldLabel.astro';
import Icon from './Icon.astro';

interface Props {
  /** Lie le libellé au champ, et sert de `name` si aucun n'est donné. */
  id: string;
  /** Le texte du libellé. */
  label: string;
  /** Les choix. Une chaîne vaut pour sa propre valeur. */
  options: (string | { value: string; label: string })[];
  /** La première ligne, non sélectionnable. Absente : la liste ouvre sur son premier choix. */
  placeholder?: string;
  value?: string;
  name?: string;
  required?: boolean;
  disabled?: boolean;
  class?: string;
}

const {
  id,
  label,
  options,
  placeholder,
  value,
  name,
  required = false,
  disabled = false,
  class: className,
} = Astro.props;

const items = options.map((o) => (typeof o === 'string' ? { value: o, label: o } : o));
const classes = ['field', className].filter(Boolean).join(' ');
---

<div class={classes}>
  <FieldLabel for={id} required={required} disabled={disabled}>{label}</FieldLabel>

  <div class="field-control">
    <select id={id} name={name ?? id} required={required} disabled={disabled}>
      {placeholder && <option value="" disabled selected={!value}>{placeholder}</option>}
      {
        items.map((o) => (
          <option value={o.value} selected={value === o.value}>
            {o.label}
          </option>
        ))
      }
    </select>
    <Icon name="chevron-down" class="field-chevron" />
  </div>
</div>

<style>
  /* 5 — la mesure du nœud, la même que Text field et Text Area. */
  .field {
    display: flex;
    flex-direction: column;
    gap: var(--control-field-gap);
  }

  /* La boîte qui porte le chevron en absolu. */
  .field-control {
    position: relative;
    display: flex;
  }

  /* Le select ne déclare que sa place et ce qui lui est propre. Tout son dessin
     est la recette de balise de global.css, qu'il partage mot pour mot avec Text
     field et Text Area. */
  select {
    display: flex;
    align-items: center;
    width: 100%;
    /* La place du chevron s'ajoute au rembourrage droit de la recette : sans
       elle, une option longue passerait dessous. */
    padding-right: calc(var(--button-padding-x-sm) + var(--button-icon-size-sm) + var(--space-sm));
    /* Le chevron natif s'efface : c'est celui du système qui est posé dessus. */
    appearance: none;
  }

  /* Pas de couleur ici : l'icône est en currentColor, elle prend donc l'encre du
     champ — celle du texte au repos, celle de `neutral/400` quand il est éteint. */
  .field-chevron {
    position: absolute;
    right: var(--button-padding-x-sm);
    top: 50%;
    translate: 0 -50%;
    width: var(--button-icon-size-sm); /* 20 — la mesure du nœud */
    height: var(--button-icon-size-sm);
    /* Le chevron est décoratif : le clic doit traverser jusqu'au select. */
    pointer-events: none;
  }
</style>
