---
// Tabs — racine de la famille Tabs.
// Regroupe une TabList (les onglets) et les TabPanel (les contenus) :
// un seul panneau est visible à la fois.
// Structure visée (pattern APG « Tabs ») :
//
//   <Tabs>
//     <TabList>
//       <TabButton id="tab-1" controls="panel-1" selected>Onglet 1</TabButton>
//       <TabButton id="tab-2" controls="panel-2">Onglet 2</TabButton>
//     </TabList>
//     <TabPanel id="panel-1" labelledby="tab-1">…</TabPanel>
//     <TabPanel id="panel-2" labelledby="tab-2">…</TabPanel>
//   </Tabs>

import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'div'>;

const { class: className, ...rest } = Astro.props;
const classes = ['tabs', className].filter(Boolean).join(' ');
---

<div data-slot="tabs" class={classes} {...rest}>
  <slot />
</div>

<style>
  .tabs {
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
  }
</style>

<script>
  // Interaction APG « Tabs », scopée à chaque instance de .tabs.
  // Astro exécute ce script une fois par page ; on boucle donc sur toutes
  // les instances pour que la page de dev (plusieurs Tabs) fonctionne.
  document.querySelectorAll<HTMLElement>('[data-slot="tabs"]').forEach(initTabs);

  function initTabs(root: HTMLElement) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
    if (tabs.length === 0) return;

    const panelFor = (tab: HTMLButtonElement) =>
      panels.find((p) => p.id === tab.getAttribute('aria-controls'));

    function activate(tab: HTMLButtonElement, setFocus = true) {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = panelFor(t);
        if (panel) panel.hidden = !on;
      });
      movePill(tab);
      if (setFocus) tab.focus();
    }

    // Pastille : glisse vers `target` (onglet actif au repos, survolé au hover).
    const list = root.querySelector<HTMLElement>('[role="tablist"]');

    function movePill(target: HTMLButtonElement | undefined) {
      if (!list) return;
      if (!target) {
        list.style.setProperty('--pill-on', '0');
        return;
      }
      list.style.setProperty('--pill-x', `${target.offsetLeft}px`);
      list.style.setProperty('--pill-w', `${target.offsetWidth}px`);
      list.style.setProperty('--pill-on', '1');
    }

    const current = () => tabs.find((t) => t.getAttribute('aria-selected') === 'true');

    // Position initiale, sans transition visible au chargement.
    const initial = current();
    if (list && initial) {
      list.style.setProperty('transition', 'none');
      movePill(initial);
      list.getBoundingClientRect(); // flush
      list.style.removeProperty('transition');
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => activate(tab));
      tab.addEventListener('mouseenter', () => movePill(tab));
      tab.addEventListener('mouseleave', () => movePill(current()));

      tab.addEventListener('keydown', (event) => {
        let index: number | undefined;
        switch (event.key) {
          case 'ArrowRight': index = (i + 1) % tabs.length; break;
          case 'ArrowLeft':  index = (i - 1 + tabs.length) % tabs.length; break;
          case 'Home':       index = 0; break;
          case 'End':        index = tabs.length - 1; break;
          default: return;
        }
        event.preventDefault();
        activate(tabs[index]);
      });
    });
  }
</script>
