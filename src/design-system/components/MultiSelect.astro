---
// MultiSelect — le Select, à plusieurs choix.
//
// Ce n'est plus un composant à part : le Select a absorbé le champ à plusieurs
// choix, et celui-ci n'est que `<Select multiple>`. Il reste importable pour que
// les sites qui l'emploient ne changent rien. Tout se lit dans Select.astro.

import Select from './Select.astro';

type Props = Omit<Parameters<typeof Select>[0], 'multiple' | 'value'>;

const props = Astro.props as Props;
---

<Select {...props} multiple />
