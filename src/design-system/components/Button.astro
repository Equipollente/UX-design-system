---
// Bouton du système. Toutes les dimensions viennent des tokens button.*.
//
// C'est la hauteur qui dimensionne le bouton — la dimension que les $description
// rattachent à WCAG 2.5.5. Figma ne porte plus de padding vertical sur ce composant
// (réglé le 02/11) : les variables button/padding-y/* existent encore, lues ailleurs.
//
// Chaque taille pose ses variables locales (--btn-h, --btn-px, --btn-gap,
// --btn-icon, --btn-min-w) et chaque variante ses trois fonds (--btn-bg,
// --btn-bg-hover, --btn-bg-active). Un appelant peut en surcharger une
// ponctuellement via `style` sans avoir à inventer une taille ni une variante
// supplémentaire. C'est ce que font le Nav pour son bouton d'action et le
// Carousel pour ses flèches, que Figma pose sur color.bg.default.
//
// Le secondaire n'a pas de liseré, et Figma n'en a jamais dessiné : le nœud 854:41655
// ne porte qu'un fond. Le trait qui vivait ici était hérité du portfolio, entré
// avec l'extraction du système, et il n'a jamais eu de source. Il valait
// color/border/default sur le fond lavande du bouton — 1,28:1, là où WCAG 1.4.11
// en demande 3 : c'est pourquoi personne ne l'a vu pendant si longtemps.
//
// L'alerte est la troisième variante, et la seule qui ne lise pas la rampe de
// marque : ses trois fonds viennent de color/feedback/danger — 500 au repos, 600
// au survol, 700 à l'appui, comme le primaire lit accent 500/600/700. Elle porte
// une action destructive, et rien d'autre : un bouton rouge qui ne détruit rien
// apprend à ne plus être lu. Les trois crans tiennent le libellé blanc à 4,8:1,
// 6,5:1 et 8,3:1, tous au-dessus des 4,5:1 que WCAG 1.4.3 demande à 14 px.
//
// La quatrième variante, `icon`, est le bouton rond : l'icône seule, sur le fond du
// secondaire, dans un cercle dont le diamètre est la hauteur de la taille (Figma
// 854:41703 et ses voisins, variante Icon des trois tailles). Elle remplace ce que le Carousel
// et la page Icônes réécrivaient chacun de leur côté — retirer la largeur minimale,
// annoncer le bouton — et que l'appelant devait savoir pour l'écrire. Elle ne rend
// ni libellé ni `iconEnd`, comme le dessin : Figma retire le texte et la seconde
// icône de ses cinq états. Un bouton rond sans nom lisible n'a pas lieu d'être,
// donc le composant refuse de se compiler sans `icon` et sans `aria-label`
// (WCAG 4.1.2 : un contrôle expose un nom).
//
// La cinquième, `ghost`, est l'action sans fond : de l'encre, rien autour au repos, et un
// lavis neutre au survol puis à l'appui (color/action/ghost/bg-hover et bg-pressed).
// Elle porte une action de peu de poids — « Annuler », un outil dans une barre — et, avec
// `href`, le lien autonome que portait le composant Link, retiré : le Ghost le remplace sans
// être redessiné, et garde la taille, la pilule et l'anneau du bouton. Elle est née de
// l'« invisible » de Primer, que Figma nomme ghost ici.
//
// Les icônes sont inlinées et n'ont pas de couleur propre : elles prennent celle du
// bouton. Une seule flèche suffit donc pour le primaire et le secondaire — avant, il
// en fallait deux fichiers, l'un pour le fond clair et l'autre pour l'accent.

import Icon from './Icon.astro';
import type { IconName } from '../lib/icons';

interface Props {
  variant?: 'primary' | 'secondary' | 'alert' | 'icon' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  /** Nom d'une icône du système. Posée avant le label. Seule, et obligatoire, avec `variant="icon"`. */
  icon?: IconName;
  /** Idem, mais posée après le label. */
  iconEnd?: IconName;
  type?: 'button' | 'submit';
  /**
   * Le couple que le formulaire recevra quand ce bouton-la l'envoie. C'est ce
   * qui permet a plusieurs submit de se distinguer sans une ligne de script —
   * EditImageGallery s'en sert pour dire quelle image retirer.
   */
  name?: string;
  value?: string;
  /**
   * Le nom du bouton quand aucun libellé ne le porte. Obligatoire avec
   * `variant="icon"`, qui n'en a jamais.
   */
  'aria-label'?: string;
  class?: string;
  /**
   * La surcharge ponctuelle décrite plus haut : --btn-bg, --btn-px, --btn-icon…
   * Déclarée parce qu'elle fait partie du contrat — le Nav, le Carousel et
   * l'en-tête d'étude de cas s'en servent tous les trois.
   */
  style?: string;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  icon,
  iconEnd,
  type = 'button',
  class: className,
  ...rest
} = Astro.props;

if (variant === 'icon' && (!icon || !rest['aria-label'])) {
  throw new Error(
    `Button : la variante « icon » est un bouton sans libellé. Elle demande \`icon\` et \`aria-label\` ` +
      `(reçu icon=${icon ?? '—'}, aria-label=${rest['aria-label'] ?? '—'}).`,
  );
}

const Tag = href ? 'a' : 'button';
const classes = ['btn', `btn-${variant}`, `btn-${size}`, className].filter(Boolean).join(' ');
---

<Tag class={classes} href={href} type={href ? undefined : type} {...rest}>
  {icon && <Icon name={icon} />}
  {variant !== 'icon' && <slot />}
  {variant !== 'icon' && iconEnd && <Icon name={iconEnd} />}
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--btn-h);
    min-width: var(--btn-min-w);
    padding: 0 var(--btn-px);
    gap: var(--btn-gap);
    /* La taille d'icône descend par héritage jusqu'au <svg> : le bouton n'a pas à
       viser l'icône, et Icon n'a pas à connaître le bouton. */
    --icon-size: var(--btn-icon);
    background: var(--btn-bg);
    /* Le trait est transparent dans les deux variantes, et il reste écrit. La
       boîte est en border-box, donc il ne change rien à la taille du bouton :
       ce qu'il sert, c'est le mode contrastes forcés de Windows, où une bordure
       transparente est repeinte par le système. C'est là, et là seulement, que
       le bouton retrouve un bord — et il vaut mieux que ce bord existe. */
    border: 1px solid transparent;
    border-radius: var(--button-radius);
    font-family: var(--font-family-heading);
    font-weight: var(--font-weight-bold);
    font-size: var(--font-size-ui);
    line-height: var(--font-line-height-snug);
    text-decoration: none;
    cursor: pointer;
    /* Seul le fond change entre le repos, le survol et l'appui — il n'y a plus
       rien d'autre à animer. Un changement de couleur prend duration.quick ;
       tokens.css le remet à zéro sous prefers-reduced-motion. */
    transition: background-color var(--motion-duration-quick) var(--motion-easing-standard);
  }

  /* — tailles — */
  .btn-sm {
    --btn-h: var(--button-height-sm);
    --btn-px: var(--button-padding-x-sm);
    --btn-gap: var(--button-gap-sm);
    --btn-icon: var(--button-icon-size-sm);
    --btn-min-w: var(--button-min-width-sm);
  }

  .btn-md {
    --btn-h: var(--button-height-md);
    --btn-px: var(--button-padding-x-md);
    --btn-gap: var(--button-gap-md);
    --btn-icon: var(--button-icon-size-md);
    --btn-min-w: var(--button-min-width-md);
  }

  .btn-lg {
    --btn-h: var(--button-height-lg);
    --btn-px: var(--button-padding-x-lg);
    --btn-gap: var(--button-gap-md);
    --btn-icon: var(--button-icon-size-lg);
    --btn-min-w: var(--button-min-width-lg);
  }

  /* — variantes — */
  .btn-primary {
    --btn-bg: var(--color-action-primary-bg);
    --btn-bg-hover: var(--color-action-primary-bg-hover);
    --btn-bg-active: var(--color-action-primary-bg-pressed);
    --icon-color: var(--color-text-on-accent);
    color: var(--color-text-on-accent);
  }

  /* L'encre, pas l'accent — comme Figma. Le libellé fait 14 px : le seuil WCAG est
     4,5:1, et l'accent tombe à 3,31:1 sur le fond d'appui. La description de
     color.text.accent le disait déjà, « safe at body size (7.00:1 on the ground) » :
     sur la brume lavande du secondaire, on n'est plus sur le blanc.
     L'icône suit le libellé — Figma la lie à color/neutral/900, la même encre. */
  .btn-secondary {
    --btn-bg: var(--color-action-secondary-bg);
    --btn-bg-hover: var(--color-action-secondary-bg-hover);
    --btn-bg-active: var(--color-action-secondary-bg-pressed);
    color: var(--color-text-default);
  }

  /* L'action destructive, et elle seule. Contrairement au primaire, l'icône n'a
     pas de teinte nommée : Figma la laisse en blanc pur, qui est exactement ce
     que vaut color/text/on-accent. currentColor suffit donc, et l'icône suit le
     libellé sans qu'on ait à la viser. */
  .btn-alert {
    --btn-bg: var(--color-action-destructive-bg);
    --btn-bg-hover: var(--color-action-destructive-bg-hover);
    --btn-bg-active: var(--color-action-destructive-bg-pressed);
    color: var(--color-text-on-danger);
  }

  /* Le rond. Même fond et même encre que le secondaire : Figma lui donne
     bg/surface au repos, accent 100 au survol et 200 à l'appui, l'icône en
     neutral/900. Ce qui change est la boîte — la largeur vaut la hauteur de la
     taille, le rembourrage horizontal disparaît, la largeur minimale aussi — et
     le rayon, qui est déjà celui de la pilule, fait le reste : un cercle. */
  .btn-icon {
    --btn-bg: var(--color-action-secondary-bg);
    --btn-bg-hover: var(--color-action-secondary-bg-hover);
    --btn-bg-active: var(--color-action-secondary-bg-pressed);
    --btn-px: 0;
    --btn-min-w: 0;
    width: var(--btn-h);
    color: var(--color-text-default);
  }

  /* Rien au repos : le lavis n'apparaît qu'au survol et à l'appui, comme dans Figma.
     Le désactivé baisse l'opacité du bouton entier, il n'a donc pas de fond à lui. */
  .btn-ghost {
    --btn-bg: transparent;
    --btn-bg-hover: var(--color-action-ghost-bg-hover);
    --btn-bg-active: var(--color-action-ghost-bg-pressed);
    color: var(--color-text-default);
  }

  .btn:hover:not(:disabled) {
    background: var(--btn-bg-hover);
  }

  .btn:active:not(:disabled) {
    background: var(--btn-bg-active);
  }

  /* Désactivé : Figma ne change pas le fond, il baisse l'opacité de tout le
     bouton à 45 % (états Disabled, 854:41683 et 854:41667). Le contraste tombe
     alors sous le seuil — c'est admis, WCAG 1.4.3 exempte les contrôles
     inactifs. Le Carousel s'en sert pour ses flèches en bout de piste. */
  .btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }
</style>
