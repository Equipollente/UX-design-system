---
// Bouton du système. Toutes les dimensions viennent des tokens button.*.
//
// C'est la hauteur qui dimensionne le bouton — la dimension que les $description
// rattachent à WCAG 2.5.5. Figma ne porte plus de padding vertical sur ce composant
// (réglé le 02/11) : les variables button/padding-y/* existent encore, lues ailleurs.
//
// Chaque taille pose ses variables locales (--btn-h, --btn-px, --btn-gap,
// --btn-icon) et chaque variante ses trois fonds (--btn-bg,
// --btn-bg-hover, --btn-bg-active). Un appelant peut en surcharger une
// ponctuellement via `style` sans avoir à inventer une taille ni une variante
// supplémentaire. C'est ce que font le Nav pour son bouton d'action et le
// Carousel pour ses flèches, que Figma pose sur color.bg.default.
//
// Le secondaire n'a pas de liseré, et Figma n'en a jamais dessiné : le nœud 854:41655
// ne porte qu'un fond. Le trait qui vivait ici était hérité du portfolio, entré
// avec l'extraction du système, et il n'a jamais eu de source. Il valait
// color/border/default sur le fond lavande du bouton — 1,28:1, là où WCAG 1.4.11
// en demande 3 : c'est pourquoi personne ne l'a vu pendant si longtemps.
//
// L'alerte est la troisième variante, et la seule qui ne lise pas la rampe de
// marque : ses trois fonds viennent de color/feedback/danger — 500 au repos, 600
// au survol, 700 à l'appui, comme le primaire lit accent 500/600/700. Elle porte
// une action destructive, et rien d'autre : un bouton rouge qui ne détruit rien
// apprend à ne plus être lu. Les trois crans tiennent le libellé blanc à 4,8:1,
// 6,5:1 et 8,3:1, tous au-dessus des 4,5:1 que WCAG 1.4.3 demande à 14 px.
//
// Le bouton rond n'est plus une variante : c'est IconButton, un composant à part qui rend
// celui-ci (Figma l'a sorti du jeu Button : 881:71005). Un bouton sans libellé n'a ni
// texte, ni `iconEnd`, ni largeur minimale, et doit porter son nom lui-même — ce qui
// ne se règle pas comme un bouton à libellé.
//
// La quatrième, `ghost`, est l'action sans fond : de l'encre, rien autour au repos, et un
// lavis neutre au survol puis à l'appui (color/action/ghost/bg-hover et bg-pressed).
// Elle porte une action de peu de poids — « Annuler », un outil dans une barre — et, avec
// `href`, le lien autonome que portait le composant Link, retiré : le Ghost le remplace sans
// être redessiné, et garde la taille, la pilule et l'anneau du bouton. Elle est née de
// l'« invisible » de Primer, que Figma nomme ghost ici.
//
// Les sept teintes de catégorie — clay, teal, sun, rose, accent, highlight, neutral — sont les
// variantes suivantes, dessinées dans Figma d'abord sur rose et sun puis déclinées. Chacune est
// teintée, pas pleine : fond pâle (color/action/<teinte>/bg, qui alias color/category/<teinte>/bg),
// un cran plus soutenu au survol puis à l'appui, liseré color/category/<teinte>/border, libellé
// color/category/<teinte>/text, et l'icône en color/action/<teinte>/solid — la couleur forte de la
// teinte, que le texte ne porte pas. Elles partagent la classe .btn-cat : seules les cinq variables
// de teinte changent d'une variante à l'autre.
//
// Les icônes sont inlinées et n'ont pas de couleur propre : elles prennent celle du
// bouton. Une seule flèche suffit donc pour le primaire et le secondaire — avant, il
// en fallait deux fichiers, l'un pour le fond clair et l'autre pour l'accent.

import Icon from './Icon.astro';
import type { IconName } from '../lib/icons';

const hues = ['clay', 'teal', 'sun', 'rose', 'accent', 'highlight', 'neutral'] as const;

interface Props {
  variant?:
    | 'primary'
    | 'secondary'
    | 'alert'
    | 'ghost'
    | 'clay'
    | 'teal'
    | 'sun'
    | 'rose'
    | 'accent'
    | 'highlight'
    | 'neutral';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  /** Nom d'une icône du système. Posée avant le label. Une icône seule est un IconButton. */
  icon?: IconName;
  /** Idem, mais posée après le label. */
  iconEnd?: IconName;
  type?: 'button' | 'submit';
  /**
   * Le couple que le formulaire recevra quand ce bouton-la l'envoie. C'est ce
   * qui permet a plusieurs submit de se distinguer sans une ligne de script —
   * EditImageGallery s'en sert pour dire quelle image retirer.
   */
  name?: string;
  value?: string;
  /** Le nom du bouton quand aucun libellé ne le porte. Un IconButton le pose toujours. */
  'aria-label'?: string;
  class?: string;
  /**
   * La surcharge ponctuelle décrite plus haut : --btn-bg, --btn-px, --btn-icon…
   * Déclarée parce qu'elle fait partie du contrat — le Nav, le Carousel et
   * l'en-tête d'étude de cas s'en servent tous les trois.
   */
  style?: string;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  icon,
  iconEnd,
  type = 'button',
  class: className,
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';
const isHue = (hues as readonly string[]).includes(variant);
const classes = ['btn', `btn-${variant}`, isHue && 'btn-cat', `btn-${size}`, className].filter(Boolean).join(' ');
---

<Tag class={classes} href={href} type={href ? undefined : type} {...rest}>
  {icon && <Icon name={icon} />}
  <slot />
  {iconEnd && <Icon name={iconEnd} />}
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--btn-h);
    padding: 0 var(--btn-px);
    gap: var(--btn-gap);
    /* La taille d'icône descend par héritage jusqu'au <svg> : le bouton n'a pas à
       viser l'icône, et Icon n'a pas à connaître le bouton. */
    --icon-size: var(--btn-icon);
    background: var(--btn-bg);
    /* Le trait est transparent dans les deux variantes, et il reste écrit. La
       boîte est en border-box, donc il ne change rien à la taille du bouton :
       ce qu'il sert, c'est le mode contrastes forcés de Windows, où une bordure
       transparente est repeinte par le système. C'est là, et là seulement, que
       le bouton retrouve un bord — et il vaut mieux que ce bord existe. */
    border: 1px solid transparent;
    border-radius: var(--border-radius-full);
    font-family: var(--font-stack-heading);
    font-weight: var(--base-text-weight-bold);
    font-size: var(--text-body-medium-size);
    line-height: var(--base-text-line-height-snug);
    text-decoration: none;
    cursor: pointer;
    /* Seul le fond change entre le repos, le survol et l'appui — il n'y a plus
       rien d'autre à animer. Un changement de couleur prend duration.quick ;
       tokens.css le remet à zéro sous prefers-reduced-motion. */
    transition: background-color var(--motion-duration-quick) var(--motion-easing-standard);
  }

  /* — tailles — */
  .btn-sm {
    --btn-h: var(--control-small-size);
    --btn-px: var(--control-small-padding-inline-normal);
    --btn-gap: var(--control-small-gap);
    --btn-icon: var(--icon-small);
  }

  .btn-md {
    --btn-h: var(--control-medium-size);
    --btn-px: var(--control-medium-padding-inline-normal);
    --btn-gap: var(--control-medium-gap);
    --btn-icon: var(--icon-medium);
  }

  .btn-lg {
    --btn-h: var(--control-large-size);
    --btn-px: var(--control-large-padding-inline-normal);
    --btn-gap: var(--control-medium-gap);
    --btn-icon: var(--icon-large);
  }

  /* — variantes — */
  .btn-primary {
    --btn-bg: var(--color-background-primary-bold);
    --btn-bg-hover: var(--color-background-primary-bold-hover);
    --btn-bg-active: var(--color-background-primary-bold-pressed);
    --icon-color: var(--color-text-primary-on-bold);
    color: var(--color-text-primary-on-bold);
  }

  /* L'encre, pas l'accent — comme Figma. Le libellé fait 14 px : le seuil WCAG est
     4,5:1, et l'accent tombe à 3,31:1 sur le fond d'appui. La description de
     color.text.accent le disait déjà, « safe at body size (7.00:1 on the ground) » :
     sur la brume lavande du secondaire, on n'est plus sur le blanc.
     L'icône suit le libellé — Figma la lie à color/neutral/900, la même encre. */
  .btn-secondary {
    --btn-bg: var(--color-background-secondary-subtle);
    --btn-bg-hover: var(--color-background-secondary-subtle-hover);
    --btn-bg-active: var(--color-background-secondary-subtle-pressed);
    color: var(--color-text-base-default);
  }

  /* L'action destructive, et elle seule. Contrairement au primaire, l'icône n'a
     pas de teinte nommée : Figma la laisse en blanc pur, qui est exactement ce
     que vaut color/text/on-accent. currentColor suffit donc, et l'icône suit le
     libellé sans qu'on ait à la viser. */
  .btn-alert {
    --btn-bg: var(--color-background-danger-bold);
    --btn-bg-hover: var(--color-background-danger-bold-hover);
    --btn-bg-active: var(--color-background-danger-bold-pressed);
    color: var(--color-text-danger-on-bold);
  }

  /* Rien au repos : le lavis n'apparaît qu'au survol et à l'appui, comme dans Figma.
     Le désactivé baisse l'opacité du bouton entier, il n'a donc pas de fond à lui. */
  .btn-ghost {
    --btn-bg: transparent;
    --btn-bg-hover: var(--color-background-neutral-subtlest-hover);
    --btn-bg-active: var(--color-background-neutral-subtlest-pressed);
    color: var(--color-text-base-default);
  }

  /* Les sept teintes de catégorie. Le liseré est dessiné (1 px, color/category/<teinte>/border) :
     c'est la seule variante qui en ait un. */
  .btn-cat {
    background: var(--btn-bg);
    border-color: var(--btn-border);
    color: var(--btn-text);
    --icon-color: var(--btn-solid);
  }

  .btn-clay {
    --btn-bg: var(--color-background-clay-subtle);
    --btn-bg-hover: var(--color-background-clay-subtle-hover);
    --btn-bg-active: var(--color-background-clay-subtle-pressed);
    --btn-border: var(--color-border-clay-default);
    --btn-text: var(--color-text-clay-on-subtle);
    --btn-solid: var(--color-icon-clay);
  }

  .btn-teal {
    --btn-bg: var(--color-background-teal-subtle);
    --btn-bg-hover: var(--color-background-teal-subtle-hover);
    --btn-bg-active: var(--color-background-teal-subtle-pressed);
    --btn-border: var(--color-border-teal-default);
    --btn-text: var(--color-text-teal-on-subtle);
    --btn-solid: var(--color-icon-teal);
  }

  .btn-sun {
    --btn-bg: var(--color-background-sun-subtle);
    --btn-bg-hover: var(--color-background-sun-subtle-hover);
    --btn-bg-active: var(--color-background-sun-subtle-pressed);
    --btn-border: var(--color-border-sun-default);
    --btn-text: var(--color-text-sun-on-subtle);
    --btn-solid: var(--color-icon-sun);
  }

  .btn-rose {
    --btn-bg: var(--color-background-rose-subtle);
    --btn-bg-hover: var(--color-background-rose-subtle-hover);
    --btn-bg-active: var(--color-background-rose-subtle-pressed);
    --btn-border: var(--color-border-rose-default);
    --btn-text: var(--color-text-rose-on-subtle);
    --btn-solid: var(--color-icon-rose);
  }

  .btn-accent {
    --btn-bg: var(--color-background-primary-subtle);
    --btn-bg-hover: var(--color-background-primary-subtle-hover);
    --btn-bg-active: var(--color-background-primary-subtle-pressed);
    --btn-border: var(--color-border-primary-default);
    --btn-text: var(--color-text-primary-on-subtle);
    --btn-solid: var(--color-icon-primary);
  }

  .btn-highlight {
    --btn-bg: var(--color-background-highlight-subtle);
    --btn-bg-hover: var(--color-background-highlight-subtle-hover);
    --btn-bg-active: var(--color-background-highlight-subtle-pressed);
    --btn-border: var(--color-border-highlight-default);
    --btn-text: var(--color-text-highlight-on-subtle);
    --btn-solid: var(--color-icon-highlight);
  }

  .btn-neutral {
    --btn-bg: var(--color-background-neutral-subtle);
    --btn-bg-hover: var(--color-background-neutral-subtle-hover);
    --btn-bg-active: var(--color-background-neutral-subtle-pressed);
    --btn-border: var(--color-border-neutral-default);
    --btn-text: var(--color-text-neutral-on-subtle);
    --btn-solid: var(--color-icon-neutral);
  }

  .btn:hover:not(:disabled) {
    background: var(--btn-bg-hover);
  }

  .btn:active:not(:disabled) {
    background: var(--btn-bg-active);
  }

  /* Désactivé : Figma ne change pas le fond, il baisse l'opacité de tout le
     bouton à 45 % (états Disabled, 854:41683 et 854:41667). Le contraste tombe
     alors sous le seuil — c'est admis, WCAG 1.4.3 exempte les contrôles
     inactifs. Le Carousel s'en sert pour ses flèches en bout de piste. */
  .btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }
</style>
