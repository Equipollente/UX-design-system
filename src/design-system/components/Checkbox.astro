---
// Checkbox — une case qui se coche et se décoche toute seule.
//
// Ce n'est pas un radio : un radio ne se relâche qu'en en choisissant un autre,
// et n'a de sens qu'en groupe. Une case, elle, vit très bien seule — « j'accepte
// les conditions » en est une, et c'est le cas où `required` a un sens. Ce n'est
// pas non plus un interrupteur : un Toggle applique son effet à l'instant où on
// le bascule, une case attend l'envoi du formulaire.
//
// Nœud Figma : 873:51740 — 12 variantes, state × checked × indeterminate, plus `hint?` ;
// la case seule est la pièce interne `_CheckboxInput` (873:51724).
//
// Le contrôle est natif mais son dessin vient du système : `appearance: none`
// efface celui du navigateur, et tout ce qui le remplace est une variable. La
// coche et le tiret de l'état indéterminé ne sont pas dessinés en CSS — ce sont les
// icônes `check` et `minus` du registre, posées au centre de la case à 10 (18 moins
// une marge de `space/xs` de chaque côté) et rendues insensibles au clic, exactement
// comme Select pose son chevron sur le <select>. Le dessin du système sert donc à
// deux endroits au lieu d'être refait ici.
//
// Toutes les mesures viennent du nœud, et aucune n'est approchée :
// — boîte 18 → `control/size` ;
// — rayon → `radius/sm`, lié dans le nœud ;
// — écart au libellé 8 → `space/sm`, lié dans le nœud ;
// — trait 1 → `border/width/default`, anneau de focus 2 → `border/width/focus` ;
// — fond coché ou indéterminé → `bg/control` ; désactivé → `category/neutral/*`.
//
// Le trait est posé dans les deux états, et c'est sa couleur qui change : le nœud
// ne le dessine que sur la case vide, mais un trait accent sur un fond accent se
// voit pareil, et la boîte garde alors la même taille cochée ou non.

import FieldLabel from './FieldLabel.astro';
import FieldMessage from './_FieldMessage.astro';
import Icon from './Icon.astro';

interface Props {
  /** Lie le libellé au contrôle. Unique dans la page. */
  id: string;
  /** Ce que la case affirme quand elle est cochée. Une phrase, pas une question. */
  label: string;
  /** Le nom envoyé par le formulaire. À défaut, l'`id`. */
  name?: string;
  /** Ce que le formulaire enverra si la case est cochée. À défaut, `on`. */
  value?: string;
  /** Cochée à l'ouverture. */
  checked?: boolean;
  /** Ni cochée ni décochée : « certaines des cases d'un groupe le sont ». Elle l'emporte sur `checked`, et le premier clic la remplace par cochée ou décochée. */
  indeterminate?: boolean;
  /** L'aide : ce que cocher entraîne, dite sous le libellé. Le champ la désigne par `aria-describedby`. */
  hint?: string;
  /** Pose l'astérisque et l'attribut. A du sens ici : une case peut être seule. */
  required?: boolean;
  disabled?: boolean;
  class?: string;
}

const {
  id,
  label,
  name,
  value,
  checked = false,
  indeterminate = false,
  hint,
  required = false,
  disabled = false,
  class: className,
  ...rest
} = Astro.props;

const classes = ['checkbox', disabled && 'checkbox-disabled', className]
  .filter(Boolean)
  .join(' ');
const messageId = `${id}-message`;
---

<div class={classes} {...rest}>
  <span class="checkbox-control">
    <input
      class="checkbox-input"
      type="checkbox"
      id={id}
      name={name ?? id}
      value={value}
      checked={checked}
      required={required}
      disabled={disabled}
      data-indeterminate={indeterminate ? '' : undefined}
      aria-describedby={hint ? messageId : undefined}
    />
    {/* La coche double l'état que la case porte déjà : elle est décorative, donc
        sans `label` — sans quoi elle serait annoncée en plus de « coché ». */}
    <Icon name="check" class="checkbox-mark checkbox-check" />
    <Icon name="minus" class="checkbox-mark checkbox-minus" />
  </span>
  <FieldLabel for={id} required={required} disabled={disabled}>{label}</FieldLabel>
  {hint && <FieldMessage type="hint" id={messageId}>{hint}</FieldMessage>}
</div>

<style>
  /* Deux colonnes : la case, puis le texte. Le libellé est sur la première ligne,
     l'aide sur la seconde, sous lui — la case reste centrée sur le libellé, sans
     qu'aucune mesure n'ait à la décaler. */
  .checkbox {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    column-gap: var(--base-8); /* 8 — l'itemSpacing du nœud */
    row-gap: var(--base-4); /* 4 — l'écart du LabelGroup */
  }

  .checkbox :global(.field-message) {
    grid-column: 2;
  }

  /* La case et sa coche se superposent : même pile que le chevron de Select. */
  .checkbox-control {
    position: relative;
    display: inline-flex;
    flex: none;
  }

  /* La boîte. `appearance: none` efface le dessin du navigateur ; tout ce qui
     suit vient du système. 18, la mesure du nœud. */
  .checkbox-input {
    appearance: none;
    margin: 0;
    width: var(--checkbox-size, var(--base-20));
    height: var(--checkbox-size, var(--base-20));
    border-radius: var(--border-radius-small); /* 6 — la liaison radius/sm du nœud */
    border: var(--border-width-default) solid var(--color-border-base-subtle);
    /* WCAG 2.5.5 — le libellé est lié par `for`, il agrandit la cible. */
    cursor: pointer;
    transition:
      background-color var(--motion-duration-quick) var(--motion-easing-standard),
      border-color var(--motion-duration-quick) var(--motion-easing-standard);
  }

  /* — default — */
  .checkbox-input {
    background: var(--checkbox-bg, var(--color-surface-raised));
  }

  /* — focused — L'anneau du système remplace celui du navigateur. 2, la mesure
     du nœud, et WCAG 2.4.7 est tenu. */
  .checkbox-input:focus-visible {
    outline: var(--border-width-thick) solid var(--color-border-base-focus);
    outline-offset: var(--border-outline-focus-offset);
  }

  /* — checked, indeterminate — Le trait suit le fond : la case est d'un seul tenant. */
  .checkbox-input:is(:checked, :indeterminate) {
    background: var(--checkbox-accent, var(--color-background-primary-bold));
    border-color: var(--checkbox-accent, var(--color-background-primary-bold));
  }

  /* La coche et le tiret sont posés au centre de la case, à 10 dans le nœud : la
     case moins une marge de `space/xs` de chaque côté, soit 18 − 8. Rien n'est écrit
     en dur, et les deux suivent la case si elle change. Ils ne prennent pas le
     clic : il doit traverser jusqu'à l'input. Chacun n'apparaît que dans son état —
     `display` est un mot-clé, là où une opacité aurait demandé une valeur que le
     système n'a pas. */
  .checkbox-mark {
    position: absolute;
    inset: var(--base-4);
    --icon-size: calc(var(--checkbox-size, var(--base-20)) - 2 * var(--base-4));
    --icon-color: var(--color-text-primary-on-bold);
    pointer-events: none;
  }

  /* L'indéterminé l'emporte : une case à la fois cochée et indéterminée montre le tiret. */
  .checkbox-input:not(:checked) + .checkbox-check,
  .checkbox-input:indeterminate + .checkbox-check {
    display: none;
  }

  .checkbox-input:not(:indeterminate) ~ .checkbox-minus {
    display: none;
  }

  /* — disabled — écrit en dernier : à spécificité égale c'est l'ordre qui
     tranche. La case bascule vers le gris du système, comme le nœud : fond et
     trait `category/neutral` vide, plein `category/neutral/solid` cochée. La
     coche reste blanche sur ce plein. */
  .checkbox-input:disabled {
    background: var(--color-background-neutral-subtle);
    border-color: var(--color-border-neutral-default);
  }

  .checkbox-input:disabled:is(:checked, :indeterminate) {
    background: var(--color-background-neutral-bold);
    border-color: var(--color-background-neutral-bold);
  }

  .checkbox-disabled .checkbox-input,
  .checkbox-disabled :global(.field-label) {
    cursor: not-allowed;
  }
</style>

{/* `indeterminate` n'existe pas en HTML : c'est une propriété de l'élément, qu'aucun attribut
    ne pose. Le serveur marque donc la case, et ce script la lui donne au chargement. */}
<script>
  for (const input of document.querySelectorAll<HTMLInputElement>('input[data-indeterminate]')) {
    input.indeterminate = true;
  }
</script>
